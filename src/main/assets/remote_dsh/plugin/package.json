{
  "name": "@local/smartquiz-remote",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "config.js",
    "lib",
    "caps.js",
    "cardcheck.js",
    "qrcodegen.js",
    "client.js",
    "cordis.patch.yml",
    "pair_page.html",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "meta": {
    "title": "SmartQuiz Remote",
    "description": "答题宝手机端远程接入：局域网 HTTP 端点 + 设备令牌鉴权 + 配对二维码 + CLI/直连任务执行"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "ws": "^8.23.0"
  }
}
