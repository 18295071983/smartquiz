{
  "name": "长图片模板（记忆卡片版）",
  "description": "快速背诵、制作分享卡片，极简设计",
  "format": "LONG_IMAGE",
  "fields": [
    "questionText",
    "correctAnswer"
  ],
  "fieldMappings": {
    "questionText": "题目",
    "correctAnswer": "答案"
  },
  "config": {
    "includeAnswers": true,
    "includeExplanations": false,
    "imageWidth": 3840,
    "textSize": 32,
    "backgroundColor": "#FFFFFF",
    "padding": 40
  },
  "template": "{{header}}\n{{questions}}\n{{footer}}"
}