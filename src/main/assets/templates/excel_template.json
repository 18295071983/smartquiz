{
  "name": "Excel模板（标准完整版）",
  "description": "题库备份与跨端迁移，保留完整题目数据",
  "format": "EXCEL",
  "fields": [
    "id",
    "questionType",
    "questionText",
    "optionA",
    "optionB",
    "optionC",
    "optionD",
    "correctAnswer",
    "explanation",
    "knowledgePoint",
    "category",
    "difficulty"
  ],
  "fieldMappings": {
    "id": "序号",
    "questionText": "题目内容",
    "optionA": "选项A",
    "optionB": "选项B",
    "optionC": "选项C",
    "optionD": "选项D",
    "correctAnswer": "正确答案",
    "explanation": "解析",
    "knowledgePoint": "知识点",
    "category": "分类",
    "difficulty": "难度"
  },
  "config": {
    "includeAnswers": true,
    "includeExplanations": true,
    "autoSizeColumns": true,
    "sheetName": "题目导出"
  },
  "template": "{{header}}\n{{rows}}"
}