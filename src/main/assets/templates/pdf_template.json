{
  "name": "PDF模板（答案解析版）",
  "description": "复习备考、错题整理，突出答案和解析",
  "format": "PDF",
  "fields": [
    "questionType",
    "questionText",
    "correctAnswer",
    "explanation",
    "knowledgePoint"
  ],
  "fieldMappings": {
    "questionText": "题目内容",
    "correctAnswer": "正确答案",
    "explanation": "解析",
    "questionType": "题型",
    "knowledgePoint": "知识点"
  },
  "config": {
    "includeAnswers": true,
    "includeExplanations": true,
    "pageSize": "A4",
    "font": "simkai.ttf",
    "fontSize": 12
  },
  "template": "{{title}}\n{{info}}\n{{questions}}\n{{footer}}"
}