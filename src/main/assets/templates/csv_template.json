{
  "name": "CSV模板（数据分析版）",
  "description": "学习情况数据分析，保留统计字段",
  "format": "CSV",
  "fields": [
    "id",
    "questionType",
    "category",
    "subCategory",
    "difficulty",
    "knowledgePoint",
    "favorite",
    "usageCount",
    "correctCount",
    "incorrectCount"
  ],
  "fieldMappings": {
    "id": "序号",
    "questionType": "题型",
    "category": "分类",
    "subCategory": "子分类",
    "difficulty": "难度",
    "knowledgePoint": "知识点",
    "favorite": "是否收藏",
    "usageCount": "使用次数",
    "correctCount": "正确次数",
    "incorrectCount": "错误次数"
  },
  "config": {
    "includeAnswers": false,
    "includeExplanations": false,
    "delimiter": ",",
    "quoteCharacter": "\""
  },
  "template": "{{fields}}\n{{questions}}"
}