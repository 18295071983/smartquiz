<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hc_99b91c1c"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <!-- 左侧加粗红色竖条 -->
    <item android:left="0dp" android:width="4dp" android:gravity="left|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/warn_red_bg"/>
            <corners android:topLeftRadius="18dp" android:bottomLeftRadius="18dp"/>
        </shape>
    </item>
</layer-list>
