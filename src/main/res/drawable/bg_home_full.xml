<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主渐变 深紫→紫→亮紫蓝 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#3B0764"
                android:centerColor="#6D28D9"
                android:endColor="#8B5CF6"
                android:angle="135" />
        </shape>
    </item>
    <!-- 顶部柔光 -->
    <item android:gravity="top|center_horizontal" android:height="460dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#30FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
        </shape>
    </item>
    <!-- 底部微微加深 -->
    <item android:gravity="bottom" android:height="220dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00000000"
                android:endColor="#26000000"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
