<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主渐变 深蓝→靛→蓝（与天气详情页背景一致） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/future_bg_top"
                android:centerColor="@color/future_bg_mid"
                android:endColor="@color/future_bg_bot"
                android:angle="135" />
        </shape>
    </item>
    <!-- 顶部柔光（降低透明度避免过曝） -->
    <item android:gravity="top|center_horizontal" android:height="500dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/hc_3dffffff"
                android:endColor="@color/hc_00ffffff"
                android:angle="270" />
        </shape>
    </item>
    <!-- 底部微微加深 -->
    <item android:gravity="bottom" android:height="200dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/hc_00000000"
                android:endColor="@color/hc_20000000"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
