<?xml version="1.0" encoding="utf-8"?>
<!-- 聊天页 v2 顶部状态胶囊底（2026-10-25 把旧状态栏加回来后适配浅底）：
     白面 + 1dp 细边 + 16dp 圆角，替代原先给深蓝壁纸用的 status_bar_background。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/chat_v2_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/chat_v2_border" />
    <corners android:radius="16dp" />
</shape>
