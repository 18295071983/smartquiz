<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底层渐变：夜空蓝 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/hc_ff1e3a8a"
                android:centerColor="@color/hc_ff3b82f6"
                android:endColor="@color/hc_ff60a5fa"
                android:angle="135" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- 雷达环 1（外环） -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="@color/hc_50ffffff" />
            <solid android:color="@color/hc_00000000" />
            <size android:width="68dp" android:height="68dp" />
        </shape>
    </item>
    <!-- 雷达环 2（中环） -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <stroke android:width="0.5dp" android:color="@color/hc_40ffffff" />
            <solid android:color="@color/hc_00000000" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
    <!-- 雷达环 3（内环） -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <stroke android:width="0.5dp" android:color="@color/hc_30ffffff" />
            <solid android:color="@color/hc_00000000" />
            <size android:width="28dp" android:height="28dp" />
        </shape>
    </item>
    <!-- 中心点 -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/hc_80ffffff" />
            <size android:width="4dp" android:height="4dp" />
        </shape>
    </item>
    <!-- 扫描线效果（顶部弧线） -->
    <item android:gravity="top|center_horizontal" android:top="8dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="@color/hc_30ffffff" />
            <solid android:color="@color/hc_00000000" />
            <size android:width="40dp" android:height="20dp" />
        </shape>
    </item>
</layer-list>
