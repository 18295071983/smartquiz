<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底层渐变：夜空蓝 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1E3A8A"
                android:centerColor="#3B82F6"
                android:endColor="#60A5FA"
                android:angle="135" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- 雷达环 1（外环） -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#50FFFFFF" />
            <solid android:color="#00000000" />
            <size android:width="68dp" android:height="68dp" />
        </shape>
    </item>
    <!-- 雷达环 2（中环） -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <stroke android:width="0.5dp" android:color="#40FFFFFF" />
            <solid android:color="#00000000" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
    <!-- 雷达环 3（内环） -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <stroke android:width="0.5dp" android:color="#30FFFFFF" />
            <solid android:color="#00000000" />
            <size android:width="28dp" android:height="28dp" />
        </shape>
    </item>
    <!-- 中心点 -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#80FFFFFF" />
            <size android:width="4dp" android:height="4dp" />
        </shape>
    </item>
    <!-- 扫描线效果（顶部弧线） -->
    <item android:gravity="top|center_horizontal" android:top="8dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#30FFFFFF" />
            <solid android:color="#00000000" />
            <size android:width="40dp" android:height="20dp" />
        </shape>
    </item>
</layer-list>
