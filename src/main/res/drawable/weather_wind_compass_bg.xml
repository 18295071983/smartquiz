<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/hc_25ffffff" />
            <stroke android:width="1dp" android:color="@color/hc_45ffffff" />
            <size android:width="70dp" android:height="70dp" />
        </shape>
    </item>
    <!-- 内圈 -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/hc_18ffffff" />
            <size android:width="44dp" android:height="44dp" />
        </shape>
    </item>
    <!-- 中心点 -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/hc_60ffffff" />
            <size android:width="3dp" android:height="3dp" />
        </shape>
    </item>
</layer-list>
