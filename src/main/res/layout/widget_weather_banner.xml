<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weather_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/weather_banner_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <TextView
        android:id="@+id/weather_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:textSize="40sp"
        android:textColor="@color/weather_banner_text" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/weather_city"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:lineSpacingExtra="1dp"
                android:ellipsize="end"
                android:text="定位中..."
                android:textColor="@color/weather_banner_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/weather_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="--°"
                android:textColor="@color/weather_banner_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 天气描述（如"多云转晴"） -->
        <TextView
            android:id="@+id/weather_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="加载中..."
            android:textColor="@color/weather_banner_text_secondary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 介绍行：体感 / 湿度 / 风力 / 能见度，类似详情页的 chips 风格；
             用 marginHorizontal 分隔，避免 LinearLayout.showDividers 属性要求 divider 必须是 Drawable -->
        <LinearLayout
            android:id="@+id/weather_info_chips_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/weather_feels_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="体感 --°"
                android:textColor="@color/weather_banner_text_secondary"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="none"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/weather_humidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💧 --%"
                android:textColor="@color/weather_banner_text_secondary"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="none"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/weather_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌬 --"
                android:textColor="@color/weather_banner_text_secondary"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="none" />

            <TextView
                android:id="@+id/weather_visibility"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="👁 --km"
                android:textColor="@color/weather_banner_text_secondary"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="end" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/weather_arrow"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/weather_banner_text_secondary"
        android:layout_marginStart="8dp" />
</LinearLayout>
