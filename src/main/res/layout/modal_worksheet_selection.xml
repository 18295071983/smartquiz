<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="center"
    android:orientation="vertical">

    <!-- 模态框内容 -->
    <LinearLayout
        android:layout_width="@dimen/size_300"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/rounded_corners_gray_light"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <TextView
            android:id="@+id/modal_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/space_16"
            android:text="选择工作表"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_18"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/sheet_list_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_200"
            android:background="@color/surface"
            android:divider="@color/text_secondary"
            android:dividerHeight="1dp"
            android:padding="@dimen/space_8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/select_all_button"
                android:layout_width="@dimen/size_120"
                android:layout_height="wrap_content"
                android:text="全选"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_16"
                android:layout_marginEnd="@dimen/space_8"
                app:backgroundTint="@color/primary"
                app:cornerRadius="@dimen/radius_12"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_button"
                android:layout_width="@dimen/size_120"
                android:layout_height="wrap_content"
                android:text="取消"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_16"
                android:layout_marginStart="@dimen/space_8"
                app:backgroundTint="@color/surface_variant"
                app:cornerRadius="@dimen/radius_12"
                android:textAllCaps="false" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>