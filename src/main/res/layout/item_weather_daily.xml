<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="9dp">

    <TextView
        android:id="@+id/tv_daily_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_13"
        android:textColor="@color/future_text_secondary"
        android:minWidth="@dimen/min_56" />

    <TextView
        android:id="@+id/tv_daily_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_10"
        android:textSize="@dimen/text_20"
        android:textColor="@color/future_text_primary" />

    <TextView
        android:id="@+id/tv_daily_text"
        android:layout_width="@dimen/size_0"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:textSize="@dimen/text_12"
        android:textColor="@color/future_text_tertiary"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tv_daily_low"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_13"
        android:textColor="@color/future_text_tertiary" />

    <com.oilquiz.app.ui.widget.TempRangeBarView
        android:id="@+id/bar_daily_temp"
        android:layout_width="@dimen/size_0"
        android:layout_weight="1.2"
        android:layout_height="@dimen/size_24"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_8" />

    <TextView
        android:id="@+id/tv_daily_high"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_14"
        android:textStyle="bold"
        android:textColor="@color/future_text_primary" />
</LinearLayout>
