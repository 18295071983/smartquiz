<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="9dp">

    <TextView
        android:id="@+id/tv_daily_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/future_text_secondary"
        android:minWidth="56dp" />

    <TextView
        android:id="@+id/tv_daily_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textSize="20sp"
        android:textColor="@color/future_text_primary" />

    <TextView
        android:id="@+id/tv_daily_text"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="12sp"
        android:textColor="@color/future_text_tertiary"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tv_daily_low"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/future_text_tertiary" />

    <com.oilquiz.app.ui.widget.TempRangeBarView
        android:id="@+id/bar_daily_temp"
        android:layout_width="0dp"
        android:layout_weight="1.2"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/tv_daily_high"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/future_text_primary" />
</LinearLayout>
