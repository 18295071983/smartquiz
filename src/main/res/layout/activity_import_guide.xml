<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground"
    tools:context=".ui.activity.ImportGuideActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/elev_0">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:title="导入指南"
            app:titleTextColor="?attr/colorOnSurface"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="选择导入方式"
                android:textSize="@dimen/text_24"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="@dimen/space_24"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAIImport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="6dp"
                app:cardCornerRadius="8dp"
                app:strokeWidth="@dimen/stroke_1"
                app:strokeColor="?attr/colorSecondary"
                android:layout_marginBottom="@dimen/space_16">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🤖 AI 导入"
                        android:textSize="@dimen/text_18"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="@dimen/space_8"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AI 智能识别任意格式题库,自动抽取全部字段,无需手动映射"
                        android:textSize="@dimen/text_14"
                        android:textColor="?attr/colorControlTextSecondary"
                        android:layout_marginBottom="@dimen/space_16"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAIImport"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_48"
                        android:text="开始 AI 导入"
                        app:backgroundTint="?attr/colorSecondary"
                        android:textColor="@android:color/white"
                        app:cornerRadius="@dimen/radius_12"
                        android:textAllCaps="false"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAIImport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="6dp"
                app:cardCornerRadius="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/secondary"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🤖 AI 导入"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AI 智能识别任意格式题库,自动抽取全部字段,无需手动映射"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="16dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAIImport"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="开始 AI 导入"
                        app:backgroundTint="@color/secondary"
                        android:textColor="@android:color/white"
                        app:cornerRadius="12dp"
                        android:textAllCaps="false"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDirectImport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp"
                android:layout_marginBottom="@dimen/space_16">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="直接导入"
                        android:textSize="@dimen/text_18"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="@dimen/space_8"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="从文件直接导入数据到系统"
                        android:textSize="@dimen/text_14"
                        android:textColor="?attr/colorControlTextSecondary"
                        android:layout_marginBottom="@dimen/space_16"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDirectImport"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_48"
                        android:text="开始导入"
                        app:backgroundTint="?attr/colorPrimary"
                        android:textColor="@android:color/white"
                        app:cornerRadius="@dimen/radius_12"
                        android:textAllCaps="false"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTemplateImport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp"
                android:layout_marginBottom="@dimen/space_16">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="模板导入"
                        android:textSize="@dimen/text_18"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="@dimen/space_8"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="使用预设模板导入数据"
                        android:textSize="@dimen/text_14"
                        android:textColor="?attr/colorControlTextSecondary"
                        android:layout_marginBottom="@dimen/space_16"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTemplateImport"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_48"
                        android:text="选择模板"
                        app:backgroundTint="?attr/colorPrimary"
                        android:textColor="@android:color/white"
                        app:cornerRadius="@dimen/radius_12"
                        android:textAllCaps="false"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp"
                android:layout_marginBottom="@dimen/space_16">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="导入历史"
                        android:textSize="@dimen/text_18"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="@dimen/space_8"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="查看历史导入记录"
                        android:textSize="@dimen/text_14"
                        android:textColor="?attr/colorControlTextSecondary"
                        android:layout_marginBottom="@dimen/space_16"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewHistory"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_48"
                        android:text="查看历史"
                        app:backgroundTint="?attr/colorPrimary"
                        android:textColor="@android:color/white"
                        app:cornerRadius="@dimen/radius_12"
                        android:textAllCaps="false"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="支持的文件格式"
                android:textSize="@dimen/text_18"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginBottom="@dimen/space_16"/>

            <LinearLayout
                android:id="@+id/layoutSupportedFormats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/space_24"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>