<?xml version="1.0" encoding="utf-8"?>
<!-- 右侧工具抽屉：模型/深度思考/快捷工具/管理/对话历史 全部收敛于此，主界面只留对话 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- 抽屉标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧰 工具中心"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingBottom="12dp"/>

        <!-- ===== 模型选择 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="模型"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:paddingBottom="4dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_model_select"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="🤖 选择模型"
            android:textSize="12sp"
            android:textColor="@color/on_secondary_container"
            app:backgroundTint="@color/secondary_container"
            app:cornerRadius="12dp"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="12dp"
            android:minWidth="0dp"
            android:layout_marginBottom="12dp"/>

        <!-- ===== 深度思考开关 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="对话模式"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:paddingBottom="4dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_select"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="💬 普通"
            android:textSize="12sp"
            android:textColor="@color/on_primary_container"
            app:backgroundTint="@color/primary_container"
            app:cornerRadius="12dp"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="12dp"
            android:minWidth="0dp"
            android:layout_marginBottom="4dp"/>
        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:singleLine="true"
            android:layout_marginBottom="12dp">
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_normal_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬 对话"
                android:layout_marginEnd="8dp"
                app:chipBackgroundColor="@color/primary_container"
                android:textColor="@color/on_primary_container"
                app:chipStrokeWidth="0dp"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_deep_think"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠 深度思考"
                android:checkable="true"
                app:chipBackgroundColor="@color/chip_gray_bg"
                android:textColor="@color/text_secondary"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="@color/border_light"
                app:checkedIconVisible="false"/>
        </com.google.android.material.chip.ChipGroup>

        <!-- ===== 快捷工具 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="快捷工具"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:paddingBottom="4dp"/>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/quick_actions_chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_weather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌤️ 查天气"
                android:layout_marginBottom="4dp"
                app:chipBackgroundColor="@color/tertiary_container"
                android:textColor="@color/on_tertiary_container"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔍 搜索"
                android:layout_marginBottom="4dp"
                app:chipBackgroundColor="@color/tertiary_container"
                android:textColor="@color/on_tertiary_container"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_translate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌐 翻译"
                android:layout_marginBottom="4dp"
                app:chipBackgroundColor="@color/tertiary_container"
                android:textColor="@color/on_tertiary_container"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_database"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🗄️ 数据库"
                android:layout_marginBottom="4dp"
                app:chipBackgroundColor="@color/tertiary_container"
                android:textColor="@color/on_tertiary_container"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📁 文件"
                android:layout_marginBottom="4dp"
                app:chipBackgroundColor="@color/tertiary_container"
                android:textColor="@color/on_tertiary_container"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 定位"
                android:layout_marginBottom="4dp"
                app:chipBackgroundColor="@color/tertiary_container"
                android:textColor="@color/on_tertiary_container"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📱 应用"
                android:layout_marginBottom="4dp"
                app:chipBackgroundColor="@color/tertiary_container"
                android:textColor="@color/on_tertiary_container"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_calc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="➗ 计算"
                android:layout_marginBottom="4dp"
                app:chipBackgroundColor="@color/tertiary_container"
                android:textColor="@color/on_tertiary_container"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_clear_chat2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🗑️ 清空对话"
                app:chipBackgroundColor="@color/error_container"
                android:textColor="@color/on_error_container"
                app:chipStrokeWidth="0dp"/>
        </com.google.android.material.chip.ChipGroup>

        <!-- ===== 管理入口 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="管理"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:paddingBottom="4dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_agent_manager"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="🛠️ Agent 管理（记忆/工具/工作区/统计）"
            android:textSize="12sp"
            android:textColor="@color/on_secondary_container"
            app:backgroundTint="@color/secondary_container"
            app:cornerRadius="12dp"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="12dp"
            android:minWidth="0dp"
            android:layout_marginBottom="8dp"/>

        <!-- ===== 其他 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_history"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="📜 历史"
                android:textSize="12sp"
                android:textColor="@color/on_secondary_container"
                app:backgroundTint="@color/secondary_container"
                app:cornerRadius="12dp"
                android:textAllCaps="false"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="8dp"
                android:minWidth="0dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_chat"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🗑️ 清空"
                android:textSize="12sp"
                android:textColor="@color/on_error_container"
                app:backgroundTint="@color/error_container"
                app:cornerRadius="12dp"
                android:textAllCaps="false"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="8dp"
                android:minWidth="0dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_auto_tts"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🔇 语音"
                android:textSize="12sp"
                android:textColor="@color/on_secondary_container"
                app:backgroundTint="@color/secondary_container"
                app:cornerRadius="12dp"
                android:textAllCaps="false"
                android:paddingHorizontal="8dp"
                android:minWidth="0dp"/>
        </LinearLayout>

    </LinearLayout>

    </ScrollView>

    <!-- ===== 对话历史（合并入工具抽屉） ===== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_light"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="@color/surface_variant">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="对话历史"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_new_conversation"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="＋ 新建"
            android:textSize="12sp"
            android:textColor="@color/on_primary_container"
            app:backgroundTint="@color/primary_container"
            app:cornerRadius="16dp"
            android:textAllCaps="false"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="10dp"
            android:minWidth="0dp"
            android:contentDescription="新建对话"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_history"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:backgroundTint="@color/surface_variant"
            app:icon="@drawable/ic_clear"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:cornerRadius="18dp"
            app:iconTint="@color/text_primary"
            android:contentDescription="关闭"/>
    </LinearLayout>

    <TextView
        android:id="@+id/history_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="暂无历史对话\n开始你的第一个对话吧"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/history_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_clear_all_history"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_margin="12dp"
        android:text="清空所有历史"
        android:textSize="14sp"
        app:backgroundTint="@color/error"
        android:textColor="@color/on_error"
        app:cornerRadius="22dp"
        android:textAllCaps="false"/>

</LinearLayout>
