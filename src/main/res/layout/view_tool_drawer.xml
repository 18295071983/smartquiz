<?xml version="1.0" encoding="utf-8"?>
<!-- 左侧工具抽屉：模型/深度思考/快捷工具/管理入口 全部收敛于此，主界面只留对话 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- 抽屉标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧰 工具中心"
            android:textSize="@dimen/text_16"
            android:textStyle="bold"
            android:textColor="?attr/colorControlText"
            android:paddingBottom="@dimen/space_12"/>

        <!-- ===== 模型选择 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="模型"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorControlTextSecondary"
            android:paddingBottom="@dimen/space_4"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_model_select"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_40"
            android:text="🤖 选择模型"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorOnSecondaryContainer"
            app:backgroundTint="?attr/colorSecondaryContainer"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="12dp"
            android:minWidth="@dimen/min_0"
            android:layout_marginBottom="@dimen/space_12"/>

        <!-- ===== 深度思考开关 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="对话模式"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorControlTextSecondary"
            android:paddingBottom="@dimen/space_4"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_select"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_40"
            android:text="💬 普通"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorOnPrimaryContainer"
            app:backgroundTint="?attr/colorPrimaryContainer"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="12dp"
            android:minWidth="@dimen/min_0"
            android:layout_marginBottom="@dimen/space_12"/>

        <!-- ===== 快捷工具 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="快捷工具"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorControlTextSecondary"
            android:paddingBottom="@dimen/space_4"/>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/quick_actions_chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_12">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌤️ 查天气"
                android:layout_marginBottom="@dimen/space_4"
                app:chipBackgroundColor="@color/tertiary_container"
                android:textColor="@color/on_tertiary_container"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 搜索"
                android:layout_marginBottom="@dimen/space_4"
                app:chipBackgroundColor="@color/tertiary_container"
                android:textColor="@color/on_tertiary_container"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_database"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗄️ 数据库"
                android:layout_marginBottom="@dimen/space_4"
                app:chipBackgroundColor="@color/tertiary_container"
                android:textColor="@color/on_tertiary_container"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_file"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📁 文件"
                android:layout_marginBottom="@dimen/space_4"
                app:chipBackgroundColor="@color/tertiary_container"
                android:textColor="@color/on_tertiary_container"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 定位"
                android:layout_marginBottom="@dimen/space_4"
                app:chipBackgroundColor="@color/tertiary_container"
                android:textColor="@color/on_tertiary_container"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 应用"
                android:layout_marginBottom="@dimen/space_4"
                app:chipBackgroundColor="@color/tertiary_container"
                android:textColor="@color/on_tertiary_container"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_calc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧰 聚合工具包"
                android:layout_marginBottom="@dimen/space_4"
                app:chipBackgroundColor="@color/tertiary_container"
                android:textColor="@color/on_tertiary_container"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_clear_chat2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗑️ 清空对话"
                app:chipBackgroundColor="@color/error_container"
                android:textColor="@color/on_error_container"
                app:chipStrokeWidth="0dp"/>
        </com.google.android.material.chip.ChipGroup>

        <!-- ===== 管理入口 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="管理"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorControlTextSecondary"
            android:paddingBottom="@dimen/space_4"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_agent_manager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_40"
            android:text="🛠️ Agent 管理（记忆/工具/工作区/统计）"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorOnSecondaryContainer"
            app:backgroundTint="?attr/colorSecondaryContainer"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="12dp"
            android:minWidth="@dimen/min_0"
            android:layout_marginBottom="@dimen/space_8"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ai_center"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_40"
            android:text="🤖 AI 中心（模型/工具/Agent 入口）"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorOnSecondaryContainer"
            app:backgroundTint="?attr/colorSecondaryContainer"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="12dp"
            android:minWidth="@dimen/min_0"
            android:layout_marginBottom="@dimen/space_8"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ai_service"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_40"
            android:text="⚙️ AI 服务（状态/启动/日志）"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorOnSecondaryContainer"
            app:backgroundTint="?attr/colorSecondaryContainer"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="12dp"
            android:minWidth="@dimen/min_0"
            android:layout_marginBottom="@dimen/space_8"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_remote_dsh"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_40"
            android:text="🖥️ 远程连接（电脑）：连接 / 断开 / 清除配置"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorOnTertiaryContainer"
            app:backgroundTint="?attr/colorTertiaryContainer"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="12dp"
            android:minWidth="@dimen/min_0"
            android:layout_marginBottom="@dimen/space_8"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_model_download"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_40"
            android:text="📥 模型下载（本地模型/GGUF）"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorOnSecondaryContainer"
            app:backgroundTint="?attr/colorSecondaryContainer"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="12dp"
            android:minWidth="@dimen/min_0"
            android:layout_marginBottom="@dimen/space_8"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ai_init"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_40"
            android:text="⚡ 一键初始化（自动下载并配置本地模型）"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="12dp"
            android:minWidth="@dimen/min_0"
            android:layout_marginBottom="@dimen/space_8"/>

        <!-- ===== 其他 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_history"
            android:layout_width="match_parent"
                android:layout_height="@dimen/size_40"
                android:layout_weight="1"
                android:text="📜 历史"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorOnSecondaryContainer"
                app:backgroundTint="?attr/colorSecondaryContainer"
                app:cornerRadius="@dimen/radius_12"
                android:textAllCaps="false"
                android:layout_marginEnd="@dimen/space_8"
                android:paddingHorizontal="8dp"
                android:minWidth="@dimen/min_0"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_chat"
            android:layout_width="match_parent"
                android:layout_height="@dimen/size_40"
                android:layout_weight="1"
                android:text="🗑️ 清空"
                android:textSize="@dimen/text_12"
                android:textColor="@color/on_error_container"
                app:backgroundTint="@color/error_container"
                app:cornerRadius="@dimen/radius_12"
                android:textAllCaps="false"
                android:layout_marginEnd="@dimen/space_8"
                android:paddingHorizontal="8dp"
                android:minWidth="@dimen/min_0"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_auto_tts"
            android:layout_width="match_parent"
                android:layout_height="@dimen/size_40"
                android:layout_weight="1"
                android:text="🔇 语音"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorOnSecondaryContainer"
                app:backgroundTint="?attr/colorSecondaryContainer"
                app:cornerRadius="@dimen/radius_12"
                android:textAllCaps="false"
                android:paddingHorizontal="8dp"
                android:minWidth="@dimen/min_0"/>
        </LinearLayout>

        <!-- 系统日志（统一日志中心：AppLogger + AILogger + 崩溃报告 + 操作记录） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_log_viewer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_40"
            android:text="📄 系统日志"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorOnSecondaryContainer"
            app:backgroundTint="?attr/colorSecondaryContainer"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="12dp"
            android:minWidth="@dimen/min_0"/>

    </LinearLayout>
</ScrollView>
