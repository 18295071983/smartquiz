<?xml version="1.0" encoding="utf-8"?>
<!-- 模板导入页面：下载标准导入模板 → 填写 → 用"直接导入"入库 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".ui.activity.TemplateImportActivity">

    <!-- 顶部工具栏 -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/elev_0">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:title="模板导入"
            app:titleTextColor="@color/on_surface" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- 流程说明 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="@dimen/space_12">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📋 使用标准模板导入题目"
                        android:textSize="@dimen/text_17"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:layout_marginBottom="@dimen/space_8" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="① 下载下方任一格式的模板（已含示例行）\n② 按表头填写你的题目（必填：题干、正确答案、题型）\n③ 保存后回到导入页，用「直接导入」选择该文件即可入库"
                        android:textSize="@dimen/text_14"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 字段说明 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="@dimen/space_12">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="模板字段"
                        android:textSize="@dimen/text_15"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:layout_marginBottom="@dimen/space_8" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="必填：题干、正确答案、题型\n选填：选项A~D、分类、难度、解析"
                        android:textSize="@dimen/text_13"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="题型取值：单选题 / 多选题 / 判断题 / 填空题 / 简答题\n选择题答案填字母（如 A 或 ABC），判断题填 对/错，填空题填实际答案文本"
                        android:textSize="@dimen/text_13"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 下载模板按钮 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="@dimen/space_12">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="下载模板"
                        android:textSize="@dimen/text_15"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:layout_marginBottom="@dimen/space_12" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadExcel"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_48"
                        android:text="📊 下载 Excel 模板 (.xlsx)"
                        app:backgroundTint="@color/primary"
                        android:textColor="@color/on_primary"
                        app:cornerRadius="@dimen/radius_12"
                        android:textAllCaps="false"
                        android:layout_marginBottom="@dimen/space_8" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadCsv"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_48"
                        android:text="📄 下载 CSV 模板 (.csv)"
                        app:backgroundTint="@color/secondary"
                        android:textColor="@color/on_secondary"
                        app:cornerRadius="@dimen/radius_12"
                        android:textAllCaps="false"
                        android:layout_marginBottom="@dimen/space_8" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadJson"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_48"
                        android:text="🗂 下载 JSON 模板 (.json)"
                        app:backgroundTint="@color/secondary"
                        android:textColor="@color/on_secondary"
                        app:cornerRadius="@dimen/radius_12"
                        android:textAllCaps="false" />

                    <TextView
                        android:id="@+id/tvTemplatePath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_10"
                        android:textSize="@dimen/text_12"
                        android:textColor="@color/on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 去导入 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoImport"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_52"
                android:text="填好了，去导入 →"
                app:backgroundTint="@color/primary"
                android:textColor="@color/on_primary"
                app:cornerRadius="@dimen/radius_12"
                android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
