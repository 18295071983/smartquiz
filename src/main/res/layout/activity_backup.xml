<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground"
    tools:context=".ui.activity.BackupActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/elev_0">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:title="数据备份"
            app:titleTextColor="?attr/colorOnSurface"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:fillViewport="true">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">
            
            <!-- 状态卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="@dimen/space_20">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_20">
                    
                    <ImageView
                        android:layout_width="@dimen/size_48"
                        android:layout_height="@dimen/size_48"
                        android:src="@drawable/ic_backup"
                        android:tint="?attr/colorOnPrimaryContainer"
                        android:layout_marginEnd="@dimen/space_16" />
                    
                    <LinearLayout
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="备份状态"
                            android:textSize="@dimen/text_18"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:layout_marginBottom="@dimen/space_4" />
                        
                        <TextView
                            android:id="@+id/tv_backup_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="备份状态: 正常"
                            android:textSize="@dimen/text_14"
                            android:textColor="?attr/colorOnPrimaryContainer" />
                        
                    </LinearLayout>
                    
                </LinearLayout>
                
            </com.google.android.material.card.MaterialCardView>
            
            <!-- 主要操作按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/space_20">
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_backup"
                    android:layout_width="@dimen/size_0"
                    android:layout_height="@dimen/size_56"
                    android:layout_weight="1"
                    android:text="创建备份"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    app:backgroundTint="?attr/colorPrimary"
                    android:textColor="@android:color/white"
                    android:layout_marginEnd="@dimen/space_8"
                    app:cornerRadius="@dimen/radius_12"
                    android:textAllCaps="false" />
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_restore"
                    android:layout_width="@dimen/size_0"
                    android:layout_height="@dimen/size_56"
                    android:layout_weight="1"
                    android:text="恢复备份"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    app:backgroundTint="?attr/colorSecondary"
                    android:textColor="@android:color/white"
                    android:layout_marginStart="@dimen/space_8"
                    app:cornerRadius="@dimen/radius_12"
                    android:textAllCaps="false" />
                
            </LinearLayout>
            
            <!-- 额外操作按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/space_20">
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_database_detail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_48"
                    android:text="数据库详情"
                    android:textSize="@dimen/text_14"
                    android:textStyle="bold"
                    app:backgroundTint="?attr/colorSurfaceVariant"
                    android:textColor="?attr/colorOnSurface"
                    app:cornerRadius="@dimen/radius_12"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="@dimen/stroke_1"
                    android:textAllCaps="false" />
                
            </LinearLayout>
            
            <!-- 自动备份设置 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="@dimen/space_20">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_16">
                    
                    <LinearLayout
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="自动备份"
                            android:textSize="@dimen/text_16"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="@dimen/space_4" />
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="开启后每天自动创建备份"
                            android:textSize="@dimen/text_14"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        
                    </LinearLayout>
                    
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_auto_backup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        app:trackTint="?attr/colorSurfaceVariant"
                        app:thumbTint="?attr/colorPrimary" />
                        
                </LinearLayout>
                
            </com.google.android.material.card.MaterialCardView>
            
            <!-- 备份文件标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="备份文件"
                android:textSize="@dimen/text_18"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="@dimen/space_12" />
            
            <!-- 空状态 -->
            <LinearLayout
                android:id="@+id/textViewEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/colorSurface"
                android:elevation="@dimen/elev_2"
                android:padding="@dimen/space_32"
                android:layout_marginHorizontal="@dimen/space_32"
                android:layout_marginTop="@dimen/space_40">
                
                <ImageView
                    android:layout_width="@dimen/size_64"
                    android:layout_height="@dimen/size_64"
                    android:src="@drawable/ic_backup"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="@dimen/space_16" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="没有找到备份文件"
                    android:textSize="@dimen/text_16"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/space_8" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击下方按钮创建备份"
                    android:textSize="@dimen/text_14"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/space_20" />
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_create_backup_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/size_48"
                    android:text="创建备份"
                    android:textSize="@dimen/text_14"
                    app:backgroundTint="?attr/colorPrimary"
                    android:textColor="@android:color/white"
                    android:paddingHorizontal="24dp"
                    app:cornerRadius="@dimen/radius_12"
                    android:textAllCaps="false" />
                
            </LinearLayout>
            
            <!-- 备份文件列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewBackups"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:paddingBottom="@dimen/space_16" />
            
        </LinearLayout>
        
    </ScrollView>

</LinearLayout>