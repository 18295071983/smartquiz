<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 标题 -->
        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="输入验证失败"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_title_text"
            android:layout_marginBottom="16dp" />

        <!-- 错误图标和信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_dialog_alert"
                android:tint="@color/dialog_error_icon"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/paramNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="参数名称"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/dialog_error_text"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <!-- 错误详情 -->
        <TextView
            android:id="@+id/errorMessageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="错误详情"
            android:textSize="15sp"
            android:textColor="@color/dialog_primary_text"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="16dp" />

        <!-- 正确格式 -->
        <TextView
            android:id="@+id/formatLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="正确格式:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_primary_text"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/formatText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="格式说明"
            android:textSize="14sp"
            android:textColor="@color/dialog_format_text"
            android:background="@drawable/bg_validation_info"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- 示例 -->
        <TextView
            android:id="@+id/exampleLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="示例:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_primary_text"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/examplesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• 示例1\n• 示例2\n• 示例3"
            android:textSize="14sp"
            android:textColor="@color/dialog_example_text"
            android:background="@drawable/bg_validation_success"
            android:padding="12dp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- 重试计数 -->
        <TextView
            android:id="@+id/retryCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="已尝试 0/3 次"
            android:textSize="12sp"
            android:textColor="@color/dialog_secondary_text"
            android:layout_marginBottom="24dp" />

        <!-- 警告图标（接近重试上限） -->
        <LinearLayout
            android:id="@+id/warningContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_warning"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_dialog_info"
                android:tint="@color/dialog_warning_icon"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="警告：还剩1次机会"
                android:textSize="13sp"
                android:textColor="@color/dialog_warning_text"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <!-- 按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="取消任务"
                android:textColor="@color/dialog_button_text_secondary" />

            <Button
                android:id="@+id/btnRetry"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="重新输入" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>