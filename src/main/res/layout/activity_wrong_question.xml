<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground"
    tools:context=".ui.activity.WrongQuestionActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/elev_0">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:title="错题本"
            app:titleTextColor="?attr/colorOnSurface"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:fillViewport="true">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">
            
            <!-- 统计卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="@dimen/space_20">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_20">
                    
                    <ImageView
                        android:layout_width="@dimen/size_48"
                        android:layout_height="@dimen/size_48"
                        android:src="@drawable/ic_error"
                        android:tint="?attr/colorOnSecondaryContainer"
                        android:layout_marginEnd="@dimen/space_16" />
                    
                    <LinearLayout
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="错题统计"
                            android:textSize="@dimen/text_18"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:layout_marginBottom="@dimen/space_4" />
                        
                        <TextView
                            android:id="@+id/statsTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="共 0 道错题"
                            android:textSize="@dimen/text_14"
                            android:textColor="?attr/colorOnSecondaryContainer" />
                        
                    </LinearLayout>
                    
                </LinearLayout>
                
            </com.google.android.material.card.MaterialCardView>
            
            <!-- 操作按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/space_20">
                
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardViewReviewAll"
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    android:layout_marginEnd="@dimen/space_8"
                    android:clickable="true"
                    android:focusable="true">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/space_20">
                        
                        <ImageView
                            android:layout_width="@dimen/size_32"
                            android:layout_height="@dimen/size_32"
                            android:src="@drawable/ic_quiz"
                            android:tint="?attr/colorPrimary"
                            android:layout_marginBottom="@dimen/space_8" />
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="复习全部"
                            android:textSize="@dimen/text_14"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />
                        
                    </LinearLayout>
                    
                </com.google.android.material.card.MaterialCardView>
                
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardViewClearAll"
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:clickable="true"
                    android:focusable="true">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/space_20">
                        
                        <ImageView
                            android:layout_width="@dimen/size_32"
                            android:layout_height="@dimen/size_32"
                            android:src="@drawable/ic_error"
                            android:tint="@color/error"
                            android:layout_marginBottom="@dimen/space_8" />
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="清空全部"
                            android:textSize="@dimen/text_14"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />
                        
                    </LinearLayout>
                    
                </com.google.android.material.card.MaterialCardView>
                
            </LinearLayout>
            
            <!-- 错题列表标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="错题列表"
                android:textSize="@dimen/text_18"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="@dimen/space_12" />
            
        </LinearLayout>
        
    </ScrollView>

    <!-- 错题列表 -->
    <ListView
        android:id="@+id/lv_wrong_questions"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:padding="@dimen/space_16"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp"
        android:clipToPadding="false" />

</LinearLayout>
