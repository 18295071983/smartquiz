<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:orientation="vertical"
    tools:context=".ui.activity.AIIconDemoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorCardBackground"
        android:elevation="@dimen/elev_4"
        android:orientation="horizontal"
        android:padding="@dimen/space_16">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/size_40"
            android:layout_height="@dimen/size_40"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/space_8"
            android:src="@drawable/ic_back"
            android:tint="?attr/colorControlText"
            android:contentDescription="返回"/>

        <LinearLayout
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_8"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI图标演示"
                android:textSize="@dimen/text_20"
                android:textStyle="bold"
                android:textColor="?attr/colorControlText"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="查看和测试所有AI图标"
                android:textSize="@dimen/text_14"
                android:textColor="?attr/colorControlTextSecondary"
                android:layout_marginTop="@dimen/space_2"/>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorCardBackground"
        app:tabGravity="fill"
        app:tabMode="fixed"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabSelectedTextColor="?attr/colorPrimary"
        app:tabTextColor="?attr/colorControlTextSecondary"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorCardBackground"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="智能图标测试"
            android:textSize="@dimen/text_14"
            android:textStyle="bold"
            android:textColor="?attr/colorControlText"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="输入意图类型，测试图标自动匹配"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorControlTextSecondary"
            android:layout_marginTop="@dimen/space_4"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_8">

            <EditText
                android:id="@+id/etIntentTest"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="例如: translate, ocr, generate..."
                android:inputType="text"
                android:maxLines="1"
                android:background="@drawable/edittext_background"
                android:padding="@dimen/space_12"
                android:textColor="?attr/colorControlText"
                android:textSize="@dimen/text_14"/>

            <Button
                android:id="@+id/btnTestIntent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:text="测试"
                android:backgroundTint="?attr/colorPrimary"
                android:textColor="@color/white"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llTestResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center_vertical"
            android:padding="@dimen/space_12"
            android:background="@color/primary_alpha_10"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivTestResult"
                android:layout_width="@dimen/size_48"
                android:layout_height="@dimen/size_48"
                android:contentDescription="匹配的图标"/>

            <LinearLayout
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_12"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTestIconName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    android:textColor="?attr/colorControlText"/>

                <TextView
                    android:id="@+id/tvTestIconDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorControlTextSecondary"
                    android:layout_marginTop="@dimen/space_2"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_8">

            <TextView
                android:id="@+id/tvQuickHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="快速测试: "
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlTextSecondary"/>

            <TextView
                android:id="@+id/tvQuick1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="translate"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorPrimary"
                android:clickable="true"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_8"/>

            <TextView
                android:id="@+id/tvQuick2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ocr"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorPrimary"
                android:clickable="true"
                android:paddingEnd="@dimen/space_8"/>

            <TextView
                android:id="@+id/tvQuick3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="agent"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorPrimary"
                android:clickable="true"
                android:paddingEnd="@dimen/space_8"/>

            <TextView
                android:id="@+id/tvQuick4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="success"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorPrimary"
                android:clickable="true"
                android:paddingEnd="@dimen/space_8"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
