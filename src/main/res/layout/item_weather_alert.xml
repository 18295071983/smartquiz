<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/alert_card_bg"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- 顶部：图标 + 标题 + 等级标签 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 预警图标 -->
        <TextView
            android:id="@+id/tv_alert_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="20sp" />

        <!-- 标题 -->
        <TextView
            android:id="@+id/tv_alert_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="暴雨黄色预警"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/weather_dark_text"
            android:layout_marginStart="10dp" />

        <!-- 等级标签 -->
        <TextView
            android:id="@+id/tv_alert_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="黄色"
            android:textSize="11sp"
            android:textColor="@color/white"
            android:background="@drawable/alert_level_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <!-- 发布时间 -->
    <TextView
        android:id="@+id/tv_alert_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="发布时间：2024-07-20 10:30"
        android:textSize="12sp"
        android:textColor="@color/weather_dark_text_secondary"
        android:layout_marginTop="8dp"
        android:layout_marginStart="30dp" />

    <!-- 预警内容（可展开） -->
    <TextView
        android:id="@+id/tv_alert_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="预计未来6小时内，我市大部分地区将出现50毫米以上降水，并伴有短时大风和雷电..."
        android:textSize="13sp"
        android:textColor="@color/weather_dark_text_secondary"
        android:layout_marginTop="8dp"
        android:layout_marginStart="30dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp" />

    <!-- 展开/收起按钮 -->
    <TextView
        android:id="@+id/btn_expand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="展开详情 ▼"
        android:textSize="12sp"
        android:textColor="@color/blue_400"
        android:layout_marginTop="6dp"
        android:layout_marginStart="30dp"
        android:paddingVertical="4dp" />
</LinearLayout>
