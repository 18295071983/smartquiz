<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_16"
    android:background="?attr/colorSurface"
    android:layout_marginBottom="@dimen/space_8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/space_8">
        <TextView
            android:id="@+id/textViewFileName"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="文件名"
            android:textSize="@dimen/text_16"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"/>
        <TextView
            android:id="@+id/textViewStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="状态"
            android:textSize="@dimen/text_14"
            android:textColor="@color/success_color"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/space_8">
        <TextView
            android:id="@+id/textViewImportTime"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2024-01-01 12:00:00"
            android:textSize="@dimen/text_14"
            android:textColor="?attr/colorControlTextSecondary"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_32"
            android:text="删除"
            android:textSize="@dimen/text_12"
            app:backgroundTint="@color/error"
            android:textColor="@android:color/white"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/textViewImportedCount"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="成功: 0"
            android:textSize="@dimen/text_14"
            android:textColor="?attr/colorControlTextSecondary"/>
        <TextView
            android:id="@+id/textViewFailedCount"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="失败: 0"
            android:textSize="@dimen/text_14"
            android:textColor="?attr/colorControlTextSecondary"
            android:gravity="right"/>
    </LinearLayout>

</LinearLayout>