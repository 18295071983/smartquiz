<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/block_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="1dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/thinking_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💭 思考过程"
                android:textSize="11sp"
                android:textColor="@color/thinking_text"
                android:layout_marginBottom="2dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/thinking_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/thinking_message_background"
                android:padding="8dp"
                android:textColor="@color/thinking_text"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.2"
                android:visibility="gone" />

            <!-- 推理进度视图 -->
            <com.oilquiz.app.ai.chat.InferenceProgressView
                android:id="@+id/inference_progress_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Agent执行视图 -->
            <com.oilquiz.app.ai.chat.AgentExecutionView
                android:id="@+id/agent_execution_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Agent执行面板（通用容器） -->
            <com.oilquiz.app.ai.agent.AgentExecutionPanel
                android:id="@+id/agent_execution_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/attachments_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:visibility="gone"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/message_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:background="@drawable/ai_message_background"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3"
                android:textIsSelectable="true" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/btn_expand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="展开全文"
        android:textSize="11sp"
        android:textColor="@color/primary"
        android:padding="3dp"
        android:layout_marginTop="2dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground" />

    <LinearLayout
        android:id="@+id/action_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="复制"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:padding="3dp"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="分享"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:padding="3dp"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_regenerate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重新生成"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:padding="3dp"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_new_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="新对话"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:padding="3dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="1dp">

        <ImageView
            android:id="@+id/status_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 在线模型信息区域 -->
    <LinearLayout
        android:id="@+id/model_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:visibility="gone">

        <View
            android:id="@+id/model_status_indicator"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:background="@drawable/status_indicator_unknown"/>

        <TextView
            android:id="@+id/model_name_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"/>

        <TextView
            android:id="@+id/model_latency_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/text_tertiary"/>

        <TextView
            android:id="@+id/model_cost_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="10sp"
            android:textColor="@color/text_tertiary"/>

    </LinearLayout>

    <TextView
        android:id="@+id/timestamp_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="@color/text_secondary"
        android:layout_marginStart="6dp" />

</LinearLayout>
