<?xml version="1.0" encoding="utf-8"?>
<!-- AI 服务一键初始化 — 全屏引导界面（v2 重构：清晰分区 + 卡片化下载详情 + 双进度独立） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0A28">

    <!-- 极光背景：渐变 + 流动光晕 + 粒子 -->
    <com.oilquiz.app.ui.widget.AuroraBackgroundView
        android:id="@+id/aurora_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部装饰光带 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_home_header"
        android:alpha="0.6" />

    <!-- 关闭按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/ai_init_close_bg"
        android:text="✕"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:cornerRadius="22dp"
        app:rippleColor="#33FFFFFF"
        app:iconTint="@android:color/transparent"
        app:strokeColor="@android:color/transparent"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        style="@style/Widget.Material3.Button.IconButton" />

    <!-- 主内容 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="64dp"
            android:paddingBottom="32dp">

            <!-- ═══════════ 顶部品牌区 ═══════════ -->
            <FrameLayout
                android:id="@+id/logo_container"
                android:layout_width="108dp"
                android:layout_height="108dp">

                <View
                    android:id="@+id/logo_glow"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:background="@drawable/ai_init_logo_glow" />

                <View
                    android:id="@+id/logo_circle"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ai_init_logo_circle" />

                <TextView
                    android:id="@+id/logo_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="⚡"
                    android:textSize="32sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="AI 服务初始化"
                android:textSize="23sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="自动下载并配置本地模型 · 离线也能用"
                android:textSize="13sp"
                android:textColor="#B0FFFFFF" />

            <!-- ═══════════ 模型选择区（初始化前显示，开始后隐藏）═══════════ -->
            <LinearLayout
                android:id="@+id/model_picker_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🎯 选择要初始化的模型"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_picker_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="已选：1 个"
                        android:textSize="12sp"
                        android:textColor="#90FFFFFF" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:maxHeight="280dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/model_picker_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

            <!-- ═══════════ 推理参数入口 ═══════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_params"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="⚙️ 推理参数"
                    android:textSize="13sp"
                    android:textColor="#B3E5FC" />

                <TextView
                    android:id="@+id/tv_params_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="自动参数（推荐）"
                    android:textSize="12sp"
                    android:textColor="#90FFFFFF"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- ═══════════ 进度展示区 ═══════════ -->
            <com.oilquiz.app.ui.widget.GradientRingProgress
                android:id="@+id/ring_progress"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_marginTop="22dp" />

            <LinearLayout
                android:id="@+id/steps_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal" />

            <!-- ═══════════ 下载详情卡片（主模型 + 视觉模块 双进度独立）═══════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/ai_init_download_card"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- 主模型 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📦 主模型"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_model_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textSize="12sp"
                        android:textColor="#90FFFFFF" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/model_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#6EC6FF"
                    android:progressBackgroundTint="#26FFFFFF" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="#1AFFFFFF" />

                <!-- 视觉模块（mmproj） -->
                <LinearLayout
                    android:id="@+id/mmproj_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_mmproj_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🧩 视觉模块"
                            android:textSize="13sp"
                            android:textColor="#C8FFFFFF"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_mmproj_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 / 0 MB"
                            android:textSize="12sp"
                            android:textColor="#90FFFFFF" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/mmproj_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#8E6CFF"
                        android:progressBackgroundTint="#26FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════════ 状态文案 ═══════════ -->
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:minHeight="42dp"
                android:text="准备就绪，即将开始…"
                android:textColor="#D0FFFFFF"
                android:textSize="14sp" />

            <!-- ═══════════ 操作按钮 ═══════════ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/ai_init_btn_bg"
                android:text="开始初始化"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="26dp"
                app:rippleColor="#33FFFFFF"
                android:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <TextView
                android:id="@+id/tv_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="请保持网络畅通 · 首次约需下载 1.5 GB"
                android:textSize="12sp"
                android:textColor="#80FFFFFF" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
