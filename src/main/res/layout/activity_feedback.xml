<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/space_16"
    android:background="@color/background_gray"
    >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/feedback_title"
        android:textSize="@dimen/text_24"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/space_24"
        android:layout_gravity="center_horizontal"
        android:textColor="?attr/colorControlText"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_card"
        android:elevation="@dimen/elev_4"
        android:padding="@dimen/space_20"
        android:layout_marginBottom="@dimen/space_16">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedback_type"
            android:textSize="@dimen/text_16"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorControlText"
            android:layout_marginBottom="@dimen/space_12"/>

        <Spinner
            android:id="@+id/spinnerFeedbackType"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_48"
            android:entries="@array/feedback_types"
            android:prompt="@string/select_feedback_type"
            android:background="@drawable/rounded_edittext"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_card"
        android:elevation="@dimen/elev_4"
        android:padding="@dimen/space_20"
        android:layout_marginBottom="@dimen/space_16">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedback_content"
            android:textSize="@dimen/text_16"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorControlText"
            android:layout_marginBottom="@dimen/space_12"/>

        <EditText
            android:id="@+id/editTextFeedbackContent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_200"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:hint="@string/feedback_content_hint"
            android:background="@drawable/rounded_edittext"
            android:padding="@dimen/space_16"
            android:minLines="5"
            android:maxLines="10"
            android:lineSpacingExtra="4dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_card"
        android:elevation="@dimen/elev_4"
        android:padding="@dimen/space_20"
        android:layout_marginBottom="@dimen/space_24">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contact_info"
            android:textSize="@dimen/text_16"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorControlText"
            android:layout_marginBottom="@dimen/space_12"/>

        <EditText
            android:id="@+id/editTextContactInfo"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_48"
            android:inputType="text"
            android:hint="@string/contact_info_hint"
            android:background="@drawable/rounded_edittext"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"/>

    </LinearLayout>

    <Button
        android:id="@+id/buttonSubmitFeedback"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_56"
        android:text="@string/submit_feedback"
        android:background="@drawable/rounded_corners_purple"
        android:textColor="@color/white"
        android:textSize="@dimen/text_16"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="@dimen/space_16"
        android:stateListAnimator="@null"
        android:elevation="@dimen/elev_4"/>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:indeterminateTint="@color/purple_500"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/feedback_note"
        android:textSize="@dimen/text_12"
        android:textColor="?attr/colorControlTextSecondary"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_16"
        android:lineSpacingExtra="2dp"
        android:paddingHorizontal="16dp"
        android:gravity="center"/>

</LinearLayout>
