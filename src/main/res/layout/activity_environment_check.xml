<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground"
    tools:context=".ui.activity.EnvironmentCheckActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/elev_0">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:titleTextColor="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:padding="@dimen/space_16">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <!-- 检测状态 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="@dimen/space_20">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_20">
                    
                    <ImageView
                        android:layout_width="@dimen/size_48"
                        android:layout_height="@dimen/size_48"
                        android:src="@drawable/ic_check_circle"
                        android:tint="?attr/colorOnPrimaryContainer"
                        android:layout_marginEnd="@dimen/space_16" />
                    
                    <LinearLayout
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="环境检测完成"
                            android:textSize="@dimen/text_16"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:layout_marginBottom="@dimen/space_4" />
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="设备环境正常，可以运行应用"
                            android:textSize="@dimen/text_14"
                            android:textColor="?attr/colorOnPrimaryContainer" />
                        
                    </LinearLayout>
                    
                </LinearLayout>
                
            </com.google.android.material.card.MaterialCardView>
            
            <!-- 设备信息 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="@dimen/space_16">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="设备信息"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="@dimen/space_12" />
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/size_1"
                            android:background="?attr/colorSurfaceVariant"
                            android:layout_marginBottom="@dimen/space_12" />
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/space_12">
                            
                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="制造商"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            
                            <TextView
                                android:id="@+id/tv_manufacturer"
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />
                            
                        </LinearLayout>
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/space_12">
                            
                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="品牌"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            
                            <TextView
                                android:id="@+id/tv_brand"
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />
                            
                        </LinearLayout>
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/space_12">
                            
                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="型号"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            
                            <TextView
                                android:id="@+id/tv_model"
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />
                            
                        </LinearLayout>
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            
                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="硬件"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            
                            <TextView
                                android:id="@+id/tv_hardware"
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />
                            
                        </LinearLayout>
                        
                    </LinearLayout>
                    
                </LinearLayout>
                
            </com.google.android.material.card.MaterialCardView>
            
            <!-- 系统信息 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="@dimen/space_16">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="系统信息"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="@dimen/space_12" />
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/size_1"
                            android:background="?attr/colorSurfaceVariant"
                            android:layout_marginBottom="@dimen/space_12" />
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/space_12">
                            
                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Android版本"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            
                            <TextView
                                android:id="@+id/tv_android_version"
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />
                            
                        </LinearLayout>
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/space_12">
                            
                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="SDK级别"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            
                            <TextView
                                android:id="@+id/tv_sdk_int"
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />
                            
                        </LinearLayout>
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/space_12">
                            
                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="安全补丁"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            
                            <TextView
                                android:id="@+id/tv_security_patch"
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />
                            
                        </LinearLayout>
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            
                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="语言"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            
                            <TextView
                                android:id="@+id/tv_language"
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />
                            
                        </LinearLayout>
                        
                    </LinearLayout>
                    
                </LinearLayout>
                
            </com.google.android.material.card.MaterialCardView>
            
            <!-- 硬件信息 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="@dimen/space_16">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="硬件信息"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="@dimen/space_12" />
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/size_1"
                            android:background="?attr/colorSurfaceVariant"
                            android:layout_marginBottom="@dimen/space_12" />
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/space_12">
                            
                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="CPU架构"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            
                            <TextView
                                android:id="@+id/tv_cpu_abi"
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />
                            
                        </LinearLayout>
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/space_12">
                            
                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="处理器数量"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            
                            <TextView
                                android:id="@+id/tv_processors"
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />
                            
                        </LinearLayout>
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/space_12">
                            
                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="相机"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            
                            <TextView
                                android:id="@+id/tv_camera"
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />
                            
                        </LinearLayout>
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            
                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="GPS"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            
                            <TextView
                                android:id="@+id/tv_gps"
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />
                            
                        </LinearLayout>
                        
                    </LinearLayout>
                    
                </LinearLayout>
                
            </com.google.android.material.card.MaterialCardView>
            
            <!-- 内存信息 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="@dimen/space_16">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="内存信息"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="@dimen/space_12" />
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/size_1"
                            android:background="?attr/colorSurfaceVariant"
                            android:layout_marginBottom="@dimen/space_12" />
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/space_12">
                            
                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="总内存"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            
                            <TextView
                                android:id="@+id/tv_total_memory"
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />
                            
                        </LinearLayout>
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            
                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="可用内存"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            
                            <TextView
                                android:id="@+id/tv_available_memory"
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />
                            
                        </LinearLayout>
                        
                    </LinearLayout>
                    
                </LinearLayout>
                
            </com.google.android.material.card.MaterialCardView>
            
            <!-- 存储信息 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="@dimen/space_16">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="存储信息"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="@dimen/space_12" />
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/size_1"
                            android:background="?attr/colorSurfaceVariant"
                            android:layout_marginBottom="@dimen/space_12" />
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/space_12">
                            
                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="内部存储"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            
                            <TextView
                                android:id="@+id/tv_internal_storage"
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />
                            
                        </LinearLayout>
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            
                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="外部存储"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            
                            <TextView
                                android:id="@+id/tv_external_storage"
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />
                            
                        </LinearLayout>
                        
                    </LinearLayout>
                    
                </LinearLayout>
                
            </com.google.android.material.card.MaterialCardView>
            
        </LinearLayout>
        
    </ScrollView>

    <!-- 底部操作按钮 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="8dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        android:layout_margin="@dimen/space_16">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/space_16">
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy"
                android:layout_width="@dimen/size_0"
                android:layout_height="@dimen/size_48"
                android:layout_weight="1"
                android:text="复制信息"
                app:backgroundTint="?attr/colorPrimary"
                android:textColor="@android:color/white"
                android:layout_marginEnd="@dimen/space_8"
                app:cornerRadius="@dimen/radius_12"
                android:textAllCaps="false"/>
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share"
                android:layout_width="@dimen/size_0"
                android:layout_height="@dimen/size_48"
                android:layout_weight="1"
                android:text="分享报告"
                app:backgroundTint="?attr/colorSecondary"
                android:textColor="@android:color/white"
                app:cornerRadius="@dimen/radius_12"
                android:textAllCaps="false"/>
            
        </LinearLayout>
        
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
