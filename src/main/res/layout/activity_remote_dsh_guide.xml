<?xml version="1.0" encoding="utf-8"?>
<!--
  remote_dsh 使用教程：怎么用 + 电脑端怎么配 + 一键导出电脑端程序。
  2026-11-10 重写：补上「同步/直连两种模式」「导入电脑历史」「审批双端」「后台通知」等新能力。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <!-- ===== 这是什么 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardElevation="4dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="?attr/colorCardBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🖥 远程控制电脑（怎么用）"
                    android:textSize="@dimen/text_18"
                    android:textStyle="bold"
                    android:textColor="?attr/colorControlText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:lineSpacingExtra="4dp"
                    android:text="配对之后，你可以在手机上直接让电脑上的 AI 干活。\n\n执行位置由电脑自动选择（不用你切模式）：\n· 这条对话正在电脑上打开 → 宿主内执行：电脑和手机看到同一段对话，思考、工具卡、产物实时同步，零冷启动\n· 没在电脑上打开 → 子进程续写：随时可用，不打断你在电脑上正在聊的别的话题\n\n你只需要选择「跟随哪条对话」。配对一次，之后切后台、锁屏都还能收到电脑端的新消息（通知栏提示）。"
                    android:textSize="@dimen/text_13"
                    android:textColor="?attr/colorControlTextSecondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 电脑端准备 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardElevation="4dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="?attr/colorCardBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="第 1 步 · 电脑端准备（一次性）"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    android:textColor="?attr/colorControlText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:lineSpacingExtra="4dp"
                    android:text="1) 电脑装好 DeepSeek Harness（桌面版）并登录\n2) 装本插件：插件管理器 → 从文件夹安装 → 选下面导出的 plugin 文件夹 → 重启 DSH\n3) 重启后打开 DSH，输入框上方点「📱 手机远程」→「在电脑上打开配对页」\n4) 电脑和手机在同一 Wi-Fi 时扫「局域网」那张码；不在同一网段就扫「公网/隧道」那张（需要先在面板里填隧道域名）"
                    android:textSize="@dimen/text_13"
                    android:textColor="?attr/colorControlTextSecondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_export"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_44"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="导出电脑端插件（拷到电脑上安装）"
                    android:textAllCaps="false"
                    android:textSize="@dimen/text_14"
                    app:cornerRadius="@dimen/radius_22" />

                <TextView
                    android:id="@+id/export_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:lineSpacingExtra="3dp"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorControlTextSecondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 手机端配对 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardElevation="4dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="?attr/colorCardBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="第 2 步 · 手机配对"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    android:textColor="?attr/colorControlText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:lineSpacingExtra="4dp"
                    android:text="回到本页上一级「远程连接（电脑）」：\n· 扫码配对 —— 扫电脑上打开的配对页\n· 或手填：地址填电脑插件面板里的地址（局域网 http://IP:8218 或隧道 https://…），令牌填面板里的 32 位令牌\n\n连上后顶部会显示「已连接」，并列出已配对设备数。"
                    android:textSize="@dimen/text_13"
                    android:textColor="?attr/colorControlTextSecondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 选会话 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardElevation="4dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="?attr/colorCardBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="第 3 步 · 选一条电脑会话"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    android:textColor="?attr/colorControlText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:lineSpacingExtra="4dp"
                    android:text="点「选择要跟随的电脑对话」：\n· 列表只显示「还在用」的会话 —— 归档的、以及没有标题也没有消息的空会话都不会出现\n· 框里每 3 秒自动对齐电脑端，新开的对话会自动出现\n· 选中后手机就跟随这条对话，执行位置由电脑按「是否打开着」自动决定\n\n想把电脑上已有的整段对话搬到手机：点「把电脑这条对话的历史导入本机」，导入后会生成一条本地历史并自动打开，可离线回看。"
                    android:textSize="@dimen/text_13"
                    android:textColor="?attr/colorControlTextSecondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 能用什么 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardElevation="4dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="?attr/colorCardBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="配对后能做什么"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    android:textColor="?attr/colorControlText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:lineSpacingExtra="4dp"
                    android:text="· 对话同步：手机上发一句，电脑那条对话里会出现；电脑在跑的过程（思考、第几步、正在运行哪个工具）手机上也能看到\n· 工具卡与卡片：待办、产物文件、命令、子代理、工作流进度、模型报错都会变成卡片\n· 审批：电脑弹审批时手机也弹，「谁先点谁生效」，另一端自动消失\n· 后台通知：切后台/锁屏仍会收，通知栏显示「电脑端 · 同步中」和最新一段回复，点通知回到对话\n· 断线续传：App 被杀、网络断了，回来会按上次的进度自动补拉，不丢消息"
                    android:textSize="@dimen/text_13"
                    android:textColor="?attr/colorControlTextSecondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 常见问题 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardElevation="4dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="?attr/colorCardBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="常见问题"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    android:textColor="?attr/colorControlText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:lineSpacingExtra="4dp"
                    android:text="· 连不上：确认电脑 DSH 开着、插件已装并重启；隧道域名是否正确；面板里「已配对设备」是否 ≥1\n· 消息不同步：看远程连接页是否已选「要跟随的对话」，以及「自检 / 对账」里「呼吸」是否显示在线\n· 审批点了没反应：可能已在电脑上处理，或端口只在局域网可用\n· 电脑端 AI 报「余额不足 / QUOTA」：去 DeepSeek 账户充值，手机上会显示一张红色报错卡\n· 安装 Python 包崩溃：只能装预编译 wheel；需要现场编译的包请用电脑或 Termux"
                    android:textSize="@dimen/text_13"
                    android:textColor="?attr/colorControlTextSecondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_goto_connect"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_48"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_24"
            android:text="去配对 / 连接"
            android:textAllCaps="false"
            android:textSize="@dimen/text_15"
            app:cornerRadius="@dimen/radius_24" />
    </LinearLayout>
</ScrollView>
