<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/space_12"
    android:background="@drawable/bg_card_background"
    android:layout_marginBottom="@dimen/space_4">

    <View
        android:id="@+id/model_link_status_indicator"
        android:layout_width="@dimen/size_8"
        android:layout_height="@dimen/size_8"
        android:background="@drawable/status_indicator_unknown"/>

    <LinearLayout
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_10"
        android:orientation="vertical">

        <TextView
            android:id="@+id/model_link_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="模型名称"
            android:textSize="@dimen/text_14"
            android:textStyle="bold"
            android:textColor="?attr/colorControlText"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_2">

            <TextView
                android:id="@+id/model_link_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="gpt-4"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlTextSecondary"/>

            <TextView
                android:id="@+id/model_link_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:text="在线"
                android:textSize="@dimen/text_12"
                android:textColor="@color/success_color"/>

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/model_link_latency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="150ms"
        android:textSize="@dimen/text_12"
        android:textColor="?attr/colorControlTextHint"
        android:layout_marginEnd="@dimen/space_8"/>

    <TextView
        android:id="@+id/model_link_cost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0.0030"
        android:textSize="@dimen/text_12"
        android:textColor="?attr/colorControlTextHint"/>

</LinearLayout>