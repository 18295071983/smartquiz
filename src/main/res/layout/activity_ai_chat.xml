<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_full"
    tools:context=".ui.activity.AIChatActivity">

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@android:color/transparent">

        <!-- 合并头部：状态信息 + 右侧抽屉按钮，同一渐变胶囊容器 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_12"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/status_bar_background"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <!-- 模型状态信息（可点击弹出详情） -->
            <LinearLayout
                android:id="@+id/service_status_bar"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- 状态图标容器（圆形浅紫底） -->
                <LinearLayout
                    android:layout_width="@dimen/size_36"
                    android:layout_height="@dimen/size_36"
                    android:background="@drawable/status_icon_bg"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/service_status_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏳"
                        android:textSize="@dimen/text_18"/>
                </LinearLayout>

                <!-- 三行信息区：服务状态 / 进度+统计 -->
                <LinearLayout
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/space_10">

                    <!-- 行1：服务状态 + 余额 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/service_status_text"
                            android:layout_width="@dimen/size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/chat_service_not_initialized"
                            android:textSize="@dimen/text_11"
                            android:textColor="?attr/colorControlText"
                            android:maxLines="1"
                            android:ellipsize="end"/>

                        <TextView
                            android:id="@+id/tv_api_balance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text=""
                            android:textSize="@dimen/text_12"
                            android:textColor="?attr/colorControlTextSecondary"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <!-- 行2：进度 + 耗时 + token 统计 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ProgressBar
                            android:id="@+id/service_status_progress"
                            android:layout_width="@dimen/size_0"
                            android:layout_height="@dimen/size_4"
                            android:layout_weight="1"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:progress="0"
                            android:max="100"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/service_status_elapsed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_6"
                            android:text=""
                            android:textSize="@dimen/text_12"
                            android:textColor="?attr/colorControlTextSecondary"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/tv_token_stats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="🔵 0 tokens"
                            android:textSize="@dimen/text_11"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <!-- 行3：native 状态机阶段 + KV 缓存状态（命中率/上下文占用） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_gen_phase"
                            android:layout_width="@dimen/size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            android:textSize="@dimen/text_11"
                            android:textColor="?attr/colorControlTextSecondary"
                            android:maxLines="1"
                            android:ellipsize="end"/>

                        <TextView
                            android:id="@+id/tv_kv_stats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="KV: --"
                            android:textSize="@dimen/text_11"
                            android:textColor="?attr/colorControlTextSecondary"
                            android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 右侧抽屉按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                android:layout_width="@dimen/size_36"
                android:layout_height="@dimen/size_36"
                android:layout_marginStart="@dimen/space_8"
                style="@style/Widget.Material3.Button.IconButton"
                app:icon="@drawable/ic_menu_hamburger"
                app:iconSize="20dp"
                app:iconTint="?attr/colorControlText"
                android:contentDescription="工具中心"/>
        </LinearLayout>

        <!-- 电脑连接状态条（remote_dsh）：常驻可见，点一下进「远程连接（电脑）」。
             为什么要加：连接状态以前只在 AI 的文字回复里出现，界面上没有任何提示（用户反馈 2026-09-27）。 -->
        <LinearLayout
            android:id="@+id/remote_dsh_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_12"
            android:layout_marginTop="@dimen/space_6"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/status_bar_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <View
                android:id="@+id/remote_dsh_dot"
                android:layout_width="@dimen/size_12"
                android:layout_height="@dimen/size_12"
                android:layout_marginEnd="@dimen/space_8"
                android:background="@drawable/circle_red"/>

            <TextView
                android:id="@+id/remote_dsh_text"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="电脑未配对"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlText"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/remote_dsh_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:text="去配对 ›"
                android:textSize="@dimen/text_12"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"/>

            <!-- 关闭按钮：只隐藏这条状态条（偏好可在「远程连接（电脑）」里重新打开） -->
            <ImageButton
                android:id="@+id/remote_dsh_hide"
                android:layout_width="@dimen/size_24"
                android:layout_height="@dimen/size_24"
                android:layout_marginStart="@dimen/space_6"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:scaleType="centerInside"
                android:contentDescription="隐藏状态条"
                app:tint="?attr/colorControlTextSecondary"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_0"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_0"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/message_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/space_16"
                    android:clipToPadding="false"/>

                <!-- 回到底部按钮：用户回读离开底部时显示，点击回到最新消息 -->
                <TextView
                    android:id="@+id/btn_scroll_bottom"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/system_message_background"
                    android:gravity="center"
                    android:text="↓"
                    android:textSize="20sp"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:visibility="gone"/>

                <!-- 加载更早消息按钮：滚到顶部且有未加载历史时显示，点击分段加载上一页 -->
                <TextView
                    android:id="@+id/btn_load_more_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="8dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/system_message_background"
                    android:gravity="center"
                    android:text="加载更早消息"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:visibility="gone"/>

                <!-- 空状态视图 -->
                <LinearLayout
                    android:id="@+id/empty_state_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/space_32"
                    android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖"
                    android:textSize="@dimen/text_64"
                    android:layout_marginBottom="@dimen/space_16"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开始你的AI对话"
                    android:textSize="@dimen/text_20"
                    android:textStyle="bold"
                    android:textColor="#E8FFFFFF"
                    android:layout_marginBottom="@dimen/space_8"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="输入消息开始对话，或尝试以下快捷命令："
                    android:textSize="@dimen/text_14"
                    android:textColor="#B3FFFFFF"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/space_24"/>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/empty_state_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_empty_example1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="帮我总结这段文字"
                        app:chipBackgroundColor="?attr/colorSurfaceVariant"
                        android:textColor="?attr/colorControlText"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_empty_example2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="解释这段代码"
                        app:chipBackgroundColor="?attr/colorSurfaceVariant"
                        android:textColor="?attr/colorControlText"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_empty_example3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="今天天气如何"
                        app:chipBackgroundColor="?attr/colorSurfaceVariant"
                        android:textColor="?attr/colorControlText"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_clear_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清空"
                app:chipIcon="@drawable/ic_clear"
                app:chipIconTint="@color/error"
                app:chipBackgroundColor="@color/error_container"
                android:textColor="@color/on_error_container"
                app:chipStrokeWidth="0dp"/>

        </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </FrameLayout>
        </LinearLayout>

        <View
            android:id="@+id/thinking_indicator"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_3"
            android:background="@drawable/gradient_primary"
            android:visibility="gone"/>


        <LinearLayout
            android:id="@+id/log_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/transparent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_12">
                <TextView
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="处理日志"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold"
                    android:textColor="?attr/colorControlText"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_log"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/size_32"
                    android:text="清空"
                    android:textSize="@dimen/text_11"
                    app:backgroundTint="?attr/colorSurfaceVariant"
                    android:textColor="?attr/colorControlTextSecondary"
                    app:cornerRadius="@dimen/radius_16"
                    android:textAllCaps="false"
                    android:layout_marginEnd="@dimen/space_8"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_toggle_log"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/size_32"
                    android:text="收起"
                    android:textSize="@dimen/text_11"
                    app:backgroundTint="?attr/colorSurfaceVariant"
                    android:textColor="?attr/colorControlTextSecondary"
                    app:cornerRadius="@dimen/radius_16"
                    android:textAllCaps="false"/>
            </LinearLayout>
            <ScrollView
                android:id="@+id/log_scroll"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_140">
                <TextView
                    android:id="@+id/log_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="@dimen/text_12"
                    android:fontFamily="monospace"
                    android:textColor="?attr/colorControlTextSecondary"
                    android:padding="@dimen/space_12"/>
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/transparent"
            android:elevation="@dimen/elev_8">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/attachment_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="@dimen/max_120"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:visibility="gone"/>

            <!-- 会话统计胶囊条（dsh StatsPills 风格）：输入框上方常驻，点击弹出明细 -->
            <com.oilquiz.app.ai.chat.ui.ChatStatsBar
                android:id="@+id/session_stats_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:visibility="visible"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_1"
                android:background="?attr/colorSurfaceVariant"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_8"
                android:gravity="center_vertical">

                <!-- 对话模式行：智能助手开关 + 深度思考开关（对齐官方：输入区顶部） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="4dp"
                    android:paddingBottom="@dimen/space_6">
                    <!-- 智能助手开关（最左）：开启后AI可用天气/时间/搜索/记忆等工具，即时生效 -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_local_agent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:text="智能助手"
                        android:checkable="true"
                        app:chipIcon="@drawable/ic_ai_agent"
                        app:chipIconSize="20dp"
                        app:chipIconTint="@color/chip_gray_text"
                        app:chipBackgroundColor="@color/chip_gray_bg"
                        android:textColor="?attr/colorControlTextSecondary"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/border_light"
                        app:checkedIconVisible="false"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_deep_think"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧠 深度思考"
                        android:checkable="true"
                        app:chipBackgroundColor="@color/chip_gray_bg"
                        android:textColor="?attr/colorControlTextSecondary"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/border_light"
                        app:checkedIconVisible="false"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_web_search"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:text="🔍 联网搜索"
                        android:checkable="false"
                        app:chipBackgroundColor="@color/chip_gray_bg"
                        android:textColor="?attr/colorControlTextSecondary"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/border_light"
                        app:checkedIconVisible="false"/>
                    <View
                        android:layout_width="@dimen/size_0"
                        android:layout_height="@dimen/size_1"
                        android:layout_weight="1"/>
                    <!-- 上下文占用仪表已并入 session_stats_bar（ContextMeter pill）——
                         原最右位置会被右侧工具抽屉覆盖，2026-09-23 移除 -->
                </LinearLayout>

                <!-- 发送队列条：忙时排队模式显示待发送消息，可一键清空 -->
                <LinearLayout
                    android:id="@+id/queue_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/system_message_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/tv_queue_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⏳ 排队中…"
                        android:textSize="12sp"
                        android:textColor="?attr/colorControlTextSecondary"/>
                    <TextView
                        android:id="@+id/btn_queue_cancel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="✕ 取消排队"
                        android:textSize="12sp"
                        android:textColor="?attr/colorPrimary"/>
                </LinearLayout>

                <com.oilquiz.app.ai.chat.input.ChatInputBar
                    android:id="@+id/chat_input_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>

    </LinearLayout>

    <!-- 右侧工具抽屉（模型/深度思考/快捷工具/管理 全部收敛于此） -->
    <FrameLayout
        android:id="@+id/tool_drawer"
        android:layout_width="@dimen/size_300"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="?attr/colorSurface"
        android:elevation="@dimen/elev_16">
        <include layout="@layout/view_tool_drawer"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/history_drawer"
        android:layout_width="@dimen/size_320"
        android:layout_height="match_parent"
        android:layout_gravity="left"
        android:background="?attr/colorSurface"
        android:elevation="@dimen/elev_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_16"
                android:background="?attr/colorSurfaceVariant">
                <TextView
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="对话历史"
                    android:textSize="@dimen/text_18"
                    android:textStyle="bold"
                    android:textColor="?attr/colorControlText"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_new_conversation"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/size_32"
                    android:text="＋ 新建"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    app:backgroundTint="?attr/colorPrimaryContainer"
                    app:cornerRadius="@dimen/radius_16"
                    android:textAllCaps="false"
                    android:layout_marginEnd="@dimen/space_8"
                    android:paddingHorizontal="10dp"
                    android:minWidth="@dimen/min_0"
                    android:contentDescription="新建对话"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_close_history"
                    android:layout_width="@dimen/size_36"
                    android:layout_height="@dimen/size_36"
                    app:backgroundTint="?attr/colorSurfaceVariant"
                    app:icon="@drawable/ic_clear"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:cornerRadius="@dimen/radius_18"
                    app:iconTint="?attr/colorControlText"
                    android:contentDescription="关闭"/>
            </LinearLayout>

            <TextView
                android:id="@+id/history_empty_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_0"
                android:layout_weight="1"
                android:gravity="center"
                android:text="暂无历史对话\n开始你的第一个对话吧"
                android:textSize="@dimen/text_14"
                android:textColor="?attr/colorControlTextSecondary"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/history_list"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_0"
                android:layout_weight="1"
                android:padding="@dimen/space_8"
                android:clipToPadding="false"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_all_history"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_44"
                android:layout_margin="@dimen/space_12"
                android:text="清空所有历史"
                android:textSize="@dimen/text_14"
