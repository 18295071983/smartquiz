<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.AIChatActivity">

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background">

        <!-- 自定义标题栏（极简：标题 + 右侧抽屉按钮） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:paddingHorizontal="8dp"
            android:elevation="0dp">
            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AI助手"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_marginEnd="4dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                style="@style/Widget.Material3.Button.IconButton"
                app:icon="@drawable/ic_toolbox"
                app:iconSize="22dp"
                app:iconTint="@color/text_primary"
                android:contentDescription="工具中心"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">
            <LinearLayout
                android:id="@+id/service_status_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:background="@drawable/status_bar_background"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <TextView
                    android:id="@+id/service_status_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏳"
                    android:textSize="16sp"
                    android:layout_marginEnd="6dp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/service_status_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/chat_service_not_initialized"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                    <TextView
                        android:id="@+id/model_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/chat_no_model_selected"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/service_status_progress"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="0.35"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:progress="0"
                    android:max="100"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/service_status_elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/tv_token_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔵 0 tokens"
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/weather_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/weather_banner_background"
            android:visibility="gone">

            <!-- 摘要行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/weather_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️"
                    android:textSize="28sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/weather_city"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="定位中..."
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/weather_banner_text" />

                        <TextView
                            android:id="@+id/weather_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--°C"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/weather_banner_text"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/weather_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="加载中..."
                        android:textSize="12sp"
                        android:textColor="@color/weather_banner_text_secondary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_weather_detail"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:backgroundTint="#33FFFFFF"
                    app:icon="@drawable/ic_expand_more"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:cornerRadius="16dp"
                    app:iconTint="@color/weather_banner_text"
                    app:iconSize="18dp"
                    android:contentDescription="天气详情" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_weather_refresh"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    app:backgroundTint="#33FFFFFF"
                    app:icon="@drawable/ic_refresh"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:cornerRadius="16dp"
                    app:iconTint="@color/weather_banner_text"
                    app:iconSize="16dp"
                    android:contentDescription="刷新天气" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_weather_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    app:backgroundTint="#33FFFFFF"
                    app:icon="@drawable/ic_clear"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:cornerRadius="16dp"
                    app:iconTint="@color/weather_banner_text"
                    app:iconSize="14dp"
                    android:contentDescription="关闭天气" />
            </LinearLayout>

            <!-- 详情区域（默认隐藏） -->
            <LinearLayout
                android:id="@+id/weather_detail_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#33FFFFFF"
                    android:layout_marginBottom="8dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:useDefaultMargins="true">

                    <TextView
                        android:id="@+id/weather_feels_like"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="体感温度: --°C"
                        android:textSize="12sp"
                        android:textColor="@color/weather_banner_text_secondary" />

                    <TextView
                        android:id="@+id/weather_humidity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="湿度: --%"
                        android:textSize="12sp"
                        android:textColor="@color/weather_banner_text_secondary" />

                    <TextView
                        android:id="@+id/weather_wind"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="风速: --"
                        android:textSize="12sp"
                        android:textColor="@color/weather_banner_text_secondary" />

                    <TextView
                        android:id="@+id/weather_wind_dir"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="风向: --"
                        android:textSize="12sp"
                        android:textColor="@color/weather_banner_text_secondary" />

                    <TextView
                        android:id="@+id/weather_visibility"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="能见度: -- km"
                        android:textSize="12sp"
                        android:textColor="@color/weather_banner_text_secondary" />

                    <TextView
                        android:id="@+id/weather_pressure"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="气压: -- hPa"
                        android:textSize="12sp"
                        android:textColor="@color/weather_banner_text_secondary" />
                </GridLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/message_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp"
                    android:clipToPadding="false"/>

                <!-- 空状态视图 -->
                <LinearLayout
                    android:id="@+id/empty_state_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖"
                    android:textSize="64sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开始你的AI对话"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="输入消息开始对话，或尝试以下快捷命令："
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_marginBottom="24dp"/>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/empty_state_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_empty_example1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="帮我总结这段文字"
                        app:chipBackgroundColor="@color/surface_variant"
                        android:textColor="@color/text_primary"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_empty_example2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="解释这段代码"
                        app:chipBackgroundColor="@color/surface_variant"
                        android:textColor="@color/text_primary"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_empty_example3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="今天天气如何"
                        app:chipBackgroundColor="@color/surface_variant"
                        android:textColor="@color/text_primary"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_clear_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清空"
                app:chipIcon="@drawable/ic_clear"
                app:chipIconTint="@color/error"
                app:chipBackgroundColor="@color/error_container"
                android:textColor="@color/on_error_container"
                app:chipStrokeWidth="0dp"/>

        </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </FrameLayout>
        </LinearLayout>

        <View
            android:id="@+id/thinking_indicator"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@drawable/gradient_primary"
            android:visibility="gone"/>


        <LinearLayout
            android:id="@+id/log_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="处理日志"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_log"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="清空"
                    android:textSize="11sp"
                    app:backgroundTint="@color/surface_variant"
                    android:textColor="@color/text_secondary"
                    app:cornerRadius="16dp"
                    android:textAllCaps="false"
                    android:layout_marginEnd="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_toggle_log"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="收起"
                    android:textSize="11sp"
                    app:backgroundTint="@color/surface_variant"
                    android:textColor="@color/text_secondary"
                    app:cornerRadius="16dp"
                    android:textAllCaps="false"/>
            </LinearLayout>
            <ScrollView
                android:id="@+id/log_scroll"
                android:layout_width="match_parent"
                android:layout_height="140dp">
                <TextView
                    android:id="@+id/log_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:padding="12dp"/>
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:elevation="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/attachment_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="120dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:visibility="gone"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/surface_variant"/>

            <!-- 语音输入录音状态横幅 -->
            <LinearLayout
                android:id="@+id/voice_recording_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="#14E53935"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_voice_recording_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="#E53935"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tv_voice_recording_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textStyle="bold"
                    android:textColor="#E53935"
                    android:textSize="13sp"
                    android:layout_marginStart="8dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="正在录音，点击 🎤 按钮结束并识别"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:background="@drawable/rounded_edittext"
                    android:gravity="center_vertical"
                    android:padding="4dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_attach"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        style="@style/Widget.Material3.Button.TextButton"
                        app:icon="@drawable/ic_attachment"
                        app:iconSize="22dp"
                        app:iconTint="@color/text_secondary"
                        android:contentDescription="附加"
                        android:layout_marginStart="4dp"/>
                    <EditText
                        android:id="@+id/input_message"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="输入消息..."
                        android:padding="12dp"
                        android:background="@android:color/transparent"
                        android:maxLines="5"
                        android:inputType="textMultiLine"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:layout_marginHorizontal="8dp"/>

                    <!-- 语音输入按钮：点击开始录音，再次点击结束并识别为文字 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_voice"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:text="🎤"
                        android:textSize="20sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:iconPadding="0dp"
                        android:contentDescription="语音输入"
                        android:layout_marginEnd="4dp"/>

                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="24dp"
                    style="@style/Widget.Material3.Button.IconButton"
                    app:icon="@drawable/ic_send_message"
                    app:iconSize="22dp"
                    app:iconTint="@color/on_primary"
                    android:contentDescription="发送"/>

                <!-- 停止按钮：生成时与发送按钮切换显示（同位置） -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_stop_generation"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:text="@string/chat_stop"
                    android:textSize="12sp"
                    android:textColor="@color/on_error"
                    app:backgroundTint="@color/error"
                    app:cornerRadius="24dp"
                    android:textAllCaps="false"
                    android:contentDescription="停止生成"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- 右侧工具抽屉（模型/深度思考/快捷工具/管理 全部收敛于此） -->
    <FrameLayout
        android:id="@+id/tool_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="@color/surface"
        android:elevation="16dp">
        <include layout="@layout/view_tool_drawer"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/history_drawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="left"
        android:background="@color/surface"
        android:elevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@color/surface_variant">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="对话历史"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_new_conversation"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="＋ 新建"
                    android:textSize="12sp"
                    android:textColor="@color/on_primary_container"
                    app:backgroundTint="@color/primary_container"
                    app:cornerRadius="16dp"
                    android:textAllCaps="false"
                    android:layout_marginEnd="8dp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp"
                    android:contentDescription="新建对话"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_close_history"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:backgroundTint="@color/surface_variant"
                    app:icon="@drawable/ic_clear"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:cornerRadius="18dp"
                    app:iconTint="@color/text_primary"
                    android:contentDescription="关闭"/>
            </LinearLayout>

            <TextView
                android:id="@+id/history_empty_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="暂无历史对话\n开始你的第一个对话吧"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/history_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="8dp"
                android:clipToPadding="false"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_all_history"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_margin="12dp"
                android:text="清空所有历史"
                android:textSize="14sp"
                app:backgroundTint="@color/error"
                android:textColor="@color/on_error"
                app:cornerRadius="22dp"
                android:textAllCaps="false"/>
        </LinearLayout>
    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>
