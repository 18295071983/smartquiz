<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_8"
    app:cardElevation="4dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="?attr/colorCardBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <!-- 头部：状态指示 + 名称 + 类型标签 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/status_indicator"
                android:layout_width="@dimen/size_10"
                android:layout_height="@dimen/size_10"
                android:layout_marginEnd="@dimen/space_10"
                android:background="@drawable/status_indicator_unknown"/>

            <TextView
                android:id="@+id/tv_api_name"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/text_16"
                android:textStyle="bold"
                android:textColor="?attr/colorControlText"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tv_service_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_11"
                android:textColor="@android:color/white"
                android:background="@drawable/badge_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginStart="@dimen/space_8"/>
        </LinearLayout>

        <!-- 模型名称 -->
        <LinearLayout
            android:id="@+id/ll_model_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/space_10"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已选模型："
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlTextHint"/>

            <TextView
                android:id="@+id/tv_model_name"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/text_13"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- API Key 掩码 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/space_8">

            <ImageView
                android:layout_width="@dimen/size_16"
                android:layout_height="@dimen/size_16"
                android:src="@android:drawable/ic_lock_lock"
                android:alpha="0.5"
                android:layout_marginEnd="@dimen/space_8"/>

            <TextView
                android:id="@+id/tv_api_key"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlTextSecondary"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="middle"/>
        </LinearLayout>

        <!-- API Host -->
        <LinearLayout
            android:id="@+id/ll_api_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/space_4"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/size_16"
                android:layout_height="@dimen/size_16"
                android:src="@android:drawable/ic_menu_mapmode"
                android:alpha="0.5"
                android:layout_marginEnd="@dimen/space_8"/>

            <TextView
                android:id="@+id/tv_api_host"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlTextHint"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_1"
            android:background="?attr/colorOutline"
            android:layout_marginVertical="@dimen/space_12"
            android:alpha="0.3"/>

        <!-- 使用量进度条 -->
        <LinearLayout
            android:id="@+id/ll_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/space_8"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="使用量"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorControlTextHint"/>

                <View
                    android:layout_width="@dimen/size_0"
                    android:layout_height="@dimen/size_0"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tv_usage_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="@dimen/text_11"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"/>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pb_usage"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_6"
                android:layout_marginTop="@dimen/space_4"
                android:max="100"
                android:progress="0"
                android:progressTint="?attr/colorPrimary"/>

            <TextView
                android:id="@+id/tv_usage_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已用: 0 / 总量: 未知"
                android:textSize="@dimen/text_11"
                android:textColor="?attr/colorControlTextHint"
                android:layout_marginTop="@dimen/space_2"/>
        </LinearLayout>

        <!-- 状态行：状态 + 延迟 + 使用次数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlTextSecondary"/>

            <TextView
                android:id="@+id/tv_latency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_12"
                android:textColor="@color/success_color"
                android:layout_marginStart="@dimen/space_8"
                android:visibility="gone"/>

            <View
                android:layout_width="@dimen/size_0"
                android:layout_height="@dimen/size_0"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tv_usage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlTextHint"/>
        </LinearLayout>

        <!-- 最后使用时间 -->
        <TextView
            android:id="@+id/tv_last_used"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_11"
            android:textColor="?attr/colorControlTextHint"
            android:layout_marginTop="@dimen/space_2"
            android:visibility="gone"/>

        <!-- 操作按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/space_12">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_test"
                android:layout_width="@dimen/size_0"
                android:layout_height="@dimen/size_40"
                android:layout_weight="1"
                android:text="测试"
                android:textSize="@dimen/text_12"
                android:textAllCaps="false"
                app:backgroundTint="?attr/colorSecondary"
                android:textColor="@android:color/white"
                app:cornerRadius="@dimen/radius_10"
                android:layout_marginEnd="@dimen/space_6"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit"
                android:layout_width="@dimen/size_0"
                android:layout_height="@dimen/size_40"
                android:layout_weight="1"
                android:text="编辑"
                android:textSize="@dimen/text_12"
                android:textAllCaps="false"
                app:backgroundTint="?attr/colorPrimary"
                android:textColor="@android:color/white"
                app:cornerRadius="@dimen/radius_10"
                android:layout_marginHorizontal="@dimen/space_6"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete"
                android:layout_width="@dimen/size_0"
                android:layout_height="@dimen/size_40"
                android:layout_weight="1"
                android:text="删除"
                android:textSize="@dimen/text_12"
                android:textAllCaps="false"
                app:backgroundTint="@color/error_color"
                android:textColor="@android:color/white"
                app:cornerRadius="@dimen/radius_10"
                android:layout_marginStart="@dimen/space_6"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>