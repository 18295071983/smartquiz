<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black">

    <!-- 顶部状态栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#111111">

        <TextView
            android:id="@+id/ssh_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SSH 终端 · 本机 Termux (127.0.0.1:8022)"
            android:textColor="#4FC3F7"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/ssh_disconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="断开/重连"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- 完整终端模拟器（Termux terminal-view） -->
    <com.termux.view.TerminalView
        android:id="@+id/ssh_term_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusable="true"
        android:focusableInTouchMode="true"/>

    <!-- 底部常用操作栏（手机键盘没有的键） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="3dp"
        android:background="#1A1A1A">

        <Button
            android:id="@+id/ssh_esc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:padding="0dp"
            android:text="Esc"
            android:textSize="13sp"
            android:minHeight="32dp"/>

        <Button
            android:id="@+id/ssh_tab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:padding="0dp"
            android:text="Tab"
            android:textSize="13sp"
            android:minHeight="32dp"/>

        <Button
            android:id="@+id/ssh_ctrl_c"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:padding="0dp"
            android:text="Ctrl+C"
            android:textSize="13sp"
            android:minHeight="32dp"/>

        <Button
            android:id="@+id/ssh_ctrl_d"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:padding="0dp"
            android:text="Ctrl+D"
            android:textSize="13sp"
            android:minHeight="32dp"/>

        <Button
            android:id="@+id/ssh_up"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:padding="0dp"
            android:text="↑"
            android:textSize="15sp"
            android:minHeight="32dp"/>

        <Button
            android:id="@+id/ssh_down"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:padding="0dp"
            android:text="↓"
            android:textSize="15sp"
            android:minHeight="32dp"/>

        <Button
            android:id="@+id/ssh_enter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:padding="0dp"
            android:text="Enter"
            android:textSize="13sp"
            android:minHeight="32dp"/>
    </LinearLayout>

    <!-- 连接参数行：自动带出，也可手动改 -->
    <LinearLayout
        android:id="@+id/ssh_param_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="#1A1A1A"
        android:visibility="gone">

        <EditText
            android:id="@+id/ssh_user"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:hint="用户名（如 u0_a444）"
            android:inputType="text"
            android:textColor="#E0E0E0"
            android:textColorHint="#888888"
            android:textSize="15sp"
            android:fontFamily="monospace"
            android:background="@android:drawable/editbox_background"/>

        <EditText
            android:id="@+id/ssh_pass"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:hint="密码"
            android:inputType="textPassword"
            android:textColor="#E0E0E0"
            android:textColorHint="#888888"
            android:textSize="15sp"
            android:fontFamily="monospace"
            android:background="@android:drawable/editbox_background"/>

        <Button
            android:id="@+id/ssh_connect"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:text="连接"
            android:textSize="15sp"/>
    </LinearLayout>
</LinearLayout>
