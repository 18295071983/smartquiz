<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground"
    tools:context=".ui.activity.ModelImportActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/elev_0">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:title="模型导入"
            app:titleTextColor="?attr/colorOnSurface"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:fillViewport="true">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">
            
            <!-- 欢迎卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="@dimen/space_20">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_20">
                    
                    <ImageView
                        android:layout_width="@dimen/size_48"
                        android:layout_height="@dimen/size_48"
                        android:src="@drawable/ic_analyze"
                        android:tint="?attr/colorOnPrimaryContainer"
                        android:layout_marginEnd="@dimen/space_16" />
                    
                    <LinearLayout
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI模型导入"
                            android:textSize="@dimen/text_18"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:layout_marginBottom="@dimen/space_4" />
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="导入自定义AI模型"
                            android:textSize="@dimen/text_14"
                            android:textColor="?attr/colorOnPrimaryContainer" />
                        
                    </LinearLayout>
                    
                </LinearLayout>
                
            </com.google.android.material.card.MaterialCardView>
            
            <!-- 模型选择 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="@dimen/space_20">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="选择模型文件"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="@dimen/space_16" />
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_select_model"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_48"
                        android:text="选择模型文件"
                        android:textSize="@dimen/text_14"
                        android:textStyle="bold"
                        app:backgroundTint="?attr/colorPrimary"
                        android:textColor="?attr/colorOnPrimary"
                        app:cornerRadius="@dimen/radius_12"
                        android:textAllCaps="false"
                        android:layout_marginBottom="@dimen/space_16" />
                        
                    <TextView
                        android:id="@+id/tv_model_path"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="未选择文件"
                        android:textSize="@dimen/text_14"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="@dimen/space_16" />
                        
                </LinearLayout>
                
            </com.google.android.material.card.MaterialCardView>
            
            <!-- 模型下载快捷方式 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="@dimen/space_20">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_16">
                    
                    <ImageView
                        android:layout_width="@dimen/size_40"
                        android:layout_height="@dimen/size_40"
                        android:src="@drawable/ic_ai_download"
                        android:tint="?attr/colorOnSecondaryContainer"
                        android:layout_marginEnd="@dimen/space_16" />
                    
                    <LinearLayout
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="没有本地模型？"
                            android:textSize="@dimen/text_15"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:layout_marginBottom="@dimen/space_2" />
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="在线下载预训练模型"
                            android:textSize="@dimen/text_13"
                            android:textColor="?attr/colorOnSecondaryContainer" />
                        
                    </LinearLayout>
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_go_download"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/size_40"
                        android:text="去下载"
                        android:textSize="@dimen/text_13"
                        android:textStyle="bold"
                        app:backgroundTint="?attr/colorSecondary"
                        android:textColor="?attr/colorOnSecondary"
                        app:cornerRadius="@dimen/radius_20"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_download"
                        app:iconSize="16dp"
                        app:iconPadding="4dp" />
                    
                </LinearLayout>
                
            </com.google.android.material.card.MaterialCardView>
            
        </LinearLayout>
        
    </ScrollView>

    <!-- 底部操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16"
        android:background="?attr/colorSurface"
        android:elevation="@dimen/elev_8">
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_import_model"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_56"
            android:text="导入模型"
            android:textSize="@dimen/text_16"
            android:textStyle="bold"
            app:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false" />
            
    </LinearLayout>
    
    <!-- 导入进度容器 -->
    <LinearLayout
        android:id="@+id/progress_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/space_16"
        android:visibility="gone">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="导入进度"
            android:textSize="@dimen/text_18"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="@dimen/space_16" />
            
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="@dimen/space_16">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                
                <TextView
                    android:id="@+id/tv_import_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="正在导入模型..."
                    android:textSize="@dimen/text_16"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="@dimen/space_12" />
                    
                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressDrawable="@drawable/progress_bar_primary"
                    android:max="100"
                    android:progress="0" />
                    
                <TextView
                    android:id="@+id/tv_progress_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="@dimen/text_14"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/space_8" />
                    
            </LinearLayout>
            
        </com.google.android.material.card.MaterialCardView>
        
    </LinearLayout>

    <!-- 导入结果容器 -->
    <LinearLayout
        android:id="@+id/result_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/space_16"
        android:visibility="gone">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="导入结果"
            android:textSize="@dimen/text_18"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="@dimen/space_16" />
            
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="@dimen/space_16">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                
                <TextView
                    android:id="@+id/tv_import_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="导入状态: 成功"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="@dimen/space_8" />
                    
                <TextView
                    android:id="@+id/tv_import_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="模型导入成功，已添加到模型列表"
                    android:textSize="@dimen/text_14"
                    android:textColor="?attr/colorOnSurfaceVariant" />
                    
            </LinearLayout>
            
        </com.google.android.material.card.MaterialCardView>
        
    </LinearLayout>

    <!-- 操作按钮容器 -->
    <LinearLayout
        android:id="@+id/actions_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_16"
        android:background="?attr/colorSurface"
        android:elevation="@dimen/elev_8"
        android:visibility="gone">
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_models"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_48"
            android:layout_weight="1"
            android:text="查看模型"
            android:textSize="@dimen/text_14"
            android:textStyle="bold"
            app:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false"
            android:layout_marginEnd="@dimen/space_8" />
            
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_import_another"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_48"
            android:layout_weight="1"
            android:text="导入另一个"
            android:textSize="@dimen/text_14"
            android:textStyle="bold"
            app:backgroundTint="?attr/colorSecondary"
            android:textColor="?attr/colorOnSecondary"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false" />
            
    </LinearLayout>

</LinearLayout>
