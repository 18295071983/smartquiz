<?xml version="1.0" encoding="utf-8"?>
<!-- AI 导入题库页面：单列可滚动布局，精简卡片层级 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground"
    tools:context=".ui.activity.AIImportActivity">

    <!-- 顶部工具栏 -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/elev_0">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:title="AI 导入题库"
            app:titleTextColor="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 内容区：可滚动，避免小屏溢出 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- 文件选择区 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectFile"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_48"
                        android:text="选择题库文件"
                        app:backgroundTint="?attr/colorPrimary"
                        android:textColor="?attr/colorOnPrimary"
                        app:cornerRadius="@dimen/radius_12"
                        android:textAllCaps="false" />

                    <TextView
                        android:id="@+id/tvFileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="尚未选择文件"
                        android:textSize="@dimen/text_13"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:singleLine="true"
                        android:ellipsize="middle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/space_12">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancel"
                            android:layout_width="@dimen/size_0"
                            android:layout_height="@dimen/size_48"
                            android:layout_weight="1"
                            android:text="取消"
                            android:singleLine="true"
                            app:backgroundTint="?attr/colorSecondary"
                            android:textColor="?attr/colorOnSecondary"
                            app:cornerRadius="@dimen/radius_12"
                            android:textAllCaps="false"
                            android:paddingStart="@dimen/space_8"
                            android:paddingEnd="@dimen/space_8"
                            android:layout_marginEnd="@dimen/space_8" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartImport"
                            android:layout_width="@dimen/size_0"
                            android:layout_height="@dimen/size_48"
                            android:layout_weight="1"
                            android:text="智能导入"
                            android:singleLine="true"
                            app:backgroundTint="?attr/colorPrimary"
                            android:textColor="?attr/colorOnPrimary"
                            app:cornerRadius="@dimen/radius_12"
                            android:textAllCaps="false"
                            android:paddingStart="@dimen/space_8"
                            android:paddingEnd="@dimen/space_8" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAgentImport"
                            android:layout_width="@dimen/size_0"
                            android:layout_height="@dimen/size_48"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="🤖智能体"
                            android:singleLine="true"
                            app:backgroundTint="?attr/colorTertiary"
                            android:textColor="?attr/colorOnTertiary"
                            app:cornerRadius="@dimen/radius_12"
                            android:textAllCaps="false"
                            android:paddingStart="@dimen/space_8"
                            android:paddingEnd="@dimen/space_8" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 模型选择区（紧凑单行） -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="1dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="@dimen/space_12">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🤖 AI 模型"
                            android:textSize="@dimen/text_14"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvModelInfo"
                            android:layout_width="@dimen/size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="自动选择"
                            android:textSize="@dimen/text_12"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginStart="@dimen/space_8"
                            android:layout_marginEnd="@dimen/space_8"
                            android:singleLine="true"
                            android:ellipsize="end" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSwitchModel"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/size_36"
                            android:text="切换"
                            android:textSize="@dimen/text_12"
                            app:backgroundTint="?attr/colorSecondary"
                            android:textColor="?attr/colorOnSecondary"
                            app:cornerRadius="@dimen/radius_8"
                            android:textAllCaps="false"
                            android:paddingStart="@dimen/space_12"
                            android:paddingEnd="@dimen/space_12" />
                    </LinearLayout>

                    <!-- 在线模型配置入口（仅在线模式显示） -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConfigOnline"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_36"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_marginEnd="@dimen/space_12"
                        android:layout_marginBottom="@dimen/space_10"
                        android:text="配置在线模型"
                        android:textSize="@dimen/text_12"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:cornerRadius="@dimen/radius_8"
                        android:textAllCaps="false"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 题库说明输入区（可选）：用户引导 AI 导入，如字段约定/特殊规则 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="1dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📝 题库说明（可选）"
                        android:textSize="@dimen/text_14"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="填写字段约定或特殊规则，AI 导入时参考，识别列含义更准。"
                        android:textSize="@dimen/text_11"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/space_8">

                        <EditText
                            android:id="@+id/etUserGuide"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minLines="2"
                            android:maxLines="5"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:background="@drawable/ai_import_input_bg"
                            android:padding="@dimen/space_10"
                            android:textSize="@dimen/text_13"
                            android:textColor="?attr/colorOnSurface"
                            android:hint="例：题干列叫「题目内容」，选项用分号分隔，答案在最后一列，题型是单选题…"
                            android:importantForAutofill="no" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAgentMic"
                            android:layout_width="@dimen/size_48"
                            android:layout_height="@dimen/size_48"
                            android:layout_marginStart="@dimen/space_8"
                            style="@style/Widget.Material3.Button.TextButton"
                            app:icon="@drawable/ic_mic"
                            app:iconSize="22dp"
                            app:iconTint="?attr/colorPrimary"
                            app:cornerRadius="@dimen/radius_12"
                            app:backgroundTint="?attr/colorSurfaceVariant"
                            android:contentDescription="语音指令智能体" />
                    </LinearLayout>

                    <!-- 缺失字段智能填充开关：默认开启，关闭后缺失字段留空直接入库 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/space_8">

                        <LinearLayout
                            android:layout_width="@dimen/size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="缺失字段智能填充"
                                android:textSize="@dimen/text_13"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="用 AI 补全缺失的题型/难度/分类/解析"
                                android:textSize="@dimen/text_11"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swFillMissing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <!-- 推理后端开关：默认 CPU（KV 走系统内存，上下文放大到 8192，避开 GPU 崩溃坑），
                         关闭可改回 GPU；切换下次导入生效 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/space_8">

                        <LinearLayout
                            android:layout_width="@dimen/size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CPU 推理（上下文 8192）"
                                android:textSize="@dimen/text_13"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="默认开启：切换立即生效（应用内热切换，无需重启）"
                                android:textSize="@dimen/text_11"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swCpuInference"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 阶段指示：4 步（检测→映射→解析→入库），ChatKit GuideStepFlowView 组件 -->
            <com.oilquiz.app.ai.chat.ui.GuideStepFlowView
                android:id="@+id/guideStepFlow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12" />


            <!-- 实时监控：耗时 / 步骤 / 推理速度 / Token -->
            <LinearLayout
                android:id="@+id/monitorBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/ai_import_input_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:layout_marginBottom="@dimen/space_12">

                <LinearLayout
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvMonitorElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textSize="@dimen/text_15"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="耗时"
                        android:textSize="@dimen/text_12"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvMonitorStage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="等待"
                        android:textSize="@dimen/text_13"
                        android:textStyle="bold"
                        android:textColor="?attr/colorSecondary"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="步骤"
                        android:textSize="@dimen/text_12"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvMonitorSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="@dimen/text_15"
                        android:textStyle="bold"
                        android:textColor="@color/success" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="推理 t/s"
                        android:textSize="@dimen/text_12"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvMonitorTokens"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="@dimen/text_15"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Token"
                        android:textSize="@dimen/text_12"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

            <!-- Agent 执行区：内嵌 AgentExecutionView，初始隐藏 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="@dimen/space_12">

                <com.oilquiz.app.ai.chat.AgentExecutionView
                    android:id="@+id/agentView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 智能体会话区：AgentSessionView 内嵌容器，初始隐藏 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/agentSessionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/space_12">

                <FrameLayout
                    android:id="@+id/agentSessionContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 结果统计区：初始隐藏，导入中显示进度、完成后显示数字 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/statsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <!-- 进度行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/space_12">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="进度"
                            android:textSize="@dimen/text_13"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvProgress"
                            android:layout_width="@dimen/size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0/0"
                            android:textSize="@dimen/text_14"
                            android:textStyle="bold"
                            android:textColor="?attr/colorSecondary"
                            android:layout_marginStart="@dimen/space_8"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- 统计数字行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="@dimen/size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvSuccessCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="@dimen/text_20"
                                android:textStyle="bold"
                                android:textColor="@color/success" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="成功"
                                android:textSize="@dimen/text_12"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="@dimen/size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvFailedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="@dimen/text_20"
                                android:textStyle="bold"
                                android:textColor="@color/error" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="失败"
                                android:textSize="@dimen/text_12"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="@dimen/size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvTotalCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="@dimen/text_20"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="总计"
                                android:textSize="@dimen/text_12"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="@dimen/size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvDupCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="@dimen/text_20"
                                android:textStyle="bold"
                                android:textColor="?attr/colorSecondary" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="重复"
                                android:textSize="@dimen/text_12"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
