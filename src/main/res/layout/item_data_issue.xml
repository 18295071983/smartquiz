<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_16"
    android:background="?attr/colorSurface"
    android:elevation="@dimen/elev_2"
    android:layout_marginBottom="@dimen/space_8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_12">
        <ImageView
            android:id="@+id/issueTypeIcon"
            android:layout_width="@dimen/size_24"
            android:layout_height="@dimen/size_24"
            android:src="@drawable/ic_info"
            android:tint="?attr/colorPrimary"
            android:layout_marginEnd="@dimen/space_12"/>
        <TextView
            android:id="@+id/issueRowNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="行 1"
            android:textSize="@dimen/text_14"
            android:textColor="?attr/colorControlTextSecondary"
            android:layout_marginEnd="@dimen/space_12"/>
        <TextView
            android:id="@+id/issueDescription"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="问题描述"
            android:textSize="@dimen/text_16"
            android:textColor="?attr/colorOnSurface"/>
        <ImageView
            android:id="@+id/issueStatusIcon"
            android:layout_width="@dimen/size_24"
            android:layout_height="@dimen/size_24"
            android:src="@drawable/ic_info"
            android:tint="?attr/colorControlTextSecondary"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/inputArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="@dimen/space_12">
        <TextView
            android:id="@+id/inputLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="输入值"
            android:textSize="@dimen/text_14"
            android:textColor="?attr/colorControlTextSecondary"
            android:layout_marginBottom="@dimen/space_8"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/spinnerInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <AutoCompleteTextView
                android:id="@+id/spinnerAutoComplete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:hint="选择或输入值"
                android:completionThreshold="0"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSkip"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_36"
            android:text="跳过"
            app:backgroundTint="?attr/colorSecondary"
            android:textColor="@android:color/white"
            android:layout_marginEnd="@dimen/space_8"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonApply"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_36"
            android:text="应用"
            app:backgroundTint="?attr/colorPrimary"
            android:textColor="@android:color/white"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false"/>
    </LinearLayout>

</LinearLayout>