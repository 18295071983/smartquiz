<?xml version="1.0" encoding="utf-8"?>
<!-- 聊天页 v2 空状态「最近」行（demo .ritem）：时钟 + 会话名 + 相对时间。
     由 AIChatActivity 在开关打开时按现有历史数据逐条 inflate 到 chat_v2_recent_container。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/size_40"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_6"
    android:paddingEnd="@dimen/space_6"
    android:paddingTop="@dimen/space_8"
    android:paddingBottom="@dimen/space_8">

    <ImageView
        android:layout_width="@dimen/chat_v2_line_icon"
        android:layout_height="@dimen/chat_v2_line_icon"
        android:contentDescription="@string/chat_v2_history_desc"
        android:src="@drawable/ic_history"
        app:tint="@color/chat_v2_text_3"/>

    <TextView
        android:id="@+id/chat_v2_recent_name"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_10"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/chat_v2_text"
        android:textSize="@dimen/chat_v2_recent_text"/>

    <TextView
        android:id="@+id/chat_v2_recent_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_10"
        android:textColor="@color/chat_v2_text_3"
        android:textSize="@dimen/chat_v2_subline_text"/>
</LinearLayout>
