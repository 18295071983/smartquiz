<?xml version="1.0" encoding="utf-8"?>
<!--
  完整 Python 环境（Termux + Ubuntu）一键准备。
  入口：工具集 → 设置与数据 → 完整 Python 环境。
  结构：页面头 → 环境状态卡（含手动刷新）→ 三步操作卡（步骤徽章）→ 运行日志卡。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <!-- 页面头 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/space_16">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐍 完整 Python 环境"
                android:textSize="@dimen/text_22"
                android:textStyle="bold"
                android:textColor="?attr/colorControlText"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Termux + Ubuntu 一键部署 · 装好即可让 AI 调用真实 Linux 环境"
                android:textSize="@dimen/text_13"
                android:textColor="?attr/colorControlTextSecondary"/>
        </LinearLayout>

        <!-- ① 环境状态卡 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardElevation="3dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="?attr/colorCardBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="环境检查"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_refresh"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="刷新状态"
                        app:icon="@drawable/ic_refresh"
                        app:iconSize="20dp"
                        app:iconTint="?attr/colorPrimary"
                        app:iconGravity="textStart"
                        app:backgroundTint="?attr/colorPrimaryContainer"
                        app:cornerRadius="20dp"
                        app:strokeWidth="0dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_12"
                    android:layout_marginBottom="@dimen/space_12"
                    android:background="?attr/colorControlTextHint"
                    android:alpha="0.15"/>

                <TextView
                    android:id="@+id/env_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:textSize="@dimen/text_13"
                    android:textColor="?attr/colorControlTextSecondary"
                    android:text="检查中…"/>

                <!-- 异签名 Termux 引导（P2-7）：已装版与内置包签名不一致时明示，默认隐藏
                     注意：不要用 ?attr/colorErrorContainer —— 本项目主题未定义该属性，inflate 会抛
                     UnsupportedOperationException（真机踩过，TermuxEnvSetupActivity 直接闪退） -->
                <TextView
                    android:id="@+id/tv_signer_warn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:padding="@dimen/space_8"
                    android:lineSpacingExtra="3dp"
                    android:textSize="@dimen/text_12"
                    android:textStyle="bold"
                    android:textColor="#F5A623"
                    android:visibility="gone"
                    android:text="⚠️ 已装 Termux 与内置包签名不一致：点「安装 Termux」会被系统拒绝覆盖安装。推荐继续用现有 Termux（去点「自检并修复通道」，粘一行命令即可）；若想换成内置版，需先卸载旧 Termux（会清空已有容器环境）再装一次。"/>

                <!-- 首次打开 Termux 初始化引导（P0-2）：刚装上且还没授权 RUN_COMMAND 时明示，默认隐藏 -->
                <TextView
                    android:id="@+id/tv_first_init_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="?attr/colorPrimaryContainer"
                    android:padding="@dimen/space_8"
                    android:lineSpacingExtra="3dp"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:visibility="gone"
                    android:text="ℹ️ 首次打开 Termux 会自动初始化（下载基础包）：请等到出现命令行提示符 $ 再继续。初始化没完成时粘贴命令会报 command not found，容易误判成脚本坏了。"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="· 进入页面或点右上角刷新，自动重新检测"
                    android:textSize="@dimen/text_11"
                    android:textColor="?attr/colorControlTextHint"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ② 三步操作卡 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardElevation="3dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="?attr/colorCardBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <!-- 步骤 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="@dimen/space_12"
                        android:gravity="center"
                        android:background="@drawable/bg_step_badge"
                        android:text="1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="安装 Termux"
                            android:textSize="@dimen/text_15"
                            android:textStyle="bold"
                            android:textColor="?attr/colorControlText"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="内置官方包 108.6MB，系统会弹一次安装确认"
                            android:textSize="@dimen/text_12"
                            android:textColor="?attr/colorControlTextSecondary"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_install_termux"
                        app:icon="@drawable/ic_ai_download"
                        app:iconTint="?attr/colorOnPrimary"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconPadding="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/size_44"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="安装 Termux"
                            android:textSize="@dimen/text_14"
                            android:textAllCaps="false"
                            android:textColor="?attr/colorOnPrimary"
                            app:backgroundTint="?attr/colorPrimary"
                            app:cornerRadius="@dimen/radius_22"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginBottom="@dimen/space_16"
                    android:background="?attr/colorControlTextHint"
                    android:alpha="0.15"/>

                <!-- 步骤 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="@dimen/space_12"
                        android:gravity="center"
                        android:background="@drawable/bg_step_badge"
                        android:text="2"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="导出 Ubuntu 根文件系统"
                            android:textSize="@dimen/text_15"
                            android:textStyle="bold"
                            android:textColor="?attr/colorControlText"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="28.5MB 内置包 → Download/OilQuiz/termux_env/"
                            android:textSize="@dimen/text_12"
                            android:textColor="?attr/colorControlTextSecondary"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_export_rootfs"
                        app:icon="@drawable/ic_export"
                        app:iconTint="?attr/colorOnPrimary"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconPadding="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/size_44"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="导出 Ubuntu 根文件系统（28.5 MB）"
                            android:textSize="@dimen/text_14"
                            android:textAllCaps="false"
                            android:textColor="?attr/colorOnPrimary"
                            app:backgroundTint="?attr/colorPrimary"
                            app:cornerRadius="@dimen/radius_22"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginBottom="@dimen/space_16"
                    android:background="?attr/colorControlTextHint"
                    android:alpha="0.15"/>

                <!-- 步骤 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="@dimen/space_12"
                        android:gravity="center"
                        android:background="@drawable/bg_step_badge"
                        android:text="3"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="一键准备完整 Python 环境"
                            android:textSize="@dimen/text_15"
                            android:textStyle="bold"
                            android:textColor="?attr/colorControlText"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="在 Termux 里跑准备脚本，约 3~6 分钟，全程可见进度"
                            android:textSize="@dimen/text_12"
                            android:textColor="?attr/colorControlTextSecondary"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_run_setup"
                        app:icon="@drawable/ic_ai_tool"
                        app:iconTint="?attr/colorOnPrimary"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconPadding="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/size_44"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="一键准备（自动执行）"
                            android:textSize="@dimen/text_14"
                            android:textAllCaps="false"
                            android:textColor="?attr/colorOnPrimary"
                            app:backgroundTint="?attr/colorPrimary"
                            app:cornerRadius="@dimen/radius_22"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_open_vnc"
                        app:icon="@drawable/ic_ai_connect"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconPadding="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/size_44"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="🖥️ 启动图形界面（VNC 桌面）"
                            android:textSize="@dimen/text_13"
                            android:textAllCaps="false"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            app:backgroundTint="?attr/colorSecondaryContainer"
                            app:cornerRadius="@dimen/radius_22"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginBottom="@dimen/space_16"
                    android:background="?attr/colorControlTextHint"
                    android:alpha="0.15"/>

                <!-- 智能引导：唯一主入口（其余高级功能收进"更多工具"） -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_smart_guide"
                    app:icon="@drawable/ic_ai_tool"
                    app:iconTint="?attr/colorOnPrimary"
                    app:iconGravity="textStart"
                    app:iconSize="22dp"
                    app:iconPadding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="🔍 智能检测引导 —— 粘贴一行，之后全自动"
                    android:textSize="@dimen/text_14"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnPrimary"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="@dimen/radius_22"/>

                <!-- 动态辅助按钮：按当前缺失项自动变化，点一下自动复制/执行，不用手输命令 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_aux_fix"
                    app:icon="@drawable/ic_ai_warning"
                    app:iconTint="?attr/colorOnPrimary"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconPadding="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_44"
                    android:layout_marginTop="@dimen/space_8"
                    android:text=""
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnPrimary"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="@dimen/radius_22"
                    android:visibility="gone"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_toggle_more"
                    app:icon="@drawable/ic_settings"
                    app:iconTint="?attr/colorOnSecondaryContainer"
                    app:iconGravity="textStart"
                    app:iconSize="16dp"
                    app:iconPadding="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_44"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="更多工具 ▾"
                    android:textSize="@dimen/text_13"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    app:backgroundTint="?attr/colorSecondaryContainer"
                    app:cornerRadius="@dimen/radius_22"/>

                <LinearLayout
                    android:id="@+id/ll_more_tools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_grant"
                        app:icon="@drawable/ic_settings"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_44"
                        android:text="授予 Termux 权限"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fix_channel"
                        app:icon="@drawable/ic_ai_warning"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_44"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="自检修复通道"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_copy_cmd"
                        app:icon="@drawable/ic_copy"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_44"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="复制手动命令"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_ubuntu"
                        app:icon="@drawable/ic_keyboard"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_44"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="进 Ubuntu 终端"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_termux"
                        app:icon="@drawable/ic_code"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_44"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="打开 Termux 终端（切回上次会话）"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_logs"
                        app:icon="@drawable/ic_log"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_44"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="查看环境日志"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_restart_gui"
                        app:icon="@drawable/ic_ai_connect"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_44"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="重启图形界面"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_stop_gui"
                        app:icon="@drawable/ic_stop_recording"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_44"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="停止图形界面"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                    <!-- 选装配套插件 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_install_api"
                        app:icon="@drawable/ic_ai_download"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_44"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="安装 Termux:API（选装）"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_install_boot"
                        app:icon="@drawable/ic_ai_download"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_44"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="安装 Termux:Boot（选装）"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_enable_ssh"
                        app:icon="@drawable/ic_settings"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_44"
                        android:layout_marginTop="@dimen/space_8"
