<?xml version="1.0" encoding="utf-8"?>
<!--
  完整 Python 环境（Termux + Ubuntu）一键准备。
  入口：工具集 → 设置与数据 → 完整 Python 环境。
  结构：页面头 → 环境状态卡（含手动刷新）→ 一键准备向导卡（进度条+当前步骤+唯一主按钮+兜底命令）
        → 高级工具折叠（只留独特功能）→ 运行日志卡。
  设计原则：新用户只看"向导卡"的当前步骤，跟着主按钮走完；其余按钮全部收进「更多工具」。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <!-- 页面头 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/space_16">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐍 完整 Python 环境"
                android:textSize="@dimen/text_22"
                android:textStyle="bold"
                android:textColor="?attr/colorControlText"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Termux + Ubuntu 一键部署 · 装好即可让 AI 调用真实 Linux 环境"
                android:textSize="@dimen/text_13"
                android:textColor="?attr/colorControlTextSecondary"/>
        </LinearLayout>

        <!-- ① 环境状态卡 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardElevation="3dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="?attr/colorCardBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="环境检查"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_refresh"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="刷新状态"
                        app:icon="@drawable/ic_refresh"
                        app:iconSize="20dp"
                        app:iconTint="?attr/colorPrimary"
                        app:iconGravity="textStart"
                        app:backgroundTint="?attr/colorPrimaryContainer"
                        app:cornerRadius="20dp"
                        app:strokeWidth="0dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_12"
                    android:layout_marginBottom="@dimen/space_12"
                    android:background="?attr/colorControlTextHint"
                    android:alpha="0.15"/>

                <TextView
                    android:id="@+id/env_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:textSize="@dimen/text_13"
                    android:textColor="?attr/colorControlTextSecondary"
                    android:text="检查中…"/>

                <!-- 异签名 Termux 引导（P2-7）：已装版与内置包签名不一致时明示，默认隐藏
                     注意：不要用 ?attr/colorErrorContainer —— 本项目主题未定义该属性，inflate 会抛
                     UnsupportedOperationException（真机踩过，TermuxEnvSetupActivity 直接闪退） -->
                <TextView
                    android:id="@+id/tv_signer_warn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:padding="@dimen/space_8"
                    android:lineSpacingExtra="3dp"
                    android:textSize="@dimen/text_12"
                    android:textStyle="bold"
                    android:textColor="#F5A623"
                    android:visibility="gone"
                    android:text="⚠️ 已装 Termux 与内置包签名不一致：点「安装 Termux」会被系统拒绝覆盖安装。推荐继续用现有 Termux（去点「自检并修复通道」，粘一行命令即可）；若想换成内置版，需先卸载旧 Termux（会清空已有容器环境）再装一次。"/>

                <!-- 首次打开 Termux 初始化引导（P0-2）：刚装上且还没授权 RUN_COMMAND 时明示，默认隐藏 -->
                <TextView
                    android:id="@+id/tv_first_init_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="?attr/colorPrimaryContainer"
                    android:padding="@dimen/space_8"
                    android:lineSpacingExtra="3dp"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:visibility="gone"
                    android:text="ℹ️ 首次打开 Termux 会自动初始化（下载基础包）：请等到出现命令行提示符 $ 再继续。初始化没完成时粘贴命令会报 command not found，容易误判成脚本坏了。"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="· 进入页面或点右上角刷新，自动重新检测"
                    android:textSize="@dimen/text_11"
                    android:textColor="?attr/colorControlTextHint"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ② 一键准备向导卡（唯一主入口） -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardElevation="3dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="?attr/colorCardBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="一键准备向导"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    android:textColor="?attr/colorControlText"/>

                <!-- 向导进度条 -->
                <ProgressBar
                    android:id="@+id/progress_guide"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="@dimen/space_12"
                    android:max="100"
                    android:progress="0"/>

                <!-- 当前步骤标题（动态） -->
                <TextView
                    android:id="@+id/guide_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="检测环境…"
                    android:textSize="@dimen/text_15"
                    android:textStyle="bold"
                    android:textColor="?attr/colorControlText"/>

                <!-- 当前步骤说明（动态） -->
                <TextView
                    android:id="@+id/guide_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="3dp"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorControlTextSecondary"
                    android:text="正在检测 Termux / 权限 / 容器状态…"/>

                <!-- 唯一主按钮：随当前步骤动态变化（自动检测缺什么，点一下做当前这一步） -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_smart_guide"
                    app:icon="@drawable/ic_ai_tool"
                    app:iconTint="?attr/colorOnPrimary"
                    app:iconGravity="textStart"
                    app:iconSize="22dp"
                    app:iconPadding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="检测环境…"
                    android:textSize="@dimen/text_14"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnPrimary"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="@dimen/radius_22"/>

                <!-- 兜底：手动复制命令（高级场景备用，不是主流程） -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_copy_cmd"
                    app:icon="@drawable/ic_copy"
                    app:iconTint="?attr/colorOnSecondaryContainer"
                    app:iconGravity="textStart"
                    app:iconSize="16dp"
                    app:iconPadding="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_40"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="📋 复制手动命令（兜底）"
                    android:textSize="@dimen/text_12"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    app:backgroundTint="?attr/colorSecondaryContainer"
                    app:cornerRadius="@dimen/radius_22"/>

                <!-- 高级功能折叠（只留向导覆盖不到的独特功能） -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_toggle_more"
                    app:icon="@drawable/ic_settings"
                    app:iconTint="?attr/colorOnSecondaryContainer"
                    app:iconGravity="textStart"
                    app:iconSize="16dp"
                    app:iconPadding="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_40"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="更多工具 ▾"
                    android:textSize="@dimen/text_13"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    app:backgroundTint="?attr/colorSecondaryContainer"
                    app:cornerRadius="@dimen/radius_22"/>

                <LinearLayout
                    android:id="@+id/ll_more_tools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_ubuntu"
                        app:icon="@drawable/ic_keyboard"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_40"
                        android:layout_marginTop="@dimen/space_6"
                        android:text="进 Ubuntu 终端"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_termux"
                        app:icon="@drawable/ic_code"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_40"
                        android:layout_marginTop="@dimen/space_6"
                        android:text="打开 Termux 终端（切回上次会话）"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_logs"
                        app:icon="@drawable/ic_log"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_40"
                        android:layout_marginTop="@dimen/space_6"
                        android:text="查看环境日志"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                    <!-- 选装配套插件（用户点名保留） -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_install_api"
                        app:icon="@drawable/ic_ai_download"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_40"
                        android:layout_marginTop="@dimen/space_6"
                        android:text="安装 Termux:API（选装）"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_install_boot"
                        app:icon="@drawable/ic_ai_download"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_40"
                        android:layout_marginTop="@dimen/space_6"
                        android:text="安装 Termux:Boot（选装）"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_enable_ssh"
                        app:icon="@drawable/ic_settings"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_40"
                        android:layout_marginTop="@dimen/space_6"
                        android:text="开启 SSH（电脑远程连 Termux / 容器）"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ssh_terminal"
                        app:icon="@drawable/ic_keyboard"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_40"
                        android:layout_marginTop="@dimen/space_6"
                        android:text="SSH 终端（App 内直连，进 Ubuntu 容器）"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ssh_autostart"
                        app:icon="@drawable/ic_settings"
                        app:iconTint="?attr/colorOnSecondaryContainer"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_40"
                        android:layout_marginTop="@dimen/space_6"
                        android:text="SSH 开机自启（防 sshd 被杀，需已装 Termux:Boot）"
                        android:textSize="@dimen/text_12"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        app:cornerRadius="@dimen/radius_22"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ②.5 一键安装步骤教程（7 步清单，点击行展开详情；状态图标由代码实时刷新：⚪待开始/⏳进行中/✅完成/❌失败） -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardElevation="3dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="?attr/colorCardBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="一键安装步骤教程"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    android:textColor="?attr/colorControlText"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="点击任一步查看详细说明；安装时自动更新每步状态"
                    android:textSize="@dimen/text_11"
                    android:textColor="?attr/colorControlTextHint"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_12"
                    android:layout_marginBottom="@dimen/space_4"
                    android:background="?attr/colorControlTextHint"
                    android:alpha="0.15"/>
                <LinearLayout
                    android:id="@+id/ll_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ③ 运行日志卡 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardElevation="3dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="?attr/colorCardBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="运行日志"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    android:textColor="?attr/colorControlText"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_12"
                    android:layout_marginBottom="@dimen/space_12"
                    android:background="?attr/colorControlTextHint"
                    android:alpha="0.15"/>
                <TextView
                    android:id="@+id/env_log"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorControlTextSecondary"
                    android:scrollbars="vertical"
                    android:text=""/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:lineSpacingExtra="3dp"
                    android:textSize="@dimen/text_11"
                    android:textColor="?attr/colorControlTextHint"
                    android:text="说明：Termux 必须作为独立应用安装（Android 只允许 targetSdk&lt;29 的应用执行自己私有目录里的二进制，proot/apt 靠这一点才能跑），所以无法合并进答题宝本体。\n内置包来源：Termux 0.118.3（F-Droid 官方签名，GPLv3，源码 github.com/termux/termux-app）+ Ubuntu 官方 ubuntu-base 24.04.5。\n装好后：Termux 里输入 ~/ubuntu 进真 Ubuntu；App 里的 AI 也能通过 termux_exec 调用它。\n准备脚本可重复运行（已装过的会跳过，不会报 already exists）；全程日志写在 Termux 的 ~/.quiz_env_setup.log，出问题先看它。\n若手机上弹出「允许访问文件」请点允许，否则读不到本地 28.5MB 包，会改成联网下载 30MB（也能装成）。"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
