<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/agent_block_tool_background"
    android:padding="@dimen/space_10">

    <View
        android:id="@+id/view_status_indicator"
        android:layout_width="@dimen/size_3"
        android:layout_height="match_parent"
        android:background="@color/accent"
        android:layout_marginEnd="@dimen/space_8"/>

    <LinearLayout
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_4">

            <TextView
                android:id="@+id/tv_step_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_12"
                android:textColor="@color/text_hint"
                android:layout_marginEnd="@dimen/space_6"/>

            <TextView
                android:id="@+id/tv_block_title"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/text_13"
                android:textStyle="bold"
                android:textColor="@color/accent"/>

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_12"
                android:textColor="@color/text_hint"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_tool_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_12"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/space_2"/>

        <TextView
            android:id="@+id/tv_tool_args"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_11"
            android:textColor="@color/text_secondary"
            android:fontFamily="monospace"
            android:background="@drawable/code_block_background"
            android:padding="@dimen/space_6"
            android:textIsSelectable="true"/>
    </LinearLayout>
</LinearLayout>
