<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- 性能指标卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <!-- TPS 和延迟 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_16">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                android:layout_marginEnd="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TPS"
                        android:textSize="@dimen/text_14"
                        android:textColor="?attr/colorControlTextSecondary"
                        android:layout_marginBottom="@dimen/space_8" />

                    <TextView
                        android:id="@+id/tps_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textSize="@dimen/text_24"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                android:layout_marginStart="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="延迟"
                        android:textSize="@dimen/text_14"
                        android:textColor="?attr/colorControlTextSecondary"
                        android:layout_marginBottom="@dimen/space_8" />

                    <TextView
                        android:id="@+id/latency_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0ms"
                        android:textSize="@dimen/text_24"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- GPU 使用率和内存使用率 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_16">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                android:layout_marginEnd="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPU 使用率"
                        android:textSize="@dimen/text_14"
                        android:textColor="?attr/colorControlTextSecondary"
                        android:layout_marginBottom="@dimen/space_8" />

                    <TextView
                        android:id="@+id/gpu_usage_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textSize="@dimen/text_24"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                android:layout_marginStart="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="内存使用率"
                        android:textSize="@dimen/text_14"
                        android:textColor="?attr/colorControlTextSecondary"
                        android:layout_marginBottom="@dimen/space_8" />

                    <TextView
                        android:id="@+id/memory_usage_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textSize="@dimen/text_24"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- 温度和性能评分 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                android:layout_marginEnd="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="温度"
                        android:textSize="@dimen/text_14"
                        android:textColor="?attr/colorControlTextSecondary"
                        android:layout_marginBottom="@dimen/space_8" />

                    <TextView
                        android:id="@+id/temperature_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0°C"
                        android:textSize="@dimen/text_24"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                android:layout_marginStart="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="性能评分"
                        android:textSize="@dimen/text_14"
                        android:textColor="?attr/colorControlTextSecondary"
                        android:layout_marginBottom="@dimen/space_8" />

                    <TextView
                        android:id="@+id/performance_score_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="@dimen/text_24"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- KV 缓存状态（增量命中率 / 上下文占用） -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/space_16">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KV 缓存命中率"
                        android:textSize="@dimen/text_14"
                        android:textColor="?attr/colorControlTextSecondary"
                        android:layout_marginBottom="@dimen/space_8" />

                    <TextView
                        android:id="@+id/kv_hit_rate_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="@dimen/text_24"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="上下文占用"
                        android:textSize="@dimen/text_14"
                        android:textColor="?attr/colorControlTextSecondary"
                        android:layout_marginBottom="@dimen/space_8" />

                    <TextView
                        android:id="@+id/kv_ctx_usage_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="@dimen/text_24"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- TPS 图表 -->
    <WebView
        android:id="@+id/tps_chart"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_200"
        android:padding="@dimen/space_16" />

    <!-- 优化建议 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="优化建议"
            android:textSize="@dimen/text_18"
            android:textStyle="bold"
            android:textColor="?attr/colorControlText"
            android:layout_marginBottom="@dimen/space_16" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/optimization_suggestions"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_0"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- 一键优化按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/one_click_optimize_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="一键优化"
        android:backgroundTint="@color/teal_600"
        android:textColor="@color/white"
        android:layout_margin="@dimen/space_16" />

</LinearLayout>