<?xml version="1.0" encoding="utf-8"?>
<!-- 远程连接扩展面板：日程 / 计划模式 / 子代理（2026-11-12） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground"
    android:padding="@dimen/space_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_8">

        <TextView
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="日程 · 计划 · 子代理"
            android:textSize="@dimen/text_18"
            android:textStyle="bold"
            android:textColor="?attr/colorControlText"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_insight_refresh"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="刷新"
            android:textAllCaps="false"/>
    </LinearLayout>

    <TextView
        android:id="@+id/insight_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:text="加载中…"
        android:textSize="@dimen/text_12"
        android:textColor="?attr/colorControlTextHint"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/insight_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>
</LinearLayout>
