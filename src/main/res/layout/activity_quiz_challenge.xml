<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.activity.QuizActivity">

    <!-- 顶部信息栏 -->
    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16"
        android:background="@color/purple_700"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textViewMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="挑战模式"
            android:textSize="@dimen/text_20"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="@dimen/space_8"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/textViewProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1/10"
                android:textSize="@dimen/text_16"
                android:textColor="@color/white"
                android:layout_marginRight="@dimen/space_16" />

            <TextView
                android:id="@+id/textViewTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:00"
                android:textSize="@dimen/text_18"
                android:textStyle="bold"
                android:textColor="@color/yellow_300"
                android:layout_marginRight="@dimen/space_16" />

            <TextView
                android:id="@+id/textViewScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="得分: 0"
                android:textSize="@dimen/text_16"
                android:textStyle="bold"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

    <!-- 题目内容 -->
    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:padding="@dimen/space_16"
        app:layout_constraintTop_toBottomOf="@id/topLayout"
        app:layout_constraintBottom_toTopOf="@id/navigationLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 题目文本 -->
            <TextView
                android:id="@+id/textViewQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="题目内容"
                android:textSize="@dimen/text_18"
                android:textColor="@color/black"
                android:layout_marginBottom="@dimen/space_24"
                android:lineSpacingExtra="4dp" />

            <!-- 选项区域 -->
            <RadioGroup
                android:id="@+id/radioGroupOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/space_24">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioButtonA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选项A"
                    android:textSize="@dimen/text_16"
                    android:textColor="@color/black"
                    android:layout_marginBottom="@dimen/space_12" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioButtonB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选项B"
                    android:textSize="@dimen/text_16"
                    android:textColor="@color/black"
                    android:layout_marginBottom="@dimen/space_12" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioButtonC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选项C"
                    android:textSize="@dimen/text_16"
                    android:textColor="@color/black"
                    android:layout_marginBottom="@dimen/space_12" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioButtonD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选项D"
                    android:textSize="@dimen/text_16"
                    android:textColor="@color/black" />

            </RadioGroup>

            <!-- 填空题答案输入 -->
            <EditText
                android:id="@+id/editTextUserAnswer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_120"
                android:hint="请输入答案"
                android:textSize="@dimen/text_16"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:padding="@dimen/space_12"
                android:background="@drawable/edittext_background"
                android:layout_marginBottom="@dimen/space_24"
                android:visibility="gone" />

            <!-- 题型选择和题目顺序 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/space_16">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/space_8">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="题型筛选:"
                        android:textSize="@dimen/text_14"
                        android:textColor="@color/black"
                        android:layout_marginRight="@dimen/space_8"
                        android:layout_gravity="center_vertical" />

                    <Spinner
                        android:id="@+id/spinnerQuestionType"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="@dimen/size_48"
                        android:layout_weight="1"
                        android:background="@drawable/spinner_background"
                        android:spinnerMode="dropdown" />

                </LinearLayout>
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="题目顺序:"
                        android:textSize="@dimen/text_14"
                        android:textColor="@color/black"
                        android:layout_marginRight="@dimen/space_8"
                        android:layout_gravity="center_vertical" />

                    <Spinner
                        android:id="@+id/spinnerQuestionOrder"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="@dimen/size_48"
                        android:layout_weight="1"
                        android:background="@drawable/spinner_background"
                        android:spinnerMode="dropdown" />

                </LinearLayout>

            </LinearLayout>

            <!-- 操作按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/space_16">

                <Button
                    android:id="@+id/buttonMark"
                    android:layout_width="@dimen/size_0"
                    android:layout_height="@dimen/size_48"
                    android:layout_weight="1"
                    android:text="标记题目"
                    android:textSize="@dimen/text_14"
                    android:backgroundTint="@color/yellow_600"
                    android:textColor="@color/white"
                    android:layout_marginRight="@dimen/space_8" />

                <Button
                    android:id="@+id/buttonShowAnswer"
                    android:layout_width="@dimen/size_0"
                    android:layout_height="@dimen/size_48"
                    android:layout_weight="1"
                    android:text="显示答案"
                    android:textSize="@dimen/text_14"
                    android:backgroundTint="@color/purple_600"
                    android:textColor="@color/white" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 题目导航 -->
    <LinearLayout
        android:id="@+id/navigationLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16"
        android:background="@color/white"
        android:elevation="@dimen/elev_8"
        app:layout_constraintBottom_toTopOf="@id/bottomLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 导航按钮将在代码中动态添加 -->

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- 底部按钮栏 -->
    <LinearLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16"
        android:background="@color/white"
        android:elevation="@dimen/elev_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 第一行按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_8">
            <Button
                android:id="@+id/buttonPrevious"
                android:layout_width="@dimen/size_0"
                android:layout_height="@dimen/size_56"
                android:layout_weight="1"
                android:text="上一题"
                android:textSize="@dimen/text_16"
                android:backgroundTint="@color/purple_600"
                android:textColor="@color/white"
                android:layout_marginRight="@dimen/space_8" />

            <Button
                android:id="@+id/buttonSubmit"
                android:layout_width="@dimen/size_0"
                android:layout_height="@dimen/size_56"
                android:layout_weight="1"
                android:text="提交答案"
                android:textSize="@dimen/text_16"
                android:backgroundTint="@color/pink_600"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- 第二行按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/buttonNext"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_56"
                android:text="下一题"
                android:textSize="@dimen/text_16"
                android:backgroundTint="@color/purple_600"
                android:textColor="@color/white" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>