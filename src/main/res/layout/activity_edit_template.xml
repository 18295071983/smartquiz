<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.activity.EditTemplateActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="@dimen/elev_4"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:title="编辑模板">
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="模板名称"
                    android:textSize="@dimen/text_14"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginBottom="@dimen/space_8" />

                <EditText
                    android:id="@+id/template_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="请输入模板名称"
                    android:inputType="text"
                    android:padding="@dimen/space_12"
                    android:background="@android:drawable/edit_text" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="模板名称"
                    android:textSize="@dimen/text_14"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginBottom="@dimen/space_8" />

                <EditText
                    android:id="@+id/nameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="请输入模板名称"
                    android:inputType="text"
                    android:padding="@dimen/space_12"
                    android:background="@android:drawable/edit_text" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="描述"
                    android:textSize="@dimen/text_14"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginBottom="@dimen/space_8" />

                <EditText
                    android:id="@+id/descriptionEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="请输入描述"
                    android:inputType="textMultiLine"
                    android:padding="@dimen/space_12"
                    android:background="@android:drawable/edit_text" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="文件路径"
                    android:textSize="@dimen/text_14"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginBottom="@dimen/space_8" />

                <EditText
                    android:id="@+id/filePathEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="请输入文件路径"
                    android:inputType="text"
                    android:padding="@dimen/space_12"
                    android:background="@android:drawable/edit_text" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="导出格式"
                    android:textSize="@dimen/text_14"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginBottom="@dimen/space_8" />

                <TextView
                    android:id="@+id/template_format"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EXCEL"
                    android:textSize="@dimen/text_16"
                    android:textColor="@android:color/black"
                    android:padding="@dimen/space_12"
                    android:background="@android:drawable/edit_text"
                    android:enabled="false" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="模板类型"
                    android:textSize="@dimen/text_14"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginBottom="@dimen/space_8" />

                <TextView
                    android:id="@+id/template_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="通用模板"
                    android:textSize="@dimen/text_16"
                    android:textColor="@android:color/black"
                    android:padding="@dimen/space_12"
                    android:background="@android:drawable/edit_text"
                    android:enabled="false" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="导出字段"
                        android:textSize="@dimen/text_14"
                        android:textColor="@android:color/darker_gray" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_field_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="添加字段"
                        app:backgroundTint="@color/primary"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/text_12"
                        app:cornerRadius="@dimen/radius_12"
                        android:textAllCaps="false"/>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/fields_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_300"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@android:drawable/edit_text" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_16">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:backgroundTint="@color/primary"
            android:text="保存"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_16"
            android:layout_marginEnd="@dimen/space_8"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:backgroundTint="@color/secondary"
            android:text="取消"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_16"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false"/>
    </LinearLayout>

</LinearLayout>
