<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_12"
    android:paddingEnd="@dimen/space_12"
    android:paddingTop="@dimen/space_6"
    android:paddingBottom="@dimen/space_6">

    <!-- 主要内容：自然语言描述 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 步骤图标（带动画效果） -->
        <TextView
            android:id="@+id/step_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖"
            android:textSize="@dimen/text_16"
            android:layout_marginEnd="@dimen/space_8" />

        <!-- 主要描述文本 -->
        <TextView
            android:id="@+id/step_description"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/text_14"
            android:textColor="@color/text_primary"
            android:lineSpacingExtra="2dp" />

        <!-- 推理模式标签（小标签） -->
        <TextView
            android:id="@+id/step_reasoning_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_12"
            android:textColor="@color/text_secondary"
            android:background="@drawable/agent_step_tag_background"
            android:paddingStart="@dimen/space_6"
            android:paddingEnd="@dimen/space_6"
            android:paddingTop="@dimen/space_2"
            android:paddingBottom="@dimen/space_2"
            android:layout_marginStart="@dimen/space_8"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 详细信息（可折叠，用于显示意图分析等） -->
    <TextView
        android:id="@+id/step_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="@dimen/space_4"
        android:textSize="@dimen/text_13"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="2dp"
        android:visibility="gone" />

    <!-- 进度条（小进度条） -->
    <ProgressBar
        android:id="@+id/step_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_2"
        android:layout_marginTop="@dimen/space_4"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/agent_step_progress"
        android:visibility="gone" />

</LinearLayout>
