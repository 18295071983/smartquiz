<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:padding="@dimen/space_16">

    <!-- 标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Agent 调试控制台"
        android:textSize="@dimen/text_20"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"/>

    <!-- 状态区 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        app:cardElevation="2dp"
        app:cardCornerRadius="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="外部注入通道"
                    android:textSize="@dimen/text_14"/>
                <TextView
                    android:id="@+id/tv_bridge_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关闭"
                    android:textSize="@dimen/text_12"
                    android:textStyle="bold"
                    android:textColor="?attr/colorControlTextSecondary"/>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_bridge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Token"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorControlTextSecondary"/>
                <TextView
                    android:id="@+id/tv_token"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_marginEnd="@dimen/space_8"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorOnSurface"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_copy_token"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/size_64"
                    android:text="复制"
                    android:textSize="@dimen/text_12"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="连通状态"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorControlTextSecondary"/>
                <TextView
                    android:id="@+id/tv_conn_state"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_8"
                    android:gravity="end"
                    android:text="待触发"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorControlTextSecondary"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 日志区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/space_12"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="调试日志"
                android:textSize="@dimen/text_14"
                android:textStyle="bold"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_log"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清空"
                android:textSize="@dimen/text_12"/>
        </LinearLayout>
        <ScrollView
            android:id="@+id/scroll_log"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/space_8"
            android:background="?attr/colorDivider"
            android:padding="@dimen/space_8">
            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorOnSurface"
                android:textIsSelectable="true"/>
        </ScrollView>
    </LinearLayout>

    <!-- 说明 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="外部注入（adb broadcast AGENT_EXEC）会自动跳转到本页实时显示全过程；PC 端可同时用 adb logcat -s AgentDebugBridge 与结果文件观测。"
        android:textSize="@dimen/text_11"
        android:textColor="?attr/colorControlTextSecondary"/>
</LinearLayout>
