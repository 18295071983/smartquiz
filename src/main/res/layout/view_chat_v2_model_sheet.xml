<?xml version="1.0" encoding="utf-8"?>
<!-- 聊天页「模型与参数」面板（demo #sheet-model）：
     在线/本地分段 + 模型列表 + 温度 + 上下文 + 应用。
     行内容由 ModelSheet 动态填充（在线模型来自 OnlineModelManager，本地来自 AIService）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_18">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chat_v2_model_sheet_title"
            android:textColor="@color/chat_v2_text"
            android:textSize="@dimen/text_18"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/chat_v2_model_sheet_close"
            android:layout_width="@dimen/size_28"
            android:layout_height="@dimen/size_28"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="@dimen/space_4"
            android:src="@drawable/ic_clear"
            app:tint="@color/chat_v2_text_2"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_40"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/chat_v2_segment_bg"
        android:orientation="horizontal"
        android:padding="@dimen/space_3">

        <TextView
            android:id="@+id/chat_v2_model_tab_online"
            android:layout_width="@dimen/size_0"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/chat_v2_segment_selected"
            android:gravity="center"
            android:text="@string/chat_v2_model_online"
            android:textColor="@color/chat_v2_text"
            android:textSize="@dimen/text_14"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/chat_v2_model_tab_local"
            android:layout_width="@dimen/size_0"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/chat_v2_model_local"
            android:textColor="@color/chat_v2_text_3"
            android:textSize="@dimen/text_14"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:maxHeight="@dimen/chat_v2_model_list_max"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chat_v2_model_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chat_v2_model_temperature"
            android:textColor="@color/chat_v2_text_2"
            android:textSize="@dimen/text_14"/>

        <SeekBar
            android:id="@+id/chat_v2_model_temp_bar"
            android:layout_width="@dimen/size_180"
            android:layout_height="wrap_content"
            android:max="140"
            android:progress="60"/>

        <TextView
            android:id="@+id/chat_v2_model_temp_value"
            android:layout_width="@dimen/size_40"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0.7"
            android:textColor="@color/chat_v2_text"
            android:textSize="@dimen/text_14"/>
    </LinearLayout>

    <TextView
        android:id="@+id/chat_v2_model_context"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:textColor="@color/chat_v2_text_3"
        android:textSize="@dimen/chat_v2_status_text"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/chat_v2_model_apply"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_44"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/chat_v2_model_apply"
        android:textAllCaps="false"
        android:textColor="@color/chat_v2_on_brand"
        app:backgroundTint="@color/chat_v2_brand"
        app:cornerRadius="@dimen/radius_12"/>
</LinearLayout>
