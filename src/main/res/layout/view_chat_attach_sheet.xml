<?xml version="1.0" encoding="utf-8"?>
<!-- 聊天页「添加」面板（demo #sheet-attach）：2×3 图标网格。
     2026-10-21 从 4 项 AlertDialog 改成 demo 的卡片网格。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_18">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chat_attach_title"
            android:textColor="@color/chat_v2_text"
            android:textSize="@dimen/text_18"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/chat_v2_attach_close"
            android:layout_width="@dimen/size_28"
            android:layout_height="@dimen/size_28"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="@dimen/space_4"
            android:src="@drawable/ic_clear"
            app:tint="@color/chat_v2_text_2"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/chat_v2_attach_camera"
            style="@style/ChatV2AttachTile"
            android:layout_marginEnd="@dimen/space_6">

            <ImageView
                android:layout_width="@dimen/size_24"
                android:layout_height="@dimen/size_24"
                android:background="@drawable/chat_v2_scene_icon_bg"
                android:contentDescription="@string/chat_attach_camera"
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_chat_v2_camera"
                app:tint="@color/chat_v2_brand_ink"/>

            <TextView
                style="@style/ChatV2AttachLabel"
                android:text="@string/chat_attach_camera"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chat_v2_attach_gallery"
            style="@style/ChatV2AttachTile"
            android:layout_marginEnd="@dimen/space_6">

            <ImageView
                android:layout_width="@dimen/size_24"
                android:layout_height="@dimen/size_24"
                android:background="@drawable/chat_v2_scene_icon_bg"
                android:contentDescription="@string/chat_attach_gallery"
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_chat_v2_gallery"
                app:tint="@color/chat_v2_brand_ink"/>

            <TextView
                style="@style/ChatV2AttachLabel"
                android:text="@string/chat_attach_gallery"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chat_v2_attach_file"
            style="@style/ChatV2AttachTile">

            <ImageView
                android:layout_width="@dimen/size_24"
                android:layout_height="@dimen/size_24"
                android:background="@drawable/chat_v2_scene_icon_bg"
                android:contentDescription="@string/chat_attach_file"
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_file"
                app:tint="@color/chat_v2_brand_ink"/>

            <TextView
                style="@style/ChatV2AttachLabel"
                android:text="@string/chat_attach_file"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/chat_v2_attach_voice"
            style="@style/ChatV2AttachTile"
            android:layout_marginEnd="@dimen/space_6">

            <ImageView
                android:layout_width="@dimen/size_24"
                android:layout_height="@dimen/size_24"
                android:background="@drawable/chat_v2_scene_icon_bg"
                android:contentDescription="@string/chat_attach_voice"
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_mic"
                app:tint="@color/chat_v2_brand_ink"/>

            <TextView
                style="@style/ChatV2AttachLabel"
                android:text="@string/chat_attach_voice"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chat_v2_attach_tool"
            style="@style/ChatV2AttachTile"
            android:layout_marginEnd="@dimen/space_6">

            <ImageView
                android:layout_width="@dimen/size_24"
                android:layout_height="@dimen/size_24"
                android:background="@drawable/chat_v2_scene_icon_bg"
                android:contentDescription="@string/chat_attach_tool"
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_ai_tool"
                app:tint="@color/chat_v2_brand_ink"/>

            <TextView
                style="@style/ChatV2AttachLabel"
                android:text="@string/chat_attach_tool"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chat_v2_attach_screen"
            style="@style/ChatV2AttachTile">

            <ImageView
                android:layout_width="@dimen/size_24"
                android:layout_height="@dimen/size_24"
                android:background="@drawable/chat_v2_scene_icon_bg"
                android:contentDescription="@string/chat_attach_screen"
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_chat_v2_screenshot"
                app:tint="@color/chat_v2_brand_ink"/>

            <TextView
                style="@style/ChatV2AttachLabel"
                android:text="@string/chat_attach_screen"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

