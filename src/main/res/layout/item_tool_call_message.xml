<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/tool_call_card_background">

    <!-- 头部：工具名 + 状态（可点击折叠整个块） -->
    <LinearLayout
        android:id="@+id/tool_call_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/tool_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔧"
            android:textSize="16sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tool_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="@color/tool_call_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tool_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/tool_call_status_default" />

        <TextView
            android:id="@+id/tool_call_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶"
            android:textSize="12sp"
            android:textColor="@color/tool_call_label"
            android:layout_marginStart="6dp" />

        <ProgressBar
            android:id="@+id/tool_progress_small"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 执行信息行 -->
    <LinearLayout
        android:id="@+id/tool_info_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tool_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/tool_call_info"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tool_tokens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/tool_call_info" />
    </LinearLayout>

    <!-- 参数区域（可折叠） -->
    <LinearLayout
        android:id="@+id/tool_params_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:id="@+id/tool_params_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp"
            android:background="@drawable/tool_call_expandable_bg"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tool_params_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textSize="10sp"
                android:textColor="@color/tool_call_label"
                android:layout_marginEnd="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 参数"
                android:textSize="12sp"
                android:textColor="@color/tool_call_label" />
        </LinearLayout>

        <TextView
            android:id="@+id/tool_params"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tool_call_background"
            android:padding="10dp"
            android:textColor="@color/tool_call_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 结果区域（可折叠） -->
    <LinearLayout
        android:id="@+id/tool_result_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tool_result_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp"
            android:background="@drawable/tool_result_expandable_bg"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tool_result_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textSize="10sp"
                android:textColor="@color/tool_result_label"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tool_result_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📤 结果"
                android:textSize="12sp"
                android:textColor="@color/tool_result_label" />
        </LinearLayout>

        <TextView
            android:id="@+id/tool_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tool_call_result_background"
            android:padding="10dp"
            android:textColor="@color/tool_call_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:scrollbars="vertical" />
    </LinearLayout>

</LinearLayout>
