<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_8"
    android:background="@drawable/message_card_tool">

    <!-- 头部：工具图标 + 工具名 + 状态徽标（点击折叠整个块） -->
    <LinearLayout
        android:id="@+id/tool_call_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/tool_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔧"
            android:textSize="@dimen/text_16"
            android:layout_marginEnd="@dimen/space_6" />

        <TextView
            android:id="@+id/tool_name"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/text_14"
            android:textColor="@color/tool_call_label"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/tool_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_11"
            android:textColor="@color/tool_call_status_default" />

        <TextView
            android:id="@+id/tool_call_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶"
            android:textSize="@dimen/text_12"
            android:textColor="@color/tool_call_label"
            android:layout_marginStart="@dimen/space_6" />

        <ProgressBar
            android:id="@+id/tool_progress_small"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="@dimen/size_16"
            android:layout_height="@dimen/size_16"
            android:layout_marginStart="@dimen/space_6"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 参数区域（可折叠） -->
    <LinearLayout
        android:id="@+id/tool_params_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="@dimen/space_4">

        <LinearLayout
            android:id="@+id/tool_params_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/space_6"
            android:background="@drawable/message_card_tool"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tool_params_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textSize="@dimen/text_12"
                android:textColor="@color/tool_call_label"
                android:layout_marginEnd="@dimen/space_4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 参数"
                android:textSize="@dimen/text_12"
                android:textColor="@color/tool_call_label" />
        </LinearLayout>

        <TextView
            android:id="@+id/tool_params"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/message_card_tool"
            android:padding="@dimen/space_10"
            android:textColor="@color/tool_call_text"
            android:textSize="@dimen/text_12"
            android:fontFamily="monospace"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 结果区域（可折叠） -->
    <LinearLayout
        android:id="@+id/tool_result_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tool_result_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/space_6"
            android:background="@drawable/message_card_tool"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tool_result_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textSize="@dimen/text_12"
                android:textColor="@color/tool_result_label"
                android:layout_marginEnd="@dimen/space_4" />

            <TextView
                android:id="@+id/tool_result_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📤 结果"
                android:textSize="@dimen/text_12"
                android:textColor="@color/tool_result_label" />
        </LinearLayout>

        <TextView
            android:id="@+id/tool_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/message_card_tool"
            android:padding="@dimen/space_10"
            android:textColor="@color/tool_call_text"
            android:textSize="@dimen/text_12"
            android:fontFamily="monospace"
            android:scrollbars="vertical" />
    </LinearLayout>

</LinearLayout>
