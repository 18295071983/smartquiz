<?xml version="1.0" encoding="utf-8"?>
<!-- 聊天输入栏 v2（demo/ai-chat-redesign.html 的 .composer .shell）：
     一颗胶囊装下 附件 / 输入 / 语音 / 发送·停止。
     控件 id 与 view_chat_input_bar.xml 完全一致，ChatInputBar 按开关选本文件，
     宿主逻辑（getter / findViewById / 监听器）不需要改。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/chat_v2_composer_pad"
    android:paddingTop="@dimen/space_6"
    android:paddingBottom="@dimen/space_6">

    <!-- 生成中状态行（2026-10-25 二次重设计）：单一状态 + 速度 + 余额，不再堆"生成中 · 推理 X · 模型 Y"。
         ● 思考中          42.3 t/s        💰 余额 CNY ¥11.84
         左：当前状态（就一个）——推理状态机阶段：等待响应 / 思考中 / 生成中；
             模型状态机只在异常/加载时补在后面（如「· 模型 加载模型…」），就绪时不显示（避免"就绪"没信息量）。
         右：实时推理速度（思考阶段也算 reasoning tokens/s）、余额。 -->
    <LinearLayout
        android:id="@+id/chat_v2_gen_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_2"
        android:paddingBottom="@dimen/space_6"
        android:visibility="gone">

        <View
            android:id="@+id/chat_v2_gen_dot"
            android:layout_width="@dimen/chat_v2_dot"
            android:layout_height="@dimen/chat_v2_dot"
            android:background="@drawable/chat_v2_dot_brand" />

        <TextView
            android:id="@+id/chat_v2_gen_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/chat_v2_line_gap"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="@dimen/chat_v2_title_max_width"
            android:text="等待响应"
            android:textColor="?attr/colorControlTextSecondary"
            android:textSize="@dimen/chat_v2_status_text" />

        <TextView
            android:id="@+id/chat_v2_gen_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_6"
            android:maxLines="1"
            android:textColor="?attr/colorControlTextHint"
            android:textSize="@dimen/chat_v2_status_text" />

        <Space
            android:layout_width="0dp"
            android:layout_height="@dimen/card_shell_border"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/chat_v2_gen_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="?attr/colorPrimaryVariant"
            android:textSize="@dimen/chat_v2_status_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chat_v2_gen_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_10"
            android:maxLines="1"
            android:textColor="?attr/colorControlTextHint"
            android:textSize="@dimen/chat_v2_status_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/chat_v2_composer_min_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/chat_v2_composer_shell"
        android:padding="@dimen/space_5">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_attach"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/chat_v2_icon_button"
            android:layout_height="@dimen/chat_v2_icon_button"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="@string/chat_attach_desc"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="?attr/colorControlTextSecondary"/>

        <EditText
            android:id="@+id/input_message"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/chat_input_hint"
            android:inputType="textMultiLine"
            android:maxLines="5"
            android:minHeight="@dimen/radius_xl"
            android:paddingHorizontal="@dimen/space_xs"
            android:paddingVertical="@dimen/chat_v2_line_pad"
            android:textColor="?attr/colorControlText"
            android:textColorHint="?attr/colorControlTextHint"
            android:textSize="@dimen/chat_v2_bubble_text"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_voice"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/chat_v2_icon_button"
            android:layout_height="@dimen/chat_v2_icon_button"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="@string/chat_voice_desc"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_mic"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="?attr/colorControlTextSecondary"/>

        <!-- 发送：品牌色圆钮（demo 是 brand-2→brand 渐变，MaterialButton 的
             backgroundTint 只能纯色，渐变留给后续换 ImageView 时做） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/chat_v2_send_size"
            android:layout_height="@dimen/chat_v2_send_size"
            android:layout_marginStart="@dimen/space_hairline"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="@string/chat_send_desc"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="19dp"
            app:icon="@drawable/ic_send_message"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="18dp"
            app:iconTint="?attr/colorOnPrimary"/>

        <!-- 停止生成：与发送同位切换（ChatInputBar 已有显隐逻辑） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_stop_generation"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/chat_v2_send_size"
            android:layout_height="@dimen/chat_v2_send_size"
            android:layout_marginStart="@dimen/space_hairline"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="@string/chat_stop_generating"
            android:visibility="gone"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="19dp"
            app:icon="@drawable/ic_stop"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="16dp"
            app:iconTint="?attr/colorOnPrimary"/>
    </LinearLayout>

    <!-- 远程态元信息（2026-11-14，参考 dsh-Go：手机上顶栏不放模型胶囊，
         模型与思考深度放在**输入框下方**）。只在连着电脑时显示；本地路径不占这一行。 -->
    <TextView
        android:id="@+id/chat_v2_remote_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="?attr/colorControlTextHint"
        android:textSize="@dimen/chat_v2_status_text"
        android:visibility="gone" />
</LinearLayout>
