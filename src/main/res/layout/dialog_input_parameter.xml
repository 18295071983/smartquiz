<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 标题 -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="需要补充信息"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/dialog_title_text"
        android:layout_marginBottom="16dp" />

    <!-- 提示信息 -->
    <TextView
        android:id="@+id/promptText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="请提供必要信息"
        android:textSize="16sp"
        android:textColor="@color/dialog_primary_text"
        android:layout_marginBottom="12dp" />

    <!-- 任务上下文 -->
    <TextView
        android:id="@+id/contextText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="任务: xxx"
        android:textSize="14sp"
        android:textColor="@color/dialog_secondary_text"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <!-- 建议标签 -->
    <TextView
        android:id="@+id/suggestLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="建议:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/dialog_primary_text"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- 建议列表 -->
    <TextView
        android:id="@+id/suggestionsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• 示例1\n• 示例2"
        android:textSize="14sp"
        android:textColor="@color/dialog_suggestion_text"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <!-- 输入框 -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="请输入..."
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 错误提示 -->
    <TextView
        android:id="@+id/errorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="输入错误"
        android:textSize="14sp"
        android:textColor="@color/dialog_error_text"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <!-- 按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消"
            android:textColor="@color/dialog_button_text_secondary" />

        <Button
            android:id="@+id/btnSubmit"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="提交" />
    </LinearLayout>

</LinearLayout>