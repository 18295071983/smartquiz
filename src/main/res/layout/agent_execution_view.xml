<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_8">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="@dimen/space_6">

        <TextView
            android:id="@+id/tv_title_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖"
            android:textSize="@dimen/text_18" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Agent执行中..."
            android:textSize="@dimen/text_14"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/space_6" />

        <TextView
            android:id="@+id/tv_step_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="步骤 1/?"
            android:textSize="@dimen/text_12"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

    <!-- 执行日志区域（可滚动） -->
    <ScrollView
        android:id="@+id/scroll_logs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/agent_execution_background"
        android:padding="@dimen/space_12">
        <!-- 日志区背景 agent_execution_background 使用 surface（浅色=白/夜间=深灰），
             与文字 text_primary/text_secondary 均有足够对比度 -->

        <LinearLayout
            android:id="@+id/logs_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 动态添加日志条目 -->
        </LinearLayout>

    </ScrollView>

    <!-- 当前步骤详情卡片 -->
    <LinearLayout
        android:id="@+id/current_step_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/agent_step_card_background"
        android:padding="@dimen/space_12"
        android:layout_marginTop="@dimen/space_8">

        <!-- 步骤类型标签 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_step_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="思考"
                android:textSize="@dimen/text_12"
                android:textColor="@color/primary"
                android:background="@drawable/agent_step_type_tag"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />

            <View
                android:layout_width="@dimen/size_0"
                android:layout_height="@dimen/size_0"
                android:layout_weight="1" />

            <!-- 推理速度 / Token 统计：AI 导入流程不更新（页面上方有 monitorBar），默认隐藏 -->
            <TextView
                android:id="@+id/tv_inference_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 t/s"
                android:textSize="@dimen/text_11"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_token_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 token"
                android:textSize="@dimen/text_11"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="@dimen/space_8"
                android:visibility="gone" />

        </LinearLayout>

        <!-- 步骤内容 -->
        <TextView
            android:id="@+id/tv_step_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_14"
            android:textColor="@color/text_primary"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginTop="@dimen/space_8"
            android:textIsSelectable="true" />

        <!-- 工具调用参数（当步骤类型为工具调用时显示） -->
        <LinearLayout
            android:id="@+id/tool_params_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_8"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="工具参数:"
                android:textSize="@dimen/text_11"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_tool_params"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_12"
                android:textColor="@color/text_primary"
                android:background="@drawable/code_block_background"
                android:padding="@dimen/space_8"
                android:layout_marginTop="@dimen/space_4"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- 工具执行结果（当步骤类型为工具结果时显示） -->
        <LinearLayout
            android:id="@+id/tool_result_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_8"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_tool_result_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ 成功"
                    android:textSize="@dimen/text_11"
                    android:textColor="@color/success"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_tool_result_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="工具名称"
                    android:textSize="@dimen/text_11"
                    android:textColor="@color/text_secondary"
                    android:layout_marginStart="@dimen/space_8" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_tool_result_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_13"
                android:textColor="@color/text_primary"
                android:background="@drawable/code_block_background"
                android:padding="@dimen/space_10"
                android:layout_marginTop="@dimen/space_6"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- 底部统计栏：AI 导入流程不更新（页面上方有 monitorBar），默认隐藏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_4"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已用时间: 0秒"
            android:textSize="@dimen/text_11"
            android:textColor="@color/text_secondary" />

        <View
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_0"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_total_tokens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="总计: 0 token"
            android:textSize="@dimen/text_11"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

</LinearLayout>