<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tv_title_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Agent执行中..."
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/tv_step_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="步骤 1/?"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

    <!-- 执行日志区域（可滚动） -->
    <ScrollView
        android:id="@+id/scroll_logs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/agent_execution_background"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/logs_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 动态添加日志条目 -->
        </LinearLayout>

    </ScrollView>

    <!-- 当前步骤详情卡片 -->
    <LinearLayout
        android:id="@+id/current_step_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/agent_step_card_background"
        android:padding="12dp"
        android:layout_marginTop="8dp">

        <!-- 步骤类型标签 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_step_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="思考"
                android:textSize="12sp"
                android:textColor="@color/primary"
                android:background="@drawable/agent_step_type_tag"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_inference_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 t/s"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_token_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 token"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- 步骤内容 -->
        <TextView
            android:id="@+id/tv_step_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true" />

        <!-- 工具调用参数（当步骤类型为工具调用时显示） -->
        <LinearLayout
            android:id="@+id/tool_params_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="工具参数:"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_tool_params"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/code_block_background"
                android:padding="8dp"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- 工具执行结果（当步骤类型为工具结果时显示） -->
        <LinearLayout
            android:id="@+id/tool_result_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_tool_result_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ 成功"
                    android:textSize="11sp"
                    android:textColor="@color/success"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_tool_result_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="工具名称"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_tool_result_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/code_block_background"
                android:padding="10dp"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- 底部统计栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已用时间: 0秒"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_total_tokens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="总计: 0 token"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

</LinearLayout>