<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground"
    tools:context=".ui.activity.ModelSelectorActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/elev_0"
        android:background="?attr/colorSurface">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:title="模型"
            app:titleTextColor="?attr/colorControlText"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 在线服务状态栏 -->
    <LinearLayout
        android:id="@+id/service_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="?attr/colorSurfaceVariant"
        android:visibility="gone">
        <View
            android:id="@+id/status_indicator"
            android:layout_width="@dimen/size_8"
            android:layout_height="@dimen/size_8"
            android:background="@drawable/status_indicator_unknown"/>
        <TextView
            android:id="@+id/tv_service_status"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_8"
            android:text="在线服务状态"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorControlTextSecondary"/>
        <TextView
            android:id="@+id/tv_usage_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="@dimen/text_11"
            android:textColor="?attr/colorControlTextHint"/>
    </LinearLayout>

    <!-- 当前模型信息卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_16"
        app:cardCornerRadius="@dimen/radius_16"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorDivider">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="当前模型"
                android:textSize="@dimen/text_14"
                android:textColor="?attr/colorControlTextSecondary"
                android:layout_marginBottom="@dimen/space_4"/>
            <TextView
                android:id="@+id/current_model_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未选择模型"
                android:textSize="@dimen/text_16"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="@dimen/space_4"/>
            <TextView
                android:id="@+id/current_model_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="类型: 未知"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlTextHint"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- AI 服务一键初始化：本地与在线模型均未配置时显示 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ai_init_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_4"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/radius_16"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/colorPrimaryContainer">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="一键初始化 AI 服务"
                android:textSize="@dimen/text_15"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="@dimen/space_4"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="尚未配置本地与在线模型。点击自动下载默认模型并初始化本地模型服务，离线即可使用。"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlTextSecondary"
                android:layout_marginBottom="@dimen/space_12"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ai_init"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_36"
                android:text="一键初始化"
                app:backgroundTint="?attr/colorPrimary"
                android:textColor="?attr/colorOnPrimary"
                app:cornerRadius="@dimen/radius_8"
                android:textAllCaps="false"
                android:textSize="@dimen/text_14"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <!-- 在线模型区域 -->
            <LinearLayout
                android:id="@+id/online_models_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <!-- 2026-11-04：标题和三个按钮原本挤在同一行。按钮宽度加起来吃掉大半个屏，
                     标题被压到只剩几十像素 → 「在线模型」被逐字换行竖着排（真机截图可见），
                     整行还被撑高。现在标题独占一行，按钮另起一行。 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_section_header"
                    android:paddingHorizontal="@dimen/space_10"
                    android:paddingVertical="@dimen/space_4"
                    android:text="在线模型"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    android:textColor="?attr/colorControlText"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_online_model_button"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/size_36"
                        android:text="+ 添加"
                        app:backgroundTint="?attr/colorPrimary"
                        android:textColor="?attr/colorOnPrimary"
                        app:cornerRadius="@dimen/radius_8"
                        android:textAllCaps="false"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_api_config"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/size_36"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="🔑 服务商密钥"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        android:textColor="?attr/colorPrimary"
                        app:cornerRadius="@dimen/radius_8"
                        android:textAllCaps="false"
                        android:textSize="@dimen/text_12"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                    <!-- MODEL-HUB-ONE-PLACE(2026-11-02)：补上反向一跳。原先只有
                         模型中心 → 本页，本页却没有任何地方能去看用量，用户只能退回抽屉。 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_goto_model_center"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/size_36"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="📊 用量与注册"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        android:textColor="?attr/colorPrimary"
                        app:cornerRadius="@dimen/radius_8"
                        android:textAllCaps="false"
                        android:textSize="@dimen/text_12"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/online_models_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <TextView
                    android:id="@+id/online_models_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:padding="@dimen/space_16"
                    android:gravity="center"
                    android:text="暂无在线模型，点击右上角“+ 添加”配置 API"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorControlTextHint"
                    android:background="@drawable/empty_bg_dashed"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- 语音模型区域（识别 / 合成；2026-11-02 从旧名改过来，见下方注释） -->
            <LinearLayout
                android:id="@+id/feature_models_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingBottom="@dimen/space_16">
                <LinearLayout
                    android:id="@+id/row_feature_models_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/space_12"
                    android:paddingStart="@dimen/space_4"
                    android:paddingEnd="@dimen/space_4"
                    android:background="?attr/selectableItemBackground">
                    <!-- 2026-11-02：旧名带「专用」两字时容易被读成"第三种聊天模型模式"；
                         这里选的是语音识别/语音合成用的模型，与聊天用哪个引擎无关。
                         区域名与标题行一起改成「语音模型（识别 / 合成）」。 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_section_header"
                        android:paddingHorizontal="@dimen/space_10"
                        android:paddingVertical="@dimen/space_4"
                        android:text="语音模型（识别 / 合成）"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="为语音等功能指定专用在线模型，不配置则自动选择"
                    android:textSize="@dimen/text_11"
                    android:textColor="?attr/colorControlTextHint"/>

                <!-- NPU（Qualcomm GenieX）引擎行已删除(2026-11-01)：它与本包 HTP 后端共用同名
                     libggml-htp-vNN.so，FastRPC 按文件名加载，一个 APK 只能留一份；实测一开
                     GenieX 就 ggml_abort 闪退。开关判据已在 InferenceRouter 钉成 false。 -->
                <!-- 三行收进一张设置卡（2026-11-04）：原来是无卡片的纯文字行 + emoji，
                     与重做后的音色弹窗、应用里其余设置卡不是一套视觉。这里统一成
                     「图标 + 标题 + 当前值 + chevron」的设置行，行间 1dp 分隔线。 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_10"
                    app:cardCornerRadius="@dimen/radius_16"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorDivider">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- 语音识别模型 -->
                        <LinearLayout
                            android:id="@+id/row_asr_model"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/size_48"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/space_14"
                            android:paddingEnd="@dimen/space_10"
                            android:paddingVertical="@dimen/space_10"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="@dimen/size_24"
                                android:layout_height="@dimen/size_24"
                                android:src="@drawable/ic_mic"
                                android:contentDescription="@null"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/space_12"
                                android:text="语音识别"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorControlText" />

                            <TextView
                                android:id="@+id/tv_asr_model_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:maxWidth="180dp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="自动选择"
                                android:textSize="@dimen/text_13"
                                android:textColor="?attr/colorControlTextSecondary" />

                            <ImageView
                                android:layout_width="@dimen/size_16"
                                android:layout_height="@dimen/size_16"
                                android:layout_marginStart="@dimen/space_6"
                                android:src="@drawable/ic_chevron_right"
                                android:contentDescription="@null"
                                app:tint="?attr/colorControlTextHint" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="52dp"
                            android:background="?attr/colorDivider" />

                        <!-- 语音合成模型 -->
                        <LinearLayout
                            android:id="@+id/row_tts_model"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/size_48"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/space_14"
                            android:paddingEnd="@dimen/space_10"
                            android:paddingVertical="@dimen/space_10"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="@dimen/size_24"
                                android:layout_height="@dimen/size_24"
                                android:src="@drawable/ic_speaker"
                                android:contentDescription="@null"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/space_12"
                                android:text="语音合成"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorControlText" />

                            <TextView
                                android:id="@+id/tv_tts_model_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:maxWidth="180dp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="自动选择"
                                android:textSize="@dimen/text_13"
                                android:textColor="?attr/colorControlTextSecondary" />

                            <ImageView
                                android:layout_width="@dimen/size_16"
                                android:layout_height="@dimen/size_16"
                                android:layout_marginStart="@dimen/space_6"
                                android:src="@drawable/ic_chevron_right"
                                android:contentDescription="@null"
                                app:tint="?attr/colorControlTextHint" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="52dp"
                            android:background="?attr/colorDivider" />

                        <!-- TTS 音色 -->
                        <LinearLayout
                            android:id="@+id/row_tts_voice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/size_48"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/space_14"
                            android:paddingEnd="@dimen/space_10"
                            android:paddingVertical="@dimen/space_10"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="@dimen/size_24"
                                android:layout_height="@dimen/size_24"
                                android:src="@drawable/ic_speaker"
                                android:contentDescription="@null"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="@dimen/size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/space_12"
                                android:text="合成音色"
                                android:textSize="@dimen/text_14"
                                android:textColor="?attr/colorControlText" />

                            <TextView
                                android:id="@+id/tv_tts_voice_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:maxWidth="180dp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="自动（模型默认）"
                                android:textSize="@dimen/text_13"
                                android:textColor="?attr/colorControlTextSecondary" />

                            <ImageView
                                android:layout_width="@dimen/size_16"
                                android:layout_height="@dimen/size_16"
                                android:layout_marginStart="@dimen/space_6"
                                android:src="@drawable/ic_chevron_right"
                                android:contentDescription="@null"
                                app:tint="?attr/colorControlTextHint" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 本地模型区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_section_header"
                        android:paddingHorizontal="@dimen/space_10"
                        android:paddingVertical="@dimen/space_4"
                        android:text="本地模型"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText"/>
                    <Space
                        android:layout_width="@dimen/size_0"
                        android:layout_height="1dp"
                        android:layout_weight="1" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/import_local_model_button"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/size_36"
                        android:text="+ 导入"
                        app:backgroundTint="?attr/colorPrimary"
                        android:textColor="?attr/colorOnPrimary"
                        app:cornerRadius="@dimen/radius_8"
                        android:textAllCaps="false"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/models_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <TextView
                    android:id="@+id/local_models_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:padding="@dimen/space_16"
                    android:gravity="center"
                    android:text="暂无本地模型，点击右上角“+ 导入”导入模型文件"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorControlTextHint"
                    android:background="@drawable/empty_bg_dashed"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_16"
        android:background="?attr/colorSurface"
        android:elevation="@dimen/elev_8">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_48"
            android:text="刷新"
            app:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false"/>
    </LinearLayout>

</LinearLayout>