<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground"
    tools:context=".ui.activity.ModelSelectorActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/elev_0"
        android:background="?attr/colorSurface">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:title="模型选择"
            app:titleTextColor="?attr/colorControlText"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 在线服务状态栏 -->
    <LinearLayout
        android:id="@+id/service_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="?attr/colorSurfaceVariant"
        android:visibility="gone">
        <View
            android:id="@+id/status_indicator"
            android:layout_width="@dimen/size_8"
            android:layout_height="@dimen/size_8"
            android:background="@drawable/status_indicator_unknown"/>
        <TextView
            android:id="@+id/tv_service_status"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_8"
            android:text="在线服务状态"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorControlTextSecondary"/>
        <TextView
            android:id="@+id/tv_usage_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="@dimen/text_11"
            android:textColor="?attr/colorControlTextHint"/>
    </LinearLayout>

    <!-- 当前模型信息卡片 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_16"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="?attr/colorSurface">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="当前模型"
                android:textSize="@dimen/text_14"
                android:textColor="?attr/colorControlTextSecondary"
                android:layout_marginBottom="@dimen/space_4"/>
            <TextView
                android:id="@+id/current_model_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未选择模型"
                android:textSize="@dimen/text_16"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="@dimen/space_4"/>
            <TextView
                android:id="@+id/current_model_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="类型: 未知"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlTextHint"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- AI 服务一键初始化：本地与在线模型均未配置时显示 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/ai_init_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_4"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/colorPrimaryContainer">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="一键初始化 AI 服务"
                android:textSize="@dimen/text_15"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="@dimen/space_4"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="尚未配置本地与在线模型。点击自动下载默认模型并初始化本地模型服务，离线即可使用。"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlTextSecondary"
                android:layout_marginBottom="@dimen/space_12"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ai_init"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_36"
                android:text="一键初始化"
                app:backgroundTint="?attr/colorPrimary"
                android:textColor="?attr/colorOnPrimary"
                app:cornerRadius="@dimen/radius_8"
                android:textAllCaps="false"
                android:textSize="@dimen/text_14"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <!-- 在线模型区域 -->
            <LinearLayout
                android:id="@+id/online_models_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="在线模型"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_online_model_button"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/size_36"
                        android:text="+ 添加"
                        app:backgroundTint="?attr/colorPrimary"
                        android:textColor="?attr/colorOnPrimary"
                        app:cornerRadius="@dimen/radius_8"
                        android:textAllCaps="false"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_api_config"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/size_36"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="API配置"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        android:textColor="?attr/colorPrimary"
                        app:cornerRadius="@dimen/radius_8"
                        android:textAllCaps="false"
                        android:textSize="@dimen/text_12"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/online_models_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <TextView
                    android:id="@+id/online_models_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:padding="@dimen/space_16"
                    android:gravity="center"
                    android:text="暂无在线模型，点击右上角“+ 添加”配置 API"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorControlTextHint"
                    android:background="@drawable/empty_bg_dashed"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- 功能专用模型区域（语音识别/语音合成） -->
            <LinearLayout
                android:id="@+id/feature_models_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="@dimen/space_16">
                <LinearLayout
                    android:id="@+id/row_feature_models_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp"
                    android:paddingStart="@dimen/space_4"
                    android:paddingEnd="@dimen/space_4"
                    android:background="?attr/selectableItemBackground">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="功能专用模型"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="为语音等功能指定专用在线模型，不配置则自动选择"
                    android:textSize="@dimen/text_11"
                    android:textColor="?attr/colorControlTextHint"/>

                <!-- 语音识别模型 -->
                <LinearLayout
                    android:id="@+id/row_asr_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/space_10"
                    android:padding="@dimen/space_14"
                    android:background="?attr/selectableItemBackground">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎙️ 语音识别模型"
                        android:textSize="@dimen/text_14"
                        android:textColor="?attr/colorControlText"/>
                    <TextView
                        android:id="@+id/tv_asr_model_value"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_8"
                        android:gravity="end"
                        android:text="自动选择"
                        android:textSize="@dimen/text_13"
                        android:textColor="?attr/colorPrimary"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <!-- 语音合成模型 -->
                <LinearLayout
                    android:id="@+id/row_tts_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/space_4"
                    android:padding="@dimen/space_14"
                    android:background="?attr/selectableItemBackground">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔊 语音合成模型"
                        android:textSize="@dimen/text_14"
                        android:textColor="?attr/colorControlText"/>
                    <TextView
                        android:id="@+id/tv_tts_model_value"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_8"
                        android:gravity="end"
                        android:text="自动选择"
                        android:textSize="@dimen/text_13"
                        android:textColor="?attr/colorPrimary"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <!-- TTS 音色 -->
                <LinearLayout
                    android:id="@+id/row_tts_voice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/space_4"
                    android:padding="@dimen/space_14"
                    android:background="?attr/selectableItemBackground">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎵 语音合成音色"
                        android:textSize="@dimen/text_14"
                        android:textColor="?attr/colorControlText"/>
                    <TextView
                        android:id="@+id/tv_tts_voice_value"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_8"
                        android:gravity="end"
                        android:text="alloy（默认）"
                        android:textSize="@dimen/text_13"
                        android:textColor="?attr/colorPrimary"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 本地模型区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="本地模型"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/import_local_model_button"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/size_36"
                        android:text="+ 导入"
                        app:backgroundTint="?attr/colorPrimary"
                        android:textColor="?attr/colorOnPrimary"
                        app:cornerRadius="@dimen/radius_8"
                        android:textAllCaps="false"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/models_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <TextView
                    android:id="@+id/local_models_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:padding="@dimen/space_16"
                    android:gravity="center"
                    android:text="暂无本地模型，点击右上角“+ 导入”导入模型文件"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorControlTextHint"
                    android:background="@drawable/empty_bg_dashed"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_16"
        android:background="?attr/colorSurface"
        android:elevation="@dimen/elev_8">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_48"
            android:text="刷新"
            app:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary"
            app:cornerRadius="@dimen/radius_12"
            android:textAllCaps="false"/>
    </LinearLayout>

</LinearLayout>