<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".ui.activity.ModelSelectorActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        android:background="@color/surface">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:title="模型选择"
            app:titleTextColor="@color/text_primary"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 在线服务状态栏 -->
    <LinearLayout
        android:id="@+id/service_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@color/surface_variant"
        android:visibility="gone">
        <View
            android:id="@+id/status_indicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/status_indicator_unknown"/>
        <TextView
            android:id="@+id/tv_service_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="在线服务状态"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"/>
        <TextView
            android:id="@+id/tv_usage_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/text_tertiary"/>
    </LinearLayout>

    <!-- 当前模型信息卡片 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/surface">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="当前模型"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/current_model_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未选择模型"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/current_model_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="类型: 未知"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <!-- 在线模型区域 -->
            <LinearLayout
                android:id="@+id/online_models_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="在线模型"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_online_model_button"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="+ 添加"
                        app:backgroundTint="@color/primary"
                        android:textColor="@color/on_primary"
                        app:cornerRadius="8dp"
                        android:textAllCaps="false"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_api_config"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:text="API配置"
                        app:backgroundTint="@color/surface_variant"
                        android:textColor="@color/primary"
                        app:cornerRadius="8dp"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/online_models_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <TextView
                    android:id="@+id/online_models_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:gravity="center"
                    android:text="暂无在线模型，点击右上角“+ 添加”配置 API"
                    android:textSize="12sp"
                    android:textColor="@color/text_tertiary"
                    android:background="@drawable/empty_bg_dashed"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- 功能专用模型区域（语音识别/语音合成） -->
            <LinearLayout
                android:id="@+id/feature_models_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp">
                <LinearLayout
                    android:id="@+id/row_feature_models_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:background="?attr/selectableItemBackground">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="功能专用模型"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="为语音等功能指定专用在线模型，不配置则自动选择"
                    android:textSize="11sp"
                    android:textColor="@color/text_tertiary"/>

                <!-- 语音识别模型 -->
                <LinearLayout
                    android:id="@+id/row_asr_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp"
                    android:padding="14dp"
                    android:background="?attr/selectableItemBackground">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎙️ 语音识别模型"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>
                    <TextView
                        android:id="@+id/tv_asr_model_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:text="自动选择"
                        android:textSize="13sp"
                        android:textColor="@color/primary"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <!-- 语音合成模型 -->
                <LinearLayout
                    android:id="@+id/row_tts_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:padding="14dp"
                    android:background="?attr/selectableItemBackground">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔊 语音合成模型"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>
                    <TextView
                        android:id="@+id/tv_tts_model_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:text="自动选择"
                        android:textSize="13sp"
                        android:textColor="@color/primary"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <!-- TTS 音色 -->
                <LinearLayout
                    android:id="@+id/row_tts_voice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:padding="14dp"
                    android:background="?attr/selectableItemBackground">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎵 语音合成音色"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>
                    <TextView
                        android:id="@+id/tv_tts_voice_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:text="alloy（默认）"
                        android:textSize="13sp"
                        android:textColor="@color/primary"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 本地模型区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="本地模型"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/import_local_model_button"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="+ 导入"
                        app:backgroundTint="@color/primary"
                        android:textColor="@color/on_primary"
                        app:cornerRadius="8dp"
                        android:textAllCaps="false"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/models_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <TextView
                    android:id="@+id/local_models_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:gravity="center"
                    android:text="暂无本地模型，点击右上角“+ 导入”导入模型文件"
                    android:textSize="12sp"
                    android:textColor="@color/text_tertiary"
                    android:background="@drawable/empty_bg_dashed"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/surface"
        android:elevation="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="刷新"
            app:backgroundTint="@color/primary"
            android:textColor="@color/on_primary"
            app:cornerRadius="12dp"
            android:textAllCaps="false"/>
    </LinearLayout>

</LinearLayout>