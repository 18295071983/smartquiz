<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="一键准备 · 执行监控"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorControlText"/>

    <TextView
        android:id="@+id/monitor_steps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:textSize="13sp"
        android:textColor="?attr/colorControlTextSecondary"
        android:text="等待 Termux 输出…"/>

    <TextView
        android:id="@+id/monitor_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:textSize="12sp"
        android:textColor="?attr/colorControlTextHint"
        android:text=""/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="?attr/colorControlTextHint"
        android:alpha="0.15"/>

    <TextView
        android:id="@+id/monitor_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:lineSpacingExtra="3dp"
        android:textSize="12sp"
        android:textColor="?attr/colorControlTextSecondary"
        android:scrollbars="vertical"
        android:text="正在连接 Termux…"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_monitor_stop"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:text="停止监控（Termux 里继续执行）"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:textColor="?attr/colorOnSecondaryContainer"
        app:backgroundTint="?attr/colorSecondaryContainer"
        app:cornerRadius="22dp"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>
</LinearLayout>
