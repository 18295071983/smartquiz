<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".ui.activity.QuestionGenerateActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/elev_0">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:title="题目生成"
            app:titleTextColor="@color/text_primary"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:fillViewport="true">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">
            
            <!-- 欢迎卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/primary_container"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="@dimen/space_20">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_20">
                    
                    <ImageView
                        android:layout_width="@dimen/size_48"
                        android:layout_height="@dimen/size_48"
                        android:src="@drawable/ic_analyze"
                        android:tint="@color/on_primary_container"
                        android:layout_marginEnd="@dimen/space_16" />
                    
                    <LinearLayout
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI题目生成"
                            android:textSize="@dimen/text_18"
                            android:textStyle="bold"
                            android:textColor="@color/on_primary_container"
                            android:layout_marginBottom="@dimen/space_4" />
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="使用AI智能生成题目"
                            android:textSize="@dimen/text_14"
                            android:textColor="@color/on_primary_container" />
                        
                    </LinearLayout>
                    
                </LinearLayout>
                
            </com.google.android.material.card.MaterialCardView>
            
            <!-- 生成设置 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="@dimen/space_20">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="生成设置"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/space_16" />
                    
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="题目数量"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeWidth="2dp"
                        app:boxStrokeColor="@color/outline"
                        app:hintTextColor="@color/primary"
                        android:layout_marginBottom="@dimen/space_12">
                        
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_question_count"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_16"
                            android:textColor="@color/text_primary"
                            android:inputType="number" />
                        
                    </com.google.android.material.textfield.TextInputLayout>
                    
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="主题/关键词"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeWidth="2dp"
                        app:boxStrokeColor="@color/outline"
                        app:hintTextColor="@color/primary"
                        android:layout_marginBottom="@dimen/space_12">
                        
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_topic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_16"
                            android:textColor="@color/text_primary" />
                        
                    </com.google.android.material.textfield.TextInputLayout>
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/space_12">
                        
                        <TextView
                            android:layout_width="@dimen/size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="题目类型"
                            android:textSize="@dimen/text_14"
                            android:textColor="@color/text_primary" />
                        
                        <Spinner
                            android:id="@+id/type_spinner"
                            android:layout_width="@dimen/size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_spinner"
                            android:padding="@dimen/space_12" />
                        
                    </LinearLayout>
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        
                        <TextView
                            android:layout_width="@dimen/size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="难度等级"
                            android:textSize="@dimen/text_14"
                            android:textColor="@color/text_primary" />
                        
                        <Spinner
                            android:id="@+id/difficulty_spinner"
                            android:layout_width="@dimen/size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_spinner"
                            android:padding="@dimen/space_12" />
                        
                    </LinearLayout>
                    
                </LinearLayout>
                
            </com.google.android.material.card.MaterialCardView>
            
            <!-- 模型选择 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="@dimen/space_20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI模型"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/space_12" />

                    <RadioGroup
                        android:id="@+id/rg_model_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/space_12">

                        <RadioButton
                            android:id="@+id/rb_local_model"
                            android:layout_width="@dimen/size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="本地模型"
                            android:textSize="@dimen/text_14"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rb_online_model"
                            android:layout_width="@dimen/size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="在线模型"
                            android:textSize="@dimen/text_14" />

                    </RadioGroup>

                    <!-- 在线服务状态 -->
                    <LinearLayout
                        android:id="@+id/ll_online_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="@dimen/space_8"
                        android:background="@drawable/rounded_card"
                        android:layout_marginBottom="@dimen/space_12"
                        android:visibility="gone">

                        <View
                            android:id="@+id/status_indicator"
                            android:layout_width="@dimen/size_10"
                            android:layout_height="@dimen/size_10"
                            android:background="@drawable/status_indicator_unknown"
                            android:layout_marginEnd="@dimen/space_8" />

                        <TextView
                            android:id="@+id/tv_online_status"
                            android:layout_width="@dimen/size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="在线服务状态"
                            android:textSize="@dimen/text_12"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tv_usage_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="@dimen/text_11"
                            android:textColor="@color/text_tertiary" />

                    </LinearLayout>

                    <!-- 模型选择下拉框 -->
                    <Spinner
                        android:id="@+id/spinner_model"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_48"
                        android:background="@drawable/rounded_spinner"
                        android:padding="@dimen/space_12" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 高级设置 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="@dimen/space_20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="高级设置"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/space_16" />
                    
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_120"
                        android:hint="自定义提示词"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeWidth="2dp"
                        app:boxStrokeColor="@color/outline"
                        app:hintTextColor="@color/primary"
                        android:layout_marginBottom="@dimen/space_12">
                        
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_custom_prompt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:textSize="@dimen/text_14"
                            android:textColor="@color/text_primary"
                            android:inputType="textMultiLine|textCapSentences"
                            android:gravity="top" />
                        
                    </com.google.android.material.textfield.TextInputLayout>
                    
                </LinearLayout>
                
            </com.google.android.material.card.MaterialCardView>
            
        </LinearLayout>
        
    </ScrollView>

    <!-- 底部操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16"
        android:background="@color/surface"
        android:elevation="@dimen/elev_8">
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_generate_questions"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_56"
            android:text="生成题目"
            android:textSize="@dimen/text_16"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/radius_12" />
        
    </LinearLayout>

    <!-- 生成结果容器 -->
    <LinearLayout
        android:id="@+id/result_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/space_16"
        android:visibility="gone">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="生成结果"
            android:textSize="@dimen/text_18"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/space_16" />
        
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_generated_questions"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_0"
            android:layout_weight="1"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        
    </LinearLayout>

    <!-- 操作按钮容器 -->
    <LinearLayout
        android:id="@+id/actions_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_16"
        android:background="@color/surface"
        android:elevation="@dimen/elev_8"
        android:visibility="gone">
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_48"
            android:layout_weight="1"
            android:text="保存"
            android:textSize="@dimen/text_14"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/radius_12"
            android:layout_marginEnd="@dimen/space_8" />
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_48"
            android:layout_weight="1"
            android:text="分享"
            android:textSize="@dimen/text_14"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/on_secondary"
            app:backgroundTint="@color/secondary"
            app:cornerRadius="@dimen/radius_12"
            android:layout_marginEnd="@dimen/space_8" />
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_export"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_48"
            android:layout_weight="1"
            android:text="导出"
            android:textSize="@dimen/text_14"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/on_tertiary"
            app:backgroundTint="@color/tertiary"
            app:cornerRadius="@dimen/radius_12" />
        
    </LinearLayout>

</LinearLayout>