<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="14dp"
    android:layout_marginBottom="1dp">

    <!-- 第一行：题号 + 题目信息 + 操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 左侧：题号 -->
        <TextView
            android:id="@+id/questionNumberTextView"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/question_number_bg"
            android:gravity="center"
            android:layout_marginEnd="12dp"/>

        <!-- 中间：题目信息 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/questionTypeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="单选"
                    android:textSize="10sp"
                    android:textColor="@color/primary"
                    android:background="@drawable/question_type_tag_bg"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/difficultyTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="中等"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"/>
            </LinearLayout>

            <TextView
                android:id="@+id/questionTextTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="题目内容"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/categoryTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="默认"
                android:textSize="11sp"
                android:textColor="@color/text_tertiary"/>
        </LinearLayout>

        <!-- 右侧：操作按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_favorite"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:icon="@android:drawable/btn_star_big_off"
                app:iconTint="@color/tertiary"
                app:iconGravity="textStart"
                app:backgroundTint="@android:color/transparent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="@color/error"
                app:iconGravity="textStart"
                app:backgroundTint="@android:color/transparent"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 答案区域（默认隐藏，由适配器控制显示） -->
    <TextView
        android:id="@+id/answerTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/success"
        android:background="@color/success_container"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

    <!-- 解析区域（默认隐藏） -->
    <TextView
        android:id="@+id/explanationTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:background="@drawable/explanation_bg"
        android:padding="8dp"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:visibility="gone"/>

</LinearLayout>
