<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:padding="@dimen/space_14"
    android:layout_marginBottom="@dimen/space_1">

    <!-- 第一行：题号 + 题目信息 + 操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 左侧：题号 -->
        <TextView
            android:id="@+id/questionNumberTextView"
            android:layout_width="@dimen/size_28"
            android:layout_height="@dimen/size_28"
            android:text="1"
            android:textSize="@dimen/text_13"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:background="@drawable/question_number_bg"
            android:gravity="center"
            android:layout_marginEnd="@dimen/space_12"/>

        <!-- 中间：题目信息 -->
        <LinearLayout
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/space_4">

                <TextView
                    android:id="@+id/questionTypeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="单选"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorPrimary"
                    android:background="@drawable/question_type_tag_bg"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="@dimen/space_8"/>

                <TextView
                    android:id="@+id/difficultyTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="中等"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorControlTextHint"/>
            </LinearLayout>

            <TextView
                android:id="@+id/questionTextTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="题目内容"
                android:textSize="@dimen/text_14"
                android:textColor="?attr/colorControlText"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="@dimen/space_4"/>

            <TextView
                android:id="@+id/categoryTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="默认"
                android:textSize="@dimen/text_11"
                android:textColor="?attr/colorControlTextHint"/>
        </LinearLayout>

        <!-- 右侧：操作按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="@dimen/space_8">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_favorite"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="@dimen/size_36"
                android:layout_height="@dimen/size_36"
                app:icon="@android:drawable/btn_star_big_off"
                app:iconTint="@color/tertiary"
                app:iconGravity="textStart"
                app:backgroundTint="@android:color/transparent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="@dimen/size_36"
                android:layout_height="@dimen/size_36"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="@color/error"
                app:iconGravity="textStart"
                app:backgroundTint="@android:color/transparent"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 答案区域（默认隐藏，由适配器控制显示） -->
    <TextView
        android:id="@+id/answerTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_13"
        android:textColor="@color/success"
        android:background="@color/success_container"
        android:padding="@dimen/space_8"
        android:layout_marginTop="@dimen/space_8"
        android:visibility="gone"/>

    <!-- 解析区域（默认隐藏） -->
    <TextView
        android:id="@+id/explanationTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_12"
        android:textColor="?attr/colorControlTextSecondary"
        android:background="@drawable/explanation_bg"
        android:padding="@dimen/space_8"
        android:layout_marginTop="@dimen/space_4"
        android:lineSpacingExtra="2dp"
        android:visibility="gone"/>

</LinearLayout>
