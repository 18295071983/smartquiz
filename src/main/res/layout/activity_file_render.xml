<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    tools:context=".ui.activity.FileRenderActivity">

    <!-- 顶部工具栏：与文档预览一致的 MaterialToolbar + 返回箭头 -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/elev_0">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="文件预览"
            app:titleTextColor="?attr/colorOnSurface"
            app:subtitleTextColor="?attr/colorOnSurfaceVariant"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 内容区：居中展示渲染内容，加载/错误为叠加层（与文档预览一致） -->
    <FrameLayout
        android:id="@+id/content_area"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:background="@color/lo_page_bg">

        <!-- 渲染内容容器（图片/文本/HTML/视频） -->
        <LinearLayout
            android:id="@+id/content_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.github.chrisbanes.photoview.PhotoView
                android:id="@+id/iv_image"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_0"
                android:layout_weight="1"
                android:contentDescription="渲染内容"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_text"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_0"
                android:layout_weight="1"
                android:padding="@dimen/space_16"
                android:text="文本内容"
                android:textSize="@dimen/text_14"
                android:lineSpacingExtra="2dp"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone"/>

            <WebView
                android:id="@+id/wv_html"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_0"
                android:layout_weight="1"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- 加载态叠加层 -->
        <LinearLayout
            android:id="@+id/loading_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_24"
            android:background="@color/lo_page_bg"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progress_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressTint="?attr/colorPrimary"
                android:layout_marginHorizontal="@dimen/space_40"
                android:layout_marginBottom="@dimen/space_16"/>

            <TextView
                android:id="@+id/tv_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加载中..."
                android:textSize="@dimen/text_15"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="@dimen/space_8"/>

            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="@dimen/text_13"
                android:textColor="?attr/colorOnSurfaceVariant"/>
        </LinearLayout>

        <!-- 错误态叠加层 -->
        <LinearLayout
            android:id="@+id/error_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_24"
            android:background="@color/lo_page_bg"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_error_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="预览失败"
                android:textSize="@dimen/text_18"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="@dimen/space_8"/>

            <TextView
                android:id="@+id/tv_error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="无法预览此文件"
                android:textSize="@dimen/text_14"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="@dimen/space_20"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="重试"
                android:textAllCaps="false"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="@dimen/radius_12"/>
        </LinearLayout>
    </FrameLayout>

    <!-- 底部操作栏：分享 / 用其他应用打开（与文档预览底部按钮风格一致） -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_12"
        android:gravity="center_vertical"
        android:background="?attr/colorSurface"
        android:elevation="@dimen/elev_8">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_8"
            android:text="分享"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/radius_12"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_with"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="用其他应用打开"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/radius_12"/>
    </LinearLayout>

</LinearLayout>
