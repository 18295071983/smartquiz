<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A2E">

    <!-- 顶部标题栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#16213E"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="返回" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="JWT 认证测试"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_run_all"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:text="全部测试"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- JWT 配置信息卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#232945"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JWT 配置"
                    android:textColor="#90CAF9"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_config"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B0BEC5"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp" />

                <Button
                    android:id="@+id/btn_generate_token"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:text="生成 / 刷新 JWT Token"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:background="#2D5BFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Token:"
                    android:textColor="#90CAF9"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_token"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="未生成"
                    android:textColor="#FFD54F"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:background="#1A1A2E"
                    android:padding="8dp"
                    android:maxLines="6"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- 测试位置输入卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#232945"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="测试位置"
                    android:textColor="#90CAF9"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="经度,纬度:"
                        android:textColor="#B0BEC5"
                        android:textSize="12sp"
                        android:layout_gravity="center_vertical" />

                    <EditText
                        android:id="@+id/et_location"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:hint="经度,纬度"
                        android:textColorHint="#546E7A"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:background="#1A1A2E"
                        android:paddingHorizontal="8dp"
                        android:inputType="text"
                        android:singleLine="true" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动读取上次定位，格式：经度,纬度（逗号分隔）"
                    android:textColor="#78909C"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- API 测试结果列表 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API 端点测试"
                android:textColor="#90CAF9"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layout_api_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
