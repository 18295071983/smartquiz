<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_20">

    <!-- 检测到的格式 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_16">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="检测格式: "
            android:textSize="@dimen/text_14"
            android:textColor="?attr/colorControlTextSecondary"/>

        <TextView
            android:id="@+id/tv_detected_format"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JSON"
            android:textSize="@dimen/text_14"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"/>

        <View
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_0"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tv_config_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="检测到 0 个配置"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorControlTextHint"/>
    </LinearLayout>

    <!-- 配置列表 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="检测到的配置"
        android:textSize="@dimen/text_14"
        android:textStyle="bold"
        android:textColor="?attr/colorControlText"
        android:layout_marginBottom="@dimen/space_8"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:minHeight="@dimen/min_150"
        android:maxHeight="@dimen/max_300"
        android:layout_marginBottom="@dimen/space_16">

        <RadioGroup
            android:id="@+id/rg_configs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 配置项会动态添加 -->

        </RadioGroup>
    </ScrollView>

    <!-- 无配置提示 -->
    <LinearLayout
        android:id="@+id/ll_no_config"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/space_24"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未检测到有效配置"
            android:textSize="@dimen/text_16"
            android:textColor="?attr/colorControlTextSecondary"/>

        <TextView
            android:id="@+id/tv_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text=""
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorControlTextHint"/>
    </LinearLayout>

    <!-- 预览详情 -->
    <LinearLayout
        android:id="@+id/ll_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_12"
        android:background="@drawable/rounded_card"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="配置详情"
            android:textSize="@dimen/text_14"
            android:textStyle="bold"
            android:textColor="?attr/colorControlText"
            android:layout_marginBottom="@dimen/space_12"/>

        <!-- 服务类型 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_8">

            <TextView
                android:layout_width="@dimen/size_80"
                android:layout_height="wrap_content"
                android:text="服务类型"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlTextHint"/>

            <TextView
                android:id="@+id/tv_preview_service_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlText"/>
        </LinearLayout>

        <!-- API Key -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_8">

            <TextView
                android:layout_width="@dimen/size_80"
                android:layout_height="wrap_content"
                android:text="API Key"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlTextHint"/>

            <TextView
                android:id="@+id/tv_preview_api_key"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlText"/>
        </LinearLayout>

        <!-- API Host -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_8">

            <TextView
                android:layout_width="@dimen/size_80"
                android:layout_height="wrap_content"
                android:text="API 地址"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlTextHint"/>

            <TextView
                android:id="@+id/tv_preview_api_host"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlText"/>
        </LinearLayout>

        <!-- 模型名称 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/size_80"
                android:layout_height="wrap_content"
                android:text="默认模型"
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlTextHint"/>

            <TextView
                android:id="@+id/tv_preview_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/text_12"
                android:textColor="?attr/colorControlText"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>