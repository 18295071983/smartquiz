<?xml version="1.0" encoding="utf-8"?>
<!-- Agent 步骤消息 v2：控件 id 与 item_agent_step_message.xml 一致，AgentStepViewHolder 不需要分支。
     换掉的是壁纸专用的 #E8FFFFFF / #B3FFFFFF（在纯色底上会看不见）。
     step_icon 仍是 TextView：ViewHolder 会往里 setText(emoji)，改成 ImageView 会 ClassCastException，
     图标去 emoji 属于 B2 的无障碍/图标统一范围。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_12"
    android:paddingEnd="@dimen/space_12"
    android:paddingTop="@dimen/space_6"
    android:paddingBottom="@dimen/space_6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/step_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_8"
            android:textSize="@dimen/text_16" />

        <TextView
            android:id="@+id/step_description"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/chat_v2_text"
            android:textSize="@dimen/text_14" />

        <TextView
            android:id="@+id/step_reasoning_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:background="@drawable/chat_v2_mode_on"
            android:paddingStart="@dimen/space_6"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_6"
            android:paddingBottom="@dimen/space_2"
            android:textColor="@color/chat_v2_brand_ink"
            android:textSize="@dimen/chat_v2_status_text"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/step_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="@dimen/space_4"
        android:textColor="@color/chat_v2_text_2"
        android:textSize="@dimen/text_13"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/step_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_2"
        android:layout_marginTop="@dimen/space_4"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/agent_step_progress"
        android:visibility="gone" />

</LinearLayout>
