<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_full"
    android:fillViewport="true"
    android:overScrollMode="always"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_32">

        <!-- ==================== 顶部问候区（仿天气详情页主温度区） ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_36"
            android:paddingBottom="@dimen/space_20"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/white_alpha_80"
                android:textSize="@dimen/text_13"
                android:alpha="0.9" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/welcome_back"
                android:textColor="@color/future_text_primary"
                android:textSize="@dimen/text_30"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/start_learning_today"
                android:textColor="@color/future_text_tertiary"
                android:textSize="@dimen/text_14" />

            <!-- 统计卡行（玻璃拟态） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_6"
                    android:layout_weight="1"
                    android:background="@drawable/weather_card_glass"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/tvQuestionCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_question_count"
                        android:textColor="@color/future_text_primary"
                        android:textSize="@dimen/text_28"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/question_bank_info"
                        android:textColor="@color/future_text_tertiary"
                        android:textSize="@dimen/text_12" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:layout_weight="1"
                    android:background="@drawable/weather_card_glass"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/tvAiStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/default_ai_status"
                        android:textColor="@color/future_text_primary"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/status"
                        android:textColor="@color/future_text_tertiary"
                        android:textSize="@dimen/text_12" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ==================== 天气横幅 ==================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_weather_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_16"
            android:layout_marginBottom="@dimen/space_18"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <com.oilquiz.app.ui.widget.WeatherBannerView
                android:id="@+id/weather_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/weather_banner_background"
                app:autoLoad="true"
                app:defaultCity="银川" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== 学习区 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_16"
            android:orientation="vertical">

            <!-- 分区标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/space_10">

                <TextView
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/core_features"
                    android:textColor="@color/future_text_primary"
                    android:textSize="@dimen/text_15"
                    android:textStyle="bold"
                    android:alpha="0.9" />

                <View
                    android:layout_width="@dimen/size_10"
                    android:layout_height="@dimen/size_10"
                    android:background="@drawable/bg_dot_violet" />

            </LinearLayout>

            <!-- 第一行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_10"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btn_question"
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_5"
                    android:layout_weight="1"

                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_14">

                    <ImageView
                        android:layout_width="@dimen/size_56"
                        android:layout_height="@dimen/size_56"
                        android:src="@drawable/ic_home_question" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/question_management"
                        android:textColor="@color/future_text_primary"
                        android:textSize="@dimen/text_13"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_quiz"
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_5"
                    android:layout_weight="1"

                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_14">

                    <ImageView
                        android:layout_width="@dimen/size_56"
                        android:layout_height="@dimen/size_56"
                        android:src="@drawable/ic_home_quiz" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/start_quiz"
                        android:textColor="@color/future_text_primary"
                        android:textSize="@dimen/text_13"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ==================== AI 智能区 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_16"
            android:layout_marginTop="@dimen/space_14"
            android:orientation="vertical">

            <!-- 分区标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/space_10">

                <TextView
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/smart_features"
                    android:textColor="@color/future_text_primary"
                    android:textSize="@dimen/text_15"
                    android:textStyle="bold"
                    android:alpha="0.9" />

                <View
                    android:layout_width="@dimen/size_10"
                    android:layout_height="@dimen/size_10"
                    android:background="@drawable/bg_dot_cyan" />

            </LinearLayout>

            <!-- AI 聊天（全宽重点卡，透明底） -->
            <LinearLayout
                android:id="@+id/btn_question_generate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_10"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_16">

                <ImageView
                    android:layout_width="@dimen/size_52"
                    android:layout_height="@dimen/size_52"
                    android:src="@drawable/ic_home_chat" />

                <LinearLayout
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_14"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_chat"
                        android:textColor="@color/future_text_primary"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="@string/start_learning_today"
                        android:textColor="@color/indigo_pale"
                        android:textSize="@dimen/text_12" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chevron_arrow"
                    android:textColor="@color/future_text_primary"
                    android:textSize="@dimen/text_28" />

            </LinearLayout>

        </LinearLayout>

        <!-- ==================== 更多功能区 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_16"
            android:layout_marginTop="@dimen/space_14"
            android:orientation="vertical">

            <!-- 分区标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/space_10">

                <TextView
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/more_features"
                    android:textColor="@color/future_text_primary"
                    android:textSize="@dimen/text_15"
                    android:textStyle="bold"
                    android:alpha="0.9" />

                <View
                    android:layout_width="@dimen/size_10"
                    android:layout_height="@dimen/size_10"
                    android:background="@drawable/bg_dot_amber" />

            </LinearLayout>

            <!-- 行1：导入导出 / 工具集 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btn_import_export"
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_5"
                    android:layout_weight="1"

                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_10">

                    <ImageView
                        android:layout_width="@dimen/size_40"
                        android:layout_height="@dimen/size_40"
                        android:src="@drawable/ic_home_exchange" />

                    <TextView
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_10"
                        android:layout_weight="1"
                        android:text="@string/import_export"
                        android:textColor="@color/future_text_primary"
                        android:textSize="@dimen/text_13"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_toolbox"
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_5"
                    android:layout_weight="1"

                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_10">

                    <ImageView
                        android:layout_width="@dimen/size_40"
                        android:layout_height="@dimen/size_40"
                        android:src="@drawable/ic_home_toolbox" />

                    <TextView
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_10"
                        android:layout_weight="1"
                        android:text="@string/toolkit"
                        android:textColor="@color/future_text_primary"
                        android:textSize="@dimen/text_13"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
