<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:fillViewport="true"
    tools:context=".ui.activity.AICenterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <!-- 在线服务状态卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_service_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorCardBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:rippleColor="@color/primary_alpha_20">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/space_16"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="@dimen/size_32"
                    android:layout_height="@dimen/size_32"
                    android:text="☁️"
                    android:textSize="@dimen/text_24"
                    android:gravity="center"/>
                <LinearLayout
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_12"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="在线服务状态"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText"/>
                    <TextView
                        android:id="@+id/tv_service_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="点击配置API服务"
                        android:textSize="@dimen/text_12"
                        android:textColor="?attr/colorControlTextSecondary"
                        android:layout_marginTop="@dimen/space_2"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="@dimen/size_24"
                    android:layout_height="@dimen/size_24"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorControlTextHint"
                    android:contentDescription="箭头"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 当前模型卡片（MODEL-HUB-ONE-PLACE 2026-11-02）
             原先这里是两张卡（在线模型 / 导入模型），各挂一份模型列表
             （online_models_recycler、models_recycler），与「模型」页、模型中心凑成三份同源列表；
             两张卡头部还各带一个开关 switch_online_mode / switch_local_mode，而它们的监听只做
             "互相取消勾选"——既不写偏好也不调路由（路由只看哪个模型激活，见 ROUTE-UNIFIED），
             属于"看着能换引擎、其实什么都换不了"的假开关。
             现在这张卡只回答"我现在用的是什么"，切换一律跳「模型」页：那一页本地与在线都能点选，
             也带添加在线模型 / 导入 / 下载 / 一键初始化 / 语音模型。 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_current_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardBackgroundColor="?attr/colorCardBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="@dimen/size_32"
                        android:layout_height="@dimen/size_32"
                        android:text="🧠"
                        android:textSize="@dimen/text_24"
                        android:gravity="center"/>
                    <TextView
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_12"
                        android:text="当前模型"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_current_model_engine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="引擎"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorControlTextSecondary"/>

                <TextView
                    android:id="@+id/tv_current_model_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="未选择模型"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"/>

                <TextView
                    android:id="@+id/tv_current_model_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/colorControlTextHint"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/space_12">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_go_model_page"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/space_4"
                        android:text="🔀 切换模型"
                        android:textSize="@dimen/text_12"
                        app:cornerRadius="@dimen/radius_8"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_download_local_models"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_4"
                        android:text="⬇️ 下载"
                        android:textSize="@dimen/text_12"
                        app:cornerRadius="@dimen/radius_8"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/space_8">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_manage_local_models"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/space_4"
                        android:text="📁 管理本地文件"
                        android:textSize="@dimen/text_12"
                        app:cornerRadius="@dimen/radius_8"/>

                    <!-- SAMPLING-PREFS(2026-11-01)：本地引擎采样参数入口（温度/top_p/top_k） -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_local_params"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_4"
                        android:text="🎛️ 参数"
                        android:textSize="@dimen/text_12"
                        app:cornerRadius="@dimen/radius_8"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Token 统计卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_token_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardBackgroundColor="?attr/colorCardBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📊 本次会话 Token 消耗"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorControlText"/>
                    <TextView
                        android:id="@+id/tv_token_cost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="约 ¥0.00"
                        android:textSize="@dimen/text_14"
                        android:textColor="?attr/colorPrimary"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                        android:text="输入"
                        android:textSize="@dimen/text_11"
                        android:textColor="?attr/colorControlTextSecondary"/>
                        <TextView
                            android:id="@+id/tv_input_tokens"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="@dimen/text_22"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginTop="@dimen/space_4"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="tokens"
                            android:textSize="@dimen/text_12"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:alpha="0.5"/>
                    </LinearLayout>

                    <View android:layout_width="@dimen/size_1"
                        android:layout_height="@dimen/size_40"
                        android:background="?attr/colorDivider"/>

                    <LinearLayout
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="输出"
                            android:textSize="@dimen/text_11"
                            android:textColor="?attr/colorControlTextSecondary"/>
                        <TextView
                            android:id="@+id/tv_output_tokens"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="@dimen/text_22"
                            android:textStyle="bold"
                            android:textColor="?attr/colorSecondary"
                            android:layout_marginTop="@dimen/space_4"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="tokens"
                            android:textSize="@dimen/text_12"
                            android:textColor="?attr/colorControlTextHint"/>
                    </LinearLayout>

                    <View android:layout_width="@dimen/size_1"
                        android:layout_height="@dimen/size_40"
                        android:background="?attr/colorOnPrimaryContainer"
                        android:alpha="0.2"/>

                    <LinearLayout
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="总计"
                            android:textSize="@dimen/text_11"
                            android:textColor="?attr/colorControlTextSecondary"/>
                        <TextView
                            android:id="@+id/tv_total_tokens"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="@dimen/text_22"
                            android:textStyle="bold"
                            android:textColor="@color/tertiary"
                            android:layout_marginTop="@dimen/space_4"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="tokens"
                            android:textSize="@dimen/text_12"
                            android:textColor="?attr/colorControlTextHint"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- AI功能卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardBackgroundColor="?attr/colorCardBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🤖 AI功能"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    android:textColor="?attr/colorControlText"
                    android:layout_marginBottom="@dimen/space_12"/>
                
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="3">
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_question_generator"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_4"
                        android:text="📝\n题目生成"
                        android:textSize="@dimen/text_11"
                        android:minLines="2"
                        app:cornerRadius="@dimen/radius_12"/>
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_question_analyzer"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_4"
                        android:text="🔍\n题目分析"
                        android:textSize="@dimen/text_11"
                        android:minLines="2"
                        app:cornerRadius="@dimen/radius_12"/>
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_learning_assistant"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_4"
                        android:text="👤\n学习助手"
                        android:textSize="@dimen/text_11"
                        android:minLines="2"
                        app:cornerRadius="@dimen/radius_12"/>
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_translator"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_4"
                        android:text="🌐\n翻译工具"
                        android:textSize="@dimen/text_11"
                        android:minLines="2"
                        app:cornerRadius="@dimen/radius_12"/>
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ai_chat"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_4"
                        android:text="💬\nAI聊天"
                        android:textSize="@dimen/text_11"
                        android:minLines="2"
                        app:cornerRadius="@dimen/radius_12"/>
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_icon_demo"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_4"
                        android:text="🎨\n图标演示"
                        android:textSize="@dimen/text_11"
                        android:minLines="2"
                        app:cornerRadius="@dimen/radius_12"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ai_image"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_4"
                        android:text="🖼️\nAI生图"
                        android:textSize="@dimen/text_11"
                        android:minLines="2"
                        app:cornerRadius="@dimen/radius_12"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ai_video"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_4"
                        android:text="🎬\nAI生视频"
                        android:textSize="@dimen/text_11"
                        android:minLines="2"
                        app:cornerRadius="@dimen/radius_12"/>
                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>