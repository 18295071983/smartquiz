<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        系统动态色 overlay（Material You）——**浅色档**（2026-11-16 拆 day/night）。

        历史问题：原来只有一份（values/），用的全是深色档的系统色
        （surface=system_neutral1_10、onSurface=system_neutral1_900），
        于是"浅色模式 + 系统动态色"实际上是黑底白字 —— 用户开了动态色却像开了暗色。
        现在：
        - 本文件（values/）   = 浅色档：surface 用中性色 900（近白），onSurface 用 10（近黑）；
        - values-night 同名文件 = 深色档：沿用原来的深色映射；
        - 语义色（成功/警告/危险/边框/图表）在两边都补齐，动态色下不再掉回写死色。

        资源只能用系统真实存在的档位（10/50/100/200/500/700/800/900/1000）。
    -->
    <style name="OilQuizDynamicOverlay">
        <item name="colorPrimary">@android:color/system_accent1_500</item>
        <item name="colorPrimaryVariant">@android:color/system_accent1_700</item>
        <item name="colorOnPrimary">@android:color/system_neutral1_10</item>
        <item name="colorPrimaryContainer">@android:color/system_accent1_100</item>
        <item name="colorOnPrimaryContainer">@android:color/system_accent1_900</item>
        <item name="colorSecondary">@android:color/system_accent2_500</item>
        <item name="colorSecondaryVariant">@android:color/system_accent2_700</item>
        <item name="colorOnSecondary">@android:color/system_neutral1_10</item>
        <item name="colorSecondaryContainer">@android:color/system_accent2_100</item>
        <item name="colorOnSecondaryContainer">@android:color/system_accent2_900</item>
        <item name="colorTertiary">@android:color/system_accent3_500</item>
        <item name="colorTertiaryContainer">@android:color/system_accent3_100</item>
        <item name="colorOnTertiaryContainer">@android:color/system_accent3_900</item>

        <item name="colorSurface">@android:color/system_neutral1_900</item>
        <item name="colorOnSurface">@android:color/system_neutral1_10</item>
        <item name="colorSurfaceVariant">@android:color/system_neutral2_200</item>
        <item name="colorOnSurfaceVariant">@android:color/system_neutral2_800</item>
        <item name="colorOutline">@android:color/system_neutral2_500</item>
        <item name="colorBackground">@android:color/system_neutral1_900</item>
        <item name="colorOnBackground">@android:color/system_neutral1_10</item>
        <item name="android:windowBackground">@android:color/system_neutral1_900</item>

        <item name="colorControlBackground">@android:color/system_neutral2_200</item>
        <item name="colorControlText">@android:color/system_neutral1_10</item>
        <item name="colorControlTextSecondary">@android:color/system_neutral2_800</item>
        <item name="colorControlTextHint">@android:color/system_neutral2_800</item>
        <item name="colorControlTextDisabled">@android:color/system_neutral2_500</item>
        <item name="colorCardBackground">@android:color/system_neutral1_900</item>
        <item name="colorOnCard">@android:color/system_neutral1_10</item>
        <item name="colorInputBackground">@android:color/system_neutral2_200</item>
        <item name="colorOnInput">@android:color/system_neutral1_10</item>
        <item name="colorDivider">@android:color/system_neutral2_500</item>
        <item name="colorAppBarBackground">@android:color/system_neutral1_900</item>
        <item name="colorOnAppBar">@android:color/system_neutral1_10</item>

        <item name="colorError">@android:color/system_error_light</item>
        <item name="colorOnError">@android:color/system_on_error_light</item>

        <!-- 2026-11-16 语义色补齐：动态色下也走系统色，不再掉回写死色 -->
        <item name="colorDanger">@android:color/system_error_light</item>
        <item name="colorOnDanger">@android:color/system_on_error_light</item>
        <item name="colorErrorContainer">@android:color/system_error_container_light</item>
        <item name="colorOnErrorContainer">@android:color/system_on_error_container_light</item>
        <item name="colorBorder">@android:color/system_neutral2_500</item>
        <item name="colorBorderStrong">@android:color/system_neutral2_800</item>
        <item name="colorScrim">#66000000</item>
        <item name="colorChart1">@android:color/system_accent1_500</item>
        <item name="colorChart2">@android:color/system_accent2_500</item>
        <item name="colorChart3">@android:color/system_accent3_500</item>
        <item name="colorChart4">@android:color/system_accent1_700</item>
        <item name="colorChart5">@android:color/system_accent2_700</item>
        <item name="colorChart6">@android:color/system_accent1_100</item>
        <item name="colorChart7">@android:color/system_accent2_100</item>
        <item name="colorChart8">@android:color/system_accent3_100</item>
    </style>
</resources>
