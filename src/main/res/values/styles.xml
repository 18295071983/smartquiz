    <!-- 对话框样式 -->
    <style name="ThemeOverlay.App.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <!-- edge-to-edge(targetSdk 36)：Dialog 窗口系统栏透明，底部跟随窗口背景（表面色），消除黑色块 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/surface</item>
        <!-- 2026-11-18：Dialog 自己也要给出 onSurface/onSurfaceVariant，
             否则以 ThemeOverlay 单独解析时 ?attr/colorOnSurfaceVariant 为 0，
             SwitchMaterial 的 colorControlNormal 跟着缺失。 -->
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Dialog</item>
            <!-- 控件色板（对话框档位）：控件底色 + 控件文字色 -->
        <item name="colorControlBackground">?attr/colorSurfaceVariant</item>
        <item name="colorControlText">?attr/colorOnSurface</item>
        <item name="colorControlTextSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="colorControlTextTertiary">@color/text_tertiary</item>
        <item name="colorControlTextHint">@color/text_hint</item>
        <item name="colorControlTextDisabled">@color/text_disabled</item>
        <!-- 2026-11-18：SwitchMaterial 强读这两个 attr；Dialog 以具体资源给值，
             避免 overlay 单独解析时 ?attr 嵌套解析不到（Robolectric 测试钉住）。 -->
        <item name="colorControlActivated">@color/primary</item>
        <item name="colorControlNormal">@color/on_surface_variant</item>
        <item name="colorCardBackground">?attr/colorSurface</item>
        <item name="colorOnCard">?attr/colorOnSurface</item>
        <item name="colorInputBackground">?attr/colorSurfaceVariant</item>
        <item name="colorOnInput">?attr/colorOnSurface</item>
        <item name="colorDivider">?attr/colorOutlineVariant</item>
        <item name="colorAppBarBackground">?attr/colorSurface</item>
        <item name="colorOnAppBar">?attr/colorOnSurface</item>
    <!-- 2026-11-16：首页壁纸自适应默认值（深色壁纸/关闭壁纸 = 白字 + 半透明白玻璃卡） -->
