<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- OilQuiz App 主题 -->
    <style name="Theme.OilQuizApp.Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_container</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <!-- edge-to-edge(targetSdk 36): 系统栏由应用绘制, 不设旧式着色层 -->
        <!-- targetSdk 36 (Android 16)：强制 edge-to-edge 不可退出，
             全部界面由 EdgeToEdgeHelper 真适配接管（decorFits=false +
             根容器 insets padding + 深浅图标）。 -->
        <item name="android:windowBackground">?attr/colorBackground</item>
        <!-- 2026-11-16：edge-to-edge 下 IME insets 需要 adjustResize 才会分发；
             全局统一，键盘弹出时由 EdgeToEdgeHelper 把内容整体上推 -->
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <!-- Material Design 3 兼容性属性 -->
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorTertiary">@color/tertiary</item>
        <!-- 2026-11-16：基础主题补 colorOnTertiary（之前只有 theme_overlays 里有，
             未注入 overlay 时 ?attr/colorOnTertiary 会解析不到 → 文字透明） -->
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <!-- 2026-11-18：colorOutline 回归 M3 语义（组件描边，tone 50），不再拿分隔线色（#E2E8F0）
             顶替——否则 Chip/输入框/日期选择器的描边淡到看不见；分隔线改用 colorOutlineVariant。 -->
        <item name="colorOutline">@color/outline_m3</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <!-- M3 surface container 五档（MDC 的日期/时间选择器、Chip、Card、Snackbar 都读这组 role） -->
        <item name="colorSurfaceContainerLowest">@color/surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <item name="colorSurfaceTint">?attr/colorPrimary</item>
        <!-- M3 inverse 三色（Snackbar/反色浮层用；缺了会退回默认紫） -->
        <item name="colorInverseSurface">@color/inverse_surface</item>
        <item name="colorInverseOnSurface">@color/inverse_on_surface</item>
        <item name="colorInversePrimary">@color/inverse_primary</item>
        <!-- 2026-11-18：层级 / 状态 / 语义容器（组件层统一入口） -->
        <item name="colorSurfaceDim">@color/surface_dim</item>
        <item name="colorSurfaceBright">@color/surface_bright</item>
        <item name="colorInfoContainer">@color/info_container</item>
        <item name="colorOnInfo">@color/on_info</item>
        <item name="colorOnInfoContainer">@color/on_info_container</item>
        <item name="colorOnSuccessContainer">@color/on_success_container</item>
        <item name="colorOnWarningContainer">@color/on_warning_container</item>
        <item name="colorStateHover">@color/state_hover</item>
        <item name="colorStateFocus">@color/state_focus</item>
        <item name="colorStatePressed">@color/state_pressed</item>
        <item name="colorStateDragged">@color/state_dragged</item>
        <item name="colorStateDisabledContainer">@color/state_disabled_container</item>
        <item name="colorStateDisabledContent">@color/state_disabled_content</item>
        <item name="colorChartGrid">@color/chart_grid</item>
        <item name="colorChartAxis">@color/chart_axis</item>
        <item name="colorChartLabel">@color/chart_label</item>
    <!-- 2026-11-16 语义色补全（深浅由 @color/* 的 values-night 自动切换；预设换肤可覆盖） -->
    <item name="colorSuccess">@color/success</item>
    <item name="colorOnSuccess">@color/on_success</item>
    <item name="colorSuccessContainer">@color/success_container</item>
    <item name="colorWarning">@color/warning</item>
    <item name="colorOnWarning">@color/on_warning</item>
    <item name="colorWarningContainer">@color/warning_container</item>
    <item name="colorDanger">@color/error</item>
    <item name="colorOnDanger">@color/on_error</item>
    <item name="colorErrorContainer">@color/error_container</item>
    <item name="colorOnErrorContainer">@color/on_error_container</item>
    <item name="colorInfo">@color/info_color</item>
    <!-- colorOnInfo 只在上面（@color/on_info）定义一次；此前这里又写了一条 →on_background，
         后者覆盖前者，info 的"深/浅底反色"语义被吃掉（夜间 info #60A5FA 上压浅字，对比度 2.07）。 -->
    <item name="colorBorder">@color/border</item>
    <item name="colorBorderStrong">@color/border_strong</item>
    <item name="colorScrim">@color/scrim</item>
    <!-- 2026-11-16：app 在 attrs.xml 声明了 selectableItemBorderless 但从未在任何主题定义，
         dialog_model_selector / item_code_block / item_online_model_selector 拿它当背景，inflate 会解析失败。给标准无界涟漪。 -->
    <item name="selectableItemBorderless">?android:attr/selectableItemBackgroundBorderless</item>
    <item name="colorChart1">@color/chart_1</item>
    <item name="colorChart2">@color/chart_2</item>
    <item name="colorChart3">@color/chart_3</item>
    <item name="colorChart4">@color/chart_4</item>
    <item name="colorChart5">@color/chart_5</item>
    <item name="colorChart6">@color/chart_6</item>
    <item name="colorChart7">@color/chart_7</item>
    <item name="colorChart8">@color/chart_8</item>
        <item name="colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <!-- 控件色板：控件底色 + 控件文字色（31 个主题档位自动继承此映射） -->
        <item name="colorControlBackground">?attr/colorSurfaceVariant</item>
        <item name="colorControlText">?attr/colorOnSurface</item>
        <item name="colorControlTextSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="colorControlTextTertiary">@color/text_tertiary</item>
        <item name="colorControlTextHint">@color/text_hint</item>
        <item name="colorControlTextDisabled">@color/text_disabled</item>
        <!-- 2026-11-18：SwitchMaterial/CheckBox 在 onAttachedToWindow 里强读这两个 attr，
             读不到就抛 IllegalArgumentException 把页面打崩（画布/动态 UI 的 Switch 踩过）。
             基座显式给值，任何继承 Theme.OilQuizApp 的页面/弹层都不再依赖库默认。 -->
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="colorCardBackground">?attr/colorSurface</item>
        <item name="colorOnCard">?attr/colorOnSurface</item>
        <item name="colorInputBackground">?attr/colorSurfaceVariant</item>
        <item name="colorOnInput">?attr/colorOnSurface</item>
        <item name="colorDivider">?attr/colorOutlineVariant</item>
        <item name="colorAppBarBackground">?attr/colorSurface</item>
        <item name="colorOnAppBar">?attr/colorOnSurface</item>
    <!-- 2026-11-16：首页壁纸自适应默认值（深色壁纸/关闭壁纸 = 白字 + 半透明白玻璃卡） -->
    <item name="homeTextPrimary">@color/future_text_primary</item>
    <item name="homeTextSecondary">@color/future_text_secondary</item>
    <item name="homeTextTertiary">@color/future_text_tertiary</item>
    <item name="homeCardBackground">@drawable/weather_card_glass</item>
        <!-- 弹窗/对话框统一走应用 Dialog 主题：系统栏透明跟随窗口背景，避免 e2e 下底部黑色块 -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.App.Dialog</item>
    </style>

    <style name="Theme.OilQuizApp" parent="Theme.OilQuizApp.Base"/>

