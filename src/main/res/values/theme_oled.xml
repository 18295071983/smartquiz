<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      OLED 纯黑档（2026-11-16）。

      为什么是一个 overlay 而不是 values-night 的变体：
      Android 资源限定符只有 night/no-night，没有"纯黑暗色"这一档，
      而 OLED 只改底色/卡片/边框，不动主色 —— 所以做成叠加式 ThemeOverlay，
      在预设色 overlay 之后再 applyStyle，这样"紫色 + 纯黑""蓝色 + 纯黑"都能组合。

      取值原则：
      - 背景、表面 = #000000（真纯黑，OLED 面板不发光才省电）
      - 卡片用 #070707，比背景亮一档才看得出层次（纯 #000 卡片会糊成一片）
      - 分隔线/边框 #1C1C1C，保证在纯黑上仍可见但不像描边框
      - 控件底色 #0A0A0A，输入框不闪白
    -->
    <style name="ThemeOverlay.SmartQuiz.Oled" parent="">
        <item name="colorBackground">#FF000000</item>
        <item name="colorOnBackground">#FFEDEDED</item>
        <item name="colorSurface">#FF000000</item>
        <item name="colorOnSurface">#FFEDEDED</item>
        <item name="colorSurfaceVariant">#FF0A0A0A</item>
        <item name="colorOnSurfaceVariant">#FF9E9E9E</item>
        <item name="colorCardBackground">#FF070707</item>
        <item name="colorOnCard">#FFEDEDED</item>
        <item name="colorControlBackground">#FF0A0A0A</item>
        <item name="colorControlText">#FFEDEDED</item>
        <item name="colorControlTextSecondary">#FFA0A0A0</item>
        <item name="colorControlTextHint">#FF6E6E6E</item>
        <item name="colorControlTextDisabled">#FF4A4A4A</item>
        <item name="colorInputBackground">#FF0A0A0A</item>
        <item name="colorOnInput">#FFEDEDED</item>
        <item name="colorDivider">#FF1C1C1C</item>
        <item name="colorBorder">#FF1C1C1C</item>
        <item name="colorBorderStrong">#FF2A2A2A</item>
        <item name="colorOutline">#FF232323</item>
        <item name="colorAppBarBackground">#FF000000</item>
        <item name="colorOnAppBar">#FFEDEDED</item>
        <item name="android:colorBackground">#FF000000</item>
        <item name="android:windowBackground">#FF000000</item>
    </style>
</resources>
