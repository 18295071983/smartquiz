<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        系统动态色 overlay ——**深色档**（2026-11-16 新增 values-night）。

        与 values/theme_overlay_dynamic.xml 同一套 attr，值换成深色档系统色：
        surface = neutral1_10（近黑），onSurface = neutral1_900（近白），
        error 用 system_error_dark / on_error_dark，容器色同理。
        这样"系统动态色 + 深色模式"不再是浅色底，也补上了语义色（危险/边框/图表）。
    -->
    <style name="OilQuizDynamicOverlay">
        <item name="colorPrimary">@android:color/system_accent1_500</item>
        <item name="colorPrimaryVariant">@android:color/system_accent1_300</item>
        <item name="colorOnPrimary">@android:color/system_neutral1_900</item>
        <item name="colorPrimaryContainer">@android:color/system_accent1_700</item>
        <item name="colorOnPrimaryContainer">@android:color/system_accent1_100</item>
        <item name="colorSecondary">@android:color/system_accent2_500</item>
        <item name="colorSecondaryVariant">@android:color/system_accent2_300</item>
        <item name="colorOnSecondary">@android:color/system_neutral1_900</item>
        <item name="colorSecondaryContainer">@android:color/system_accent2_700</item>
        <item name="colorOnSecondaryContainer">@android:color/system_accent2_100</item>
        <item name="colorTertiary">@android:color/system_accent3_500</item>
        <item name="colorTertiaryContainer">@android:color/system_accent3_700</item>
        <item name="colorOnTertiaryContainer">@android:color/system_accent3_100</item>

        <item name="colorSurface">@android:color/system_neutral1_10</item>
        <item name="colorOnSurface">@android:color/system_neutral1_900</item>
        <item name="colorSurfaceVariant">@android:color/system_neutral2_800</item>
        <item name="colorOnSurfaceVariant">@android:color/system_neutral2_200</item>
        <item name="colorOutline">@android:color/system_neutral2_500</item>
        <item name="colorBackground">@android:color/system_neutral1_10</item>
        <item name="colorOnBackground">@android:color/system_neutral1_900</item>
        <item name="android:windowBackground">@android:color/system_neutral1_10</item>

        <item name="colorControlBackground">@android:color/system_neutral2_800</item>
        <item name="colorControlText">@android:color/system_neutral1_900</item>
        <item name="colorControlTextSecondary">@android:color/system_neutral2_200</item>
        <item name="colorControlTextHint">@android:color/system_neutral2_200</item>
        <item name="colorControlTextDisabled">@android:color/system_neutral2_500</item>
        <item name="colorCardBackground">@android:color/system_neutral1_10</item>
        <item name="colorOnCard">@android:color/system_neutral1_900</item>
        <item name="colorInputBackground">@android:color/system_neutral2_800</item>
        <item name="colorOnInput">@android:color/system_neutral1_900</item>
        <item name="colorDivider">@android:color/system_neutral2_500</item>
        <item name="colorAppBarBackground">@android:color/system_neutral1_10</item>
        <item name="colorOnAppBar">@android:color/system_neutral1_900</item>

        <item name="colorError">@android:color/system_error_dark</item>
        <item name="colorOnError">@android:color/system_on_error_dark</item>

        <item name="colorDanger">@android:color/system_error_dark</item>
        <item name="colorOnDanger">@android:color/system_on_error_dark</item>
        <item name="colorErrorContainer">@android:color/system_error_container_dark</item>
        <item name="colorOnErrorContainer">@android:color/system_on_error_container_dark</item>
        <item name="colorBorder">@android:color/system_neutral2_500</item>
        <item name="colorBorderStrong">@android:color/system_neutral2_200</item>
        <item name="colorScrim">#99000000</item>
        <item name="colorChart1">@android:color/system_accent1_300</item>
        <item name="colorChart2">@android:color/system_accent2_300</item>
        <item name="colorChart3">@android:color/system_accent3_300</item>
        <item name="colorChart4">@android:color/system_accent1_500</item>
        <item name="colorChart5">@android:color/system_accent2_500</item>
        <item name="colorChart6">@android:color/system_accent1_100</item>
        <item name="colorChart7">@android:color/system_accent2_100</item>
        <item name="colorChart8">@android:color/system_accent3_100</item>
    </style>
</resources>
