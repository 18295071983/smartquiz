<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 基础网络安全配置：允许明文 HTTP（Agent 动态传入的媒体/网页链接多为 http，禁明文会导致
         video/audio/html 播放与加载失败；https 仍走系统 CA 校验，安全性不受影响） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- 信任系统CA -->
            <certificates src="system" />
            <!-- 可选：信任用户添加的CA，用于开发环境 -->
            <!-- <certificates src="user" /> -->
        </trust-anchors>
    </base-config>
    
    <!-- 允许localhost明文HTTP流量（本地调试/内网服务） -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
    
    <!-- 允许百炼音频下载明文HTTP流量 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">dashscope-result-bj.oss-cn-beijing.aliyuncs.com</domain>
        <domain includeSubdomains="true">dashscope-result-hz.oss-cn-hangzhou.aliyuncs.com</domain>
        <domain includeSubdomains="true">dashscope-result-sh.oss-cn-shanghai.aliyuncs.com</domain>
    </domain-config>
    
    <!-- 开发环境配置（可选） -->
    <!-- <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides> -->
</network-security-config>