<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".ui.activity.AICenterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <!-- 在线服务状态卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_service_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:rippleColor="@color/primary_alpha_20">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/space_16"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="@dimen/size_32"
                    android:layout_height="@dimen/size_32"
                    android:text="☁️"
                    android:textSize="@dimen/text_24"
                    android:gravity="center"/>
                <LinearLayout
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_12"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="在线服务状态"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <TextView
                        android:id="@+id/tv_service_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="点击配置API服务"
                        android:textSize="@dimen/text_12"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="@dimen/space_2"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="@dimen/size_24"
                    android:layout_height="@dimen/size_24"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_tertiary"
                    android:contentDescription="箭头"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 在线模型卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_online_models"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <!-- 头部：图标+标题+开关 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="@dimen/size_32"
                        android:layout_height="@dimen/size_32"
                        android:text="🌐"
                        android:textSize="@dimen/text_24"
                        android:gravity="center"/>
                    <TextView
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_12"
                        android:text="在线模型"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_online_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"/>
                </LinearLayout>

                <!-- 当前模型详情块 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    app:cardBackgroundColor="@color/surface_variant"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_12">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="当前模型"
                            android:textSize="@dimen/text_12"
                            android:textColor="@color/text_secondary"/>
                        <TextView
                            android:id="@+id/tv_current_online_model"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="GPT-4o"
                            android:textSize="@dimen/text_16"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:layout_marginTop="@dimen/space_2"/>
                        <TextView
                            android:id="@+id/tv_current_online_provider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="OpenAI"
                            android:textSize="@dimen/text_12"
                            android:textColor="@color/text_tertiary"
                            android:layout_marginTop="@dimen/space_2"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 配置列表 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/space_12">
                    <TextView
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="API配置列表"
                        android:textSize="@dimen/text_12"
                        android:textColor="@color/text_secondary"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_refresh_models"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/size_32"
                        android:text="🔄 刷新模型"
                        android:textSize="@dimen/text_11"
                        app:cornerRadius="@dimen/radius_8"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/online_models_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

                <TextView
                    android:id="@+id/online_models_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:padding="@dimen/space_16"
                    android:gravity="center"
                    android:text="暂无在线模型，点击下方按钮添加配置"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_tertiary"
                    android:background="@drawable/empty_bg_dashed"
                    android:visibility="gone"/>

                <!-- 添加配置按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_api_config"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="➕ 添加新配置"
                    android:textSize="@dimen/text_13"
                    app:cornerRadius="@dimen/radius_8"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 本地模型卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_local_models"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <!-- 头部：图标+标题+开关 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="@dimen/size_32"
                        android:layout_height="@dimen/size_32"
                        android:text="💾"
                        android:textSize="@dimen/text_24"
                        android:gravity="center"/>
                    <TextView
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_12"
                        android:text="导入模型"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_local_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- 当前模型详情块 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    app:cardBackgroundColor="@color/surface_variant"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_12">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="当前模型"
                            android:textSize="@dimen/text_12"
                            android:textColor="@color/text_secondary"/>
                        <TextView
                            android:id="@+id/tv_current_local_model"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="未加载模型"
                            android:textSize="@dimen/text_16"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:layout_marginTop="@dimen/space_2"/>
                        <TextView
                            android:id="@+id/tv_local_model_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="点击加载模型"
                            android:textSize="@dimen/text_12"
                            android:textColor="@color/text_tertiary"
                            android:layout_marginTop="@dimen/space_2"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 模型选择列表 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/space_12">
                    <TextView
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="本地模型列表"
                        android:textSize="@dimen/text_12"
                        android:textColor="@color/text_secondary"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_refresh_local_models"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/size_32"
                        android:text="🔄 刷新"
                        android:textSize="@dimen/text_11"
                        app:cornerRadius="@dimen/radius_8"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/models_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

                <TextView
                    android:id="@+id/local_models_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:padding="@dimen/space_16"
                    android:gravity="center"
                    android:text="暂无本地模型，请先导入或下载模型"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_tertiary"
                    android:background="@drawable/empty_bg_dashed"
                    android:visibility="gone"/>

                <!-- 操作按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/space_8">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_manage_local_models"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/space_4"
                        android:text="📁 管理"
                        android:textSize="@dimen/text_12"
                        app:cornerRadius="@dimen/radius_8"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_download_local_models"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_4"
                        android:text="⬇️ 下载"
                        android:textSize="@dimen/text_12"
                        app:cornerRadius="@dimen/radius_8"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Token 统计卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_token_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📊 本次会话 Token 消耗"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <TextView
                        android:id="@+id/tv_token_cost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="约 ¥0.00"
                        android:textSize="@dimen/text_14"
                        android:textColor="@color/primary"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                        android:text="输入"
                        android:textSize="@dimen/text_11"
                        android:textColor="@color/text_secondary"/>
                        <TextView
                            android:id="@+id/tv_input_tokens"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="@dimen/text_22"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:layout_marginTop="@dimen/space_4"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="tokens"
                            android:textSize="@dimen/text_12"
                            android:textColor="@color/on_primary_container"
                            android:alpha="0.5"/>
                    </LinearLayout>

                    <View android:layout_width="@dimen/size_1"
                        android:layout_height="@dimen/size_40"
                        android:background="@color/divider"/>

                    <LinearLayout
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="输出"
                            android:textSize="@dimen/text_11"
                            android:textColor="@color/text_secondary"/>
                        <TextView
                            android:id="@+id/tv_output_tokens"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="@dimen/text_22"
                            android:textStyle="bold"
                            android:textColor="@color/secondary"
                            android:layout_marginTop="@dimen/space_4"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="tokens"
                            android:textSize="@dimen/text_12"
                            android:textColor="@color/text_tertiary"/>
                    </LinearLayout>

                    <View android:layout_width="@dimen/size_1"
                        android:layout_height="@dimen/size_40"
                        android:background="@color/on_primary_container"
                        android:alpha="0.2"/>

                    <LinearLayout
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="总计"
                            android:textSize="@dimen/text_11"
                            android:textColor="@color/text_secondary"/>
                        <TextView
                            android:id="@+id/tv_total_tokens"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="@dimen/text_22"
                            android:textStyle="bold"
                            android:textColor="@color/tertiary"
                            android:layout_marginTop="@dimen/space_4"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="tokens"
                            android:textSize="@dimen/text_12"
                            android:textColor="@color/text_tertiary"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- AI功能卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🤖 AI功能"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/space_12"/>
                
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="3">
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_question_generator"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_4"
                        android:text="📝\n题目生成"
                        android:textSize="@dimen/text_11"
                        android:minLines="2"
                        app:cornerRadius="@dimen/radius_12"/>
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_question_analyzer"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_4"
                        android:text="🔍\n题目分析"
                        android:textSize="@dimen/text_11"
                        android:minLines="2"
                        app:cornerRadius="@dimen/radius_12"/>
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_learning_assistant"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_4"
                        android:text="👤\n学习助手"
                        android:textSize="@dimen/text_11"
                        android:minLines="2"
                        app:cornerRadius="@dimen/radius_12"/>
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_translator"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_4"
                        android:text="🌐\n翻译工具"
                        android:textSize="@dimen/text_11"
                        android:minLines="2"
                        app:cornerRadius="@dimen/radius_12"/>
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ai_chat"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_4"
                        android:text="💬\nAI聊天"
                        android:textSize="@dimen/text_11"
                        android:minLines="2"
                        app:cornerRadius="@dimen/radius_12"/>
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_icon_demo"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_4"
                        android:text="🎨\n图标演示"
                        android:textSize="@dimen/text_11"
                        android:minLines="2"
                        app:cornerRadius="@dimen/radius_12"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ai_image"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_4"
                        android:text="🖼️\nAI生图"
                        android:textSize="@dimen/text_11"
                        android:minLines="2"
                        app:cornerRadius="@dimen/radius_12"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ai_video"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="@dimen/size_0"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_4"
                        android:text="🎬\nAI生视频"
                        android:textSize="@dimen/text_11"
                        android:minLines="2"
                        app:cornerRadius="@dimen/radius_12"/>
                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>