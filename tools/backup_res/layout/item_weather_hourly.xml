<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/tv_hourly_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_12"
        android:textColor="@color/future_text_tertiary" />

    <TextView
        android:id="@+id/tv_hourly_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:textSize="@dimen/text_28"
        android:textColor="@color/future_text_primary" />

    <TextView
        android:id="@+id/tv_hourly_temp_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_5"
        android:textSize="@dimen/text_11"
        android:textColor="@color/white_alpha_50"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tv_hourly_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:textSize="@dimen/text_15"
        android:textColor="@color/future_text_primary"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_hourly_pop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:textSize="@dimen/text_12"
        android:textColor="@color/weather_primary"
        android:visibility="gone" />
</LinearLayout>
