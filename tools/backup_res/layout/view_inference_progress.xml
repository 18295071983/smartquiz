<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone">

    <androidx.cardview.widget.CardView
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_8"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- 阶段标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_phase_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️"
                    android:textSize="@dimen/text_24"
                    android:layout_marginEnd="@dimen/space_8" />

                <TextView
                    android:id="@+id/tv_phase"
                    android:layout_width="@dimen/size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="正在初始化..."
                    android:textSize="@dimen/text_16"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 步骤指示器 -->
            <LinearLayout
                android:id="@+id/steps_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginBottom="@dimen/space_8">
                <!-- 动态添加步骤指示器 -->
            </LinearLayout>

            <!-- 确定性进度条 -->
            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_4"
                android:layout_marginTop="@dimen/space_8"
                android:progressDrawable="@drawable/progress_inference"
                android:max="100"
                android:progress="0"
                android:visibility="gone" />

            <!-- 不确定性进度条 -->
            <ProgressBar
                android:id="@+id/indeterminate_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_4"
                android:layout_marginTop="@dimen/space_8"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/progress_inference_indeterminate"
                android:visibility="visible" />

            <!-- 统计信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_12">

                <TextView
                    android:id="@+id/tv_token_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Token: 0"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />

                <View
                    android:layout_width="@dimen/size_0"
                    android:layout_height="@dimen/size_0"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0 token/s"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 时间信息 -->
            <TextView
                android:id="@+id/tv_time_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="已用时间: 0秒"
                android:textSize="@dimen/text_11"
                android:textColor="@color/text_hint" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
