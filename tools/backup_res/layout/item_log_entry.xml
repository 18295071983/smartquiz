<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_12"
    android:background="@color/surface"
    android:layout_marginBottom="@dimen/space_8"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/space_8"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tv_log_timestamp"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2024-01-01 12:00:00"
            android:textSize="@dimen/text_12"
            android:textColor="@color/text_secondary"/>
        <TextView
            android:id="@+id/tv_log_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="应用"
            android:textSize="@dimen/text_12"
            android:textColor="@color/on_surface_variant"
            android:background="@drawable/rounded_tag"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:layout_marginEnd="@dimen/space_6"/>
        <TextView
            android:id="@+id/tv_log_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INFO"
            android:textSize="@dimen/text_12"
            android:textColor="@android:color/white"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_log_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="操作"
        android:textSize="@dimen/text_14"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="@dimen/space_4"/>

    <TextView
        android:id="@+id/tv_log_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="详细信息"
        android:textSize="@dimen/text_14"
        android:textColor="@color/text_secondary"
        android:maxLines="5"
        android:ellipsize="end"/>

</LinearLayout>
