<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".ui.activity.QuizActivity">

    <!-- 顶部工具栏 -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/elev_0">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:title="答题"
            app:titleTextColor="?attr/colorOnSurface">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/space_16">
                <!-- 计时器（考试/挑战模式可见） -->
                <TextView
                    android:id="@+id/textViewTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="@dimen/text_15"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 进度信息栏（得分 + 进度条 + 题号） -->
    <LinearLayout
        android:id="@+id/progressInfoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="@dimen/space_10"
        android:paddingBottom="@dimen/space_10"
        android:background="?attr/colorSurface">

        <TextView
            android:id="@+id/textViewScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="得分: 0"
            android:textSize="@dimen/text_14"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginEnd="@dimen/space_12"
            android:visibility="gone"/>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_4"
            android:layout_weight="1"
            android:max="10"
            android:progress="1"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="@color/primary_container"/>

        <TextView
            android:id="@+id/textViewProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/10"
            android:textSize="@dimen/text_14"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginStart="@dimen/space_12"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_1"
        android:background="@color/border_light"/>

    <!-- 主内容滚动区 -->
    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="@dimen/space_16"
            android:paddingBottom="@dimen/space_8">

            <!-- 题目区域 -->
            <LinearLayout
                android:id="@+id/card_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="@dimen/space_20"
                android:layout_marginBottom="@dimen/space_12">

                <!-- 题目头部：题号 + 题型标签 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_16">

                    <!-- 题号标记 -->
                    <TextView
                        android:id="@+id/textViewQuestionNumber"
                        android:layout_width="@dimen/size_40"
                        android:layout_height="@dimen/size_40"
                        android:text="1"
                        android:textSize="@dimen/text_17"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:background="@drawable/question_number_bg"
                        android:gravity="center"
                        android:layout_marginEnd="@dimen/space_12"/>

                    <!-- 题型标签 -->
                    <TextView
                        android:id="@+id/textViewQuestionType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="单选题"
                        android:textSize="@dimen/text_13"
                        android:textColor="@color/primary"
                        android:background="@drawable/question_type_tag_bg"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"/>
                </LinearLayout>

                <!-- 题目文本 -->
                <TextView
                    android:id="@+id/textViewQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="这是一道测试题目，请问以下哪个选项是正确的？"
                    android:textSize="@dimen/text_18"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="6dp"
                    android:layout_marginBottom="@dimen/space_20"/>

                <!-- 选项动态容器（由Java代码根据题型动态填充） -->
                <LinearLayout
                    android:id="@+id/optionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/space_16"/>

                <!-- 填空题输入框 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/answerInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="请输入答案"
                    android:layout_marginBottom="@dimen/space_16"
                    android:visibility="gone"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="@color/primary"
                    app:hintTextColor="@color/primary">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextUserAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 提交答案按钮（填空题用） -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_48"
                    android:text="提交答案"
                    app:backgroundTint="@color/primary"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="@dimen/space_16"
                    app:cornerRadius="@dimen/radius_12"
                    android:textAllCaps="false"
                    android:visibility="gone"/>

                <!-- 解析区域 -->
                <LinearLayout
                    android:id="@+id/linearLayoutExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/explanation_bg"
                    android:padding="@dimen/space_16"
                    android:layout_marginBottom="@dimen/space_16"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/space_8">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💡"
                            android:textSize="@dimen/text_16"
                            android:layout_marginEnd="@dimen/space_6"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="解析"
                            android:textSize="@dimen/text_15"
                            android:textStyle="bold"
                            android:textColor="@color/primary"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/textViewExplanation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="这是题目的解析内容，帮助你理解知识点。"
                        android:textSize="@dimen/text_15"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <!-- 查看答案按钮（练习模式可见） -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonShowAnswer"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_48"
                    android:text="查看答案"
                    android:textSize="@dimen/text_15"
                    android:textColor="@color/primary"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="@dimen/stroke_1_5"
                    android:layout_marginBottom="@dimen/space_8"
                    app:cornerRadius="@dimen/radius_12"
                    android:textAllCaps="false"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- 答案卡片（独立区域，背诵/复习模式可见） -->
            <LinearLayout
                android:id="@+id/answerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/answer_card_bg"
                android:padding="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_12"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_8">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="@dimen/text_14"
                        android:textStyle="bold"
                        android:textColor="@color/success"
                        android:background="@drawable/answer_check_bg"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginEnd="@dimen/space_8"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="正确答案"
                        android:textSize="@dimen/text_14"
                        android:textStyle="bold"
                        android:textColor="@color/success"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/textViewAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A"
                    android:textSize="@dimen/text_20"
                    android:textStyle="bold"
                    android:textColor="@color/on_success"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 底部固定导航栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:elevation="@dimen/elev_8">

        <!-- 题目导航 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="题目导航"
            android:textSize="@dimen/text_11"
            android:textColor="@color/text_tertiary"
            android:paddingHorizontal="20dp"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_0"/>

        <!-- 题目导航滚动条 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:paddingTop="@dimen/space_6"
            android:paddingBottom="@dimen/space_6">
            <LinearLayout
                android:id="@+id/navigationLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
            </LinearLayout>
        </HorizontalScrollView>
        <!-- 导航按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="@dimen/space_14"
            android:paddingTop="@dimen/space_4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPrevious"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="@dimen/size_0"
                android:layout_height="@dimen/size_48"
                android:layout_weight="1"
                android:text="← 上一题"
                android:textSize="@dimen/text_15"
                android:textColor="@color/text_secondary"
                app:strokeColor="@color/border"
                app:cornerRadius="@dimen/radius_12"
                android:layout_marginEnd="@dimen/space_8"
                android:textAllCaps="false"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMark"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="@dimen/size_0"
                android:layout_height="@dimen/size_48"
                android:layout_weight="1"
                android:text="☆ 标记"
                android:textSize="@dimen/text_15"
                android:textColor="@color/tertiary"
                app:strokeColor="@color/tertiary"
                app:cornerRadius="@dimen/radius_12"
                android:layout_marginEnd="@dimen/space_8"
                android:textAllCaps="false"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonNext"
                android:layout_width="@dimen/size_0"
                android:layout_height="@dimen/size_48"
                android:layout_weight="1"
                android:text="下一题 →"
                android:textSize="@dimen/text_15"
                app:backgroundTint="@color/primary"
                android:textColor="@android:color/white"
                app:cornerRadius="@dimen/radius_12"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
