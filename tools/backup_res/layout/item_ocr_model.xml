<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_model"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_8"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:strokeWidth="@dimen/stroke_2"
    app:strokeColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_14"
        android:background="?attr/selectableItemBackground">

        <!-- 选中指示器 -->
        <RadioButton
            android:id="@+id/rb_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false" />

        <!-- 模型信息 -->
        <LinearLayout
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_10"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_model_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_15"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_model_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:textSize="@dimen/text_12"
                android:textColor="@color/on_surface_variant"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- 视觉能力标签 -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_vision"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_32"
            android:text="Vision"
            android:textSize="@dimen/text_11"
            app:chipMinHeight="28dp"
            app:chipCornerRadius="14dp"
            app:chipBackgroundColor="@color/primary_container"
            android:textColor="@color/on_primary_container"
            android:visibility="gone"
            android:layout_marginStart="@dimen/space_6" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
