<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_12"
    android:background="@drawable/message_card_background"
    android:layout_marginTop="@dimen/space_8"
    android:layout_marginBottom="@dimen/space_8">

    <!-- 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_8">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖"
            android:textSize="@dimen/text_18"
            android:layout_marginEnd="@dimen/space_6" />

        <TextView
            android:id="@+id/summary_title"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Agent 执行汇总"
            android:textSize="@dimen/text_15"
            android:textColor="@color/agent_summary_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/summary_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_12"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_1"
        android:background="@color/agent_summary_divider"
        android:layout_marginBottom="@dimen/space_8" />

    <!-- 统计信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/space_4">

        <!-- 总耗时 -->
        <LinearLayout
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_4">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱"
                android:textSize="@dimen/text_16"
                android:layout_marginBottom="@dimen/space_2" />

            <TextView
                android:id="@+id/summary_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_13"
                android:textColor="@color/agent_summary_value"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="耗时"
                android:textSize="@dimen/text_12"
                android:textColor="@color/agent_summary_label" />
        </LinearLayout>

        <!-- 总步骤 -->
        <LinearLayout
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_4">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊"
                android:textSize="@dimen/text_16"
                android:layout_marginBottom="@dimen/space_2" />

            <TextView
                android:id="@+id/summary_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_13"
                android:textColor="@color/agent_summary_value"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="思考轮"
                android:textSize="@dimen/text_12"
                android:textColor="@color/agent_summary_label" />
        </LinearLayout>

        <!-- 工具调用 -->
        <LinearLayout
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_4">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔧"
                android:textSize="@dimen/text_16"
                android:layout_marginBottom="@dimen/space_2" />

            <TextView
                android:id="@+id/summary_tools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_13"
                android:textColor="@color/agent_summary_value"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="工具"
                android:textSize="@dimen/text_12"
                android:textColor="@color/agent_summary_label" />
        </LinearLayout>

        <!-- Token 使用 -->
        <LinearLayout
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_4">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝"
                android:textSize="@dimen/text_16"
                android:layout_marginBottom="@dimen/space_2" />

            <TextView
                android:id="@+id/summary_tokens"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_13"
                android:textColor="@color/agent_summary_value"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Token"
                android:textSize="@dimen/text_12"
                android:textColor="@color/agent_summary_label" />
        </LinearLayout>
    </LinearLayout>

    <!-- 详细汇总文本（工具名/思考轮次/缓存命中等） -->
    <TextView
        android:id="@+id/summary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:textSize="@dimen/text_11"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="2dp"
        android:visibility="gone"/>

</LinearLayout>
