<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_city_search"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_48"
            android:layout_weight="1"
            android:background="@drawable/bg_search_input"
            android:hint="搜索城市名称..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="@color/weather_dark_text"
            android:textColorHint="@color/weather_dark_text_tertiary"
            android:textSize="@dimen/text_15" />

        <ImageView
            android:id="@+id/btn_search_clear"
            android:layout_width="@dimen/size_48"
            android:layout_height="@dimen/size_48"
            android:layout_marginStart="@dimen/space_8"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_clear"
            android:tint="@color/weather_dark_text_tertiary"
            android:contentDescription="清除" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_hot_cities_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="历史查询"
        android:textColor="@color/weather_dark_text"
        android:textSize="@dimen/text_14"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_no_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:gravity="center"
        android:text="暂无历史记录"
        android:textColor="@color/weather_dark_text_tertiary"
        android:textSize="@dimen/text_14"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/sv_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:maxHeight="@dimen/max_120"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_history_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4" />
    </ScrollView>

    <TextView
        android:id="@+id/tv_search_results_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:visibility="gone"
        android:text="搜索结果"
        android:textColor="@color/weather_dark_text"
        android:textSize="@dimen/text_14"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_results"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/space_8"
        android:maxHeight="@dimen/max_300"
        android:nestedScrollingEnabled="false" />

    <TextView
        android:id="@+id/tv_no_results"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/space_16"
        android:text="未找到相关城市"
        android:textColor="@color/weather_dark_text_tertiary"
        android:textSize="@dimen/text_14"
        android:visibility="gone" />

</LinearLayout>