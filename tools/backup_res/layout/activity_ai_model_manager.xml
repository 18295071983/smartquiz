<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    >

    <!-- 页面标题 -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/purple_700"
        app:title="AI模型管理"
        app:titleTextColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.Toolbar.LayoutParams
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center" />

    </androidx.appcompat.widget.Toolbar>

    <!-- 模型列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewModels"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_16"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/buttonAddModel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 操作按钮容器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/buttonAddModel"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="添加新模型"
            android:textSize="@dimen/text_16"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@color/purple_600"
            app:cornerRadius="@dimen/radius_12"
            android:layout_marginRight="@dimen/space_8" />

        <Button
            android:id="@+id/buttonTestModel"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="测试模型性能"
            android:textSize="@dimen/text_16"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@color/teal_600"
            app:cornerRadius="@dimen/radius_12"
            android:layout_marginLeft="@dimen/space_8" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
