<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="语音功能配置指南"
        android:textSize="@dimen/text_18"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:paddingBottom="@dimen/space_16"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        android:layout_weight="1"
        android:paddingHorizontal="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========== 语音识别（ASR）========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎙️ 语音识别（ASR）"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:paddingBottom="@dimen/space_10"/>

                <!-- 功能介绍 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="功能介绍"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:paddingBottom="@dimen/space_4"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="将语音实时转换为文字，支持多种服务商的语音识别模型。在 AI 对话界面中，点击麦克风按钮即可使用语音输入功能，系统会自动将您说的话转换为文字发送。"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"/>

                <!-- 支持的模型 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="支持的模型"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="@dimen/space_12"
                    android:paddingBottom="@dimen/space_4"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▸ qwen3-asr-flash（百炼，推荐，实时识别）"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▸ paraformer-v2（百炼，非实时高精度）"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▸ fun-asr-flash（百炼，非实时，多语种）"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▸ gummy-realtime-v1（百炼，实时双工）"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▸ whisper-1（OpenAI 兼容）"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▸ 16k_zh（讯飞，中文专用）"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <!-- 配置方法 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="配置方法"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="@dimen/space_12"
                    android:paddingBottom="@dimen/space_4"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. 在「模型管理」页面，点击「功能专用模型」标题行，查看本指南"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. 点击「🎙️ 语音识别模型」这一行"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. 从列表中选择对应的 ASR 模型（如 qwen3-asr-flash）"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. 如果未选择专用模型，系统会自动使用可用的语音服务商端点"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

            </LinearLayout>

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_1"
                android:background="@color/divider"
                android:layout_marginVertical="@dimen/space_16"/>

            <!-- ========== 语音合成（TTS）========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔊 语音合成（TTS）"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:paddingBottom="@dimen/space_10"/>

                <!-- 功能介绍 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="功能介绍"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:paddingBottom="@dimen/space_4"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="将文字转换为自然语音，支持多种音色选择。可用于朗读回复、语音播报、辅助学习等场景。在「语音配置」界面可以选择音色并试听效果。"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"/>

                <!-- 支持的模型 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="支持的模型"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="@dimen/space_12"
                    android:paddingBottom="@dimen/space_4"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▸ qwen3-tts-flash（百炼，推荐，实时合成）"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▸ qwen-tts / qwen3-tts（百炼，Qwen-TTS 系列）"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▸ cosyvoice-v3（百炼，75 个音色，支持方言）"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▸ cosyvoice-v2 / cosyvoice-v1（百炼，经典版本）"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▸ tts-1 / tts-1-hd（OpenAI 兼容）"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▸ xfyun-tts（讯飞，专业语音合成）"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <!-- 推荐音色 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="推荐音色（qwen3-tts-flash）"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="@dimen/space_12"
                    android:paddingBottom="@dimen/space_4"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="★ Cherry（女声·阳光积极）— 推荐首选"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/primary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="☆ Serena（女声·温柔）"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="☆ Ethan（男声·标准普通话）"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="☆ Chelsie（女声·二次元虚拟女友）"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="☆ Momo（女声·撒娇搞怪）"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="... 共 48 个音色可选，支持方言和多语种"
                    android:textSize="@dimen/text_11"
                    android:textColor="@color/text_tertiary"
                    android:lineSpacingExtra="3dp"/>

                <!-- 配置方法 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="配置方法"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="@dimen/space_12"
                    android:paddingBottom="@dimen/space_4"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. 点击「🔊 语音合成模型」这一行，选择 TTS 模型"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. 点击「🎵 语音合成音色」这一行，选择喜欢的音色"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. 在弹出的音色列表中，点击「试听」按钮预览效果"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. 确认音色后点击「确定」保存"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"/>

            </LinearLayout>

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_1"
                android:background="@color/divider"
                android:layout_marginVertical="@dimen/space_16"/>

            <!-- ========== 使用提示 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 使用提示"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:paddingBottom="@dimen/space_10"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. API Key 共用"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:paddingBottom="@dimen/space_2"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="语音识别和语音合成使用与聊天模型相同的 API Key。在「API 配置」页面设置一次即可。"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. 自动选择"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="@dimen/space_8"
                    android:paddingBottom="@dimen/space_2"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="如果不配置专用语音模型，系统会自动检测可用的语音服务商端点（百炼/讯飞/火山/百度/OpenAI）。"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. 离线兜底"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="@dimen/space_8"
                    android:paddingBottom="@dimen/space_2"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="当在线语音服务不可用时，语音识别功能会自动回退到 Android 系统自带的语音识别（需要设备支持语音识别服务）。"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. 多服务商支持"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="@dimen/space_8"
                    android:paddingBottom="@dimen/space_2"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="系统支持百炼、讯飞、火山引擎、百度、OpenAI 等 5 大服务商，可根据需求和价格自由切换。"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5. 配置独立"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="@dimen/space_8"
                    android:paddingBottom="@dimen/space_2"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="语音识别（ASR）和语音合成（TTS）完全独立配置，互不影响。聊天模型的切换不会影响语音功能。"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"/>

            </LinearLayout>

            <!-- 底部间距 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_12"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bt_close"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_48"
        android:text="我知道了"
        app:cornerRadius="@dimen/radius_10"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_16"
        app:backgroundTint="@color/primary"
        android:textColor="@color/on_primary"/>

</LinearLayout>
