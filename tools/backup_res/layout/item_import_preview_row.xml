<?xml version="1.0" encoding="utf-8"?>
<!-- 导入预览数据行：序号 + 题干 + 选项 + 答案 + 缺失标注 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_6"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_row_index"
                android:layout_width="@dimen/size_30"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="@dimen/text_12"
                android:textColor="@color/text_tertiary"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_row_question"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="题干"
                android:textSize="@dimen/text_13"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_row_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginStart="@dimen/space_30"
            android:text=""
            android:textSize="@dimen/text_12"
            android:textColor="@color/text_secondary"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_row_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginStart="@dimen/space_30"
            android:text="答案"
            android:textSize="@dimen/text_12"
            android:textColor="@color/text_secondary"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tv_row_missing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginStart="@dimen/space_30"
            android:text="缺字段"
            android:textSize="@dimen/text_11"
            android:textColor="@color/on_error_container"
            android:textStyle="bold"
            android:visibility="gone"/>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
